{
  "system": {
    "language": "en",
    "timezone": "Europe/Chisinau",
    "kb_layout": "us,ru",
    "kb_toggle": "grp:alt_shift_toggle",
    "power_profile": "balanced"
  },
  "interface": {
    "philosophy": "cyberdeck",
    "dock_enabled": true,
    "gestures": true,
    "ui_sounds": true
  },
  "theme": {
    "name": "cyan",
    "palette": {
      "base_bg": "#0a0c10",
      "surface_bg": "#12161f",
      "primary_accent": "#00f0ff",
      "secondary_accent": "#0088cc",
      "border_active": "#00f0ff",
      "border_inactive": "#1b2430",
      "alert_critical": "#ff003c"
    },
    "borders": {
      "size": 2,
      "rounding": 6,
      "gaps_in": 6,
      "gaps_out": 10,
      "mode": "dual_gradient",
      "gradient_angle": 45,
      "glow_radius": 15,
      "glow_color": "#00f0ff66"
    },
    "glass": {
      "opacity_active": 0.95,
      "opacity_inactive": 0.85,
      "opacity_panels": 0.90,
      "blur_enabled": true,
      "blur_size": 8,
      "blur_passes": 3,
      "blur_vibrancy": 0.1696,
      "xray": false
    },
    "animations": {
      "mode": "smooth"
    }
  },
  "wallpaper": {
    "desktop": {
      "path": "/usr/share/kortex/wallpapers/cyber_grid.png",
      "type": "preset"
    },
    "terminal": {
      "image_enabled": false,
      "image_path": "",
      "dimming": 0.35
    }
  },
  "grid_widgets": {
    "sys_panel": true,
    "terminal": true,
    "globe_net": true,
    "file_grid": true,
    "virtual_keyboard": true
  },
  "hotkeys": {
    "close": "SUPER, Q",
    "close_alt": "ALT, F4",
    "spotlight": "SUPER, SPACE",
    "menu": "SUPER, D",
    "terminal": "SUPER, RETURN",
    "browser": "SUPER, B",
    "file_manager": "SUPER, E",
    "screenshot": "SUPER SHIFT, S",
    "lock": "SUPER, L",
    "layout": "SUPER, TAB",
    "help_hud": "SUPER, F1"
  }
}
