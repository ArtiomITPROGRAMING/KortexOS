/**
 * KortexOS Hybrid Windows 11 + MacBook Glass Start Menu Theme
 * Dynamically imports ~/.config/rofi/theme.rasi generated by kortex-theme-apply
 */

@import "theme.rasi"

* {
    background-color:   transparent;
    text-color:         @text-main;
    font:               "JetBrainsMono Nerd Font 11";
    spacing:            4px;
    padding:            0px;
    margin:             0px;
}

window {
    anchor:             north west;
    location:           north west;
    x-offset:           12px;
    y-offset:           36px;
    width:              520px;
    height:             640px;
    border:             2px solid;
    border-color:       @border-col;
    border-radius:      @rounding;
    padding:            14px;
    background-color:   @bg-base;
    children:           [ inputbar, listview ];
}

inputbar {
    border:             1px solid;
    border-color:       @accent-sec;
    border-radius:      @rounding;
    padding:            10px 14px;
    margin:             0px 0px 10px 0px;
    children:           [ prompt, entry ];
    background-color:   @bg-surface;
}

prompt {
    text-color:         @accent-pri;
    font:               "JetBrainsMono Nerd Font Bold 11";
    margin:             0px 10px 0px 0px;
}

entry {
    placeholder:        "Поиск программ, настроек и команд...";
    placeholder-color:  @text-dim;
    text-color:         @text-main;
    cursor:             pointer;
}

listview {
    border:             0px;
    padding:            4px 0px;
    lines:              15;
    columns:            1;
    scrollbar:          false;
    spacing:            3px;
}

element {
    padding:            8px 12px;
    border-radius:      @rounding;
    border:             0px;
    background-color:   transparent;
    text-color:         @text-main;
}

element selected, element selected.normal {
    background-color:   @bg-surface;
    text-color:         @accent-pri;
    border:             1px solid;
    border-color:       @border-col;
}

element-text {
    vertical-align:     0.5;
    text-color:         inherit;
}
