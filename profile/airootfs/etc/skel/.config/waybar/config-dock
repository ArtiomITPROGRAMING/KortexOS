{
    "layer": "top",
    "position": "bottom",
    "height": 42,
    "margin-bottom": 8,
    "modules-center": [
        "custom/dock-browser",
        "custom/dock-files",
        "custom/dock-term",
        "custom/dock-store",
        "custom/dock-settings",
        "custom/dock-install"
    ],
    "custom/dock-browser": {
        "format": "🌐 Браузер",
        "on-click": "/usr/local/bin/kortex-launch firefox",
        "tooltip": "Браузер (Интернет)"
    },
    "custom/dock-files": {
        "format": "📁 Файлы",
        "on-click": "kitty --class kortex-files -e yazi",
        "tooltip": "Файлы (Проводник)"
    },
    "custom/dock-term": {
        "format": "🐚 Терминал",
        "on-click": "/usr/local/bin/kortex-launch kitty",
        "tooltip": "Терминал"
    },
    "custom/dock-store": {
        "format": "🏪 Программы",
        "on-click": "/usr/local/bin/kortex-open store",
        "tooltip": "Магазин программ"
    },
    "custom/dock-settings": {
        "format": "⚙️ Настройки",
        "on-click": "/usr/local/bin/kortex-open settings",
        "tooltip": "Настройки системы"
    },
    "custom/dock-install": {
        "format": "💿 Установка ОС",
        "on-click": "/usr/local/bin/kortex-open install",
        "tooltip": "Установить KortexOS на диск"
    }
}
