        ("discord", "Discord", "Voice, video and text chat platform", "flatpak", "com.discordapp.Discord", "flatpak install -y flathub com.discordapp.Discord")
    ]),
    ("Media & Graphics", [
        ("obs-studio", "OBS Studio", "Free and open source software for video recording", "native", "obs-studio", "sudo pacman -S --noconfirm obs-studio"),
        ("gimp", "GIMP", "GNU Image Manipulation Program (Photoshop alternative)", "native", "gimp", "sudo pacman -S --noconfirm gimp"),
        ("blender", "Blender 3D", "Professional 3D graphics, modeling & rendering", "native", "blender", "sudo pacman -S --noconfirm blender")
    ]),
    ("Gaming & Emulation", [
        ("steam", "Steam Gaming", "The ultimate destination for playing games", "flatpak", "com.valvesoftware.Steam", "flatpak install -y flathub com.valvesoftware.Steam"),
        ("lutris", "Lutris", "Open gaming platform for managing games", "native", "lutris", "sudo pacman -S --noconfirm lutris")
    ]),
    ("Cybersecurity & Net", [
        ("nmap", "Nmap Security Scanner", "Network exploration tool and port scanner", "native", "nmap", "sudo pacman -S --noconfirm nmap"),
        ("wireshark-qt", "Wireshark", "World's foremost network protocol analyzer", "native", "wireshark-qt", "sudo pacman -S --noconfirm wireshark-qt")
    ]),
    ("System Utilities", [
        ("fastfetch", "Fastfetch", "Fast system information display", "native", "fastfetch", "sudo pacman -S --noconfirm fastfetch")
    ])
]

def load_apps_catalog():
    os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
    # 1. Try remote GitHub fetch with short timeout
    try:
        req = urllib.request.Request(REMOTE_CATALOG_URL, headers={"User-Agent": "KortexOS-Store/1.0"})
        with urllib.request.urlopen(req, timeout=2.0) as resp:
            data = resp.read().decode("utf-8")
            with open(CACHE_PATH, "w", encoding="utf-8") as f:
                f.write(data)
            catalog = json.loads(data)
            return parse_catalog(catalog)
    except Exception:
        pass

    # 2. Try cached copy
    if os.path.exists(CACHE_PATH):
        try:
            with open(CACHE_PATH, "r", encoding="utf-8") as f:
                return parse_catalog(json.load(f))
        except Exception:
            pass

    # 3. Try bundled local fallback
    if os.path.exists(LOCAL_FALLBACK):
        try:
            with open(LOCAL_FALLBACK, "r", encoding="utf-8") as f:
                return parse_catalog(json.load(f))
        except Exception:
            pass

    return DEFAULT_CATEGORIES

def parse_catalog(cat_json):
    if not cat_json or "apps" not in cat_json:
        return DEFAULT_CATEGORIES
    cats = {}
    for app in cat_json["apps"]:
        c = app.get("category", "General")
        cats.setdefault(c, []).append((
            app.get("id"),
            app.get("name", app.get("id")),
            app.get("description", ""),
            app.get("type", "native"),
            app.get("package", app.get("id")),
            app.get("install_cmd", f"sudo pacman -S --noconfirm {app.get('id')}")
        ))
    return list(cats.items())

def is_pkg_installed(pkg_id, pkg_type="native", pkg_name=None):
    if not pkg_name:
        pkg_name = pkg_id
    if pkg_type == "flatpak":
        try:
            res = subprocess.run(["flatpak", "info", pkg_name], capture_output=True, text=True, timeout=2)
            if res.returncode == 0:
                return True
        except Exception:
            pass
    else:
        # Check pacman
        res = subprocess.run(["pacman", "-Qq", pkg_name], capture_output=True, text=True)
        if res.returncode == 0:
            return True
        # Check binary in path
        if shutil.which(pkg_id):
            return True
    return False

def install_app(item):
    pkg_id, name, desc, p_type, package, inst_cmd = item
    if inst_cmd:
        cmd = ["bash", "-c", inst_cmd]
    elif p_type == "flatpak":
        cmd = ["flatpak", "install", "-y", "flathub", package]
    else:
        cmd = ["sudo", "pacman", "-S", "--noconfirm", "--needed", package]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

def remove_app(item):
    pkg_id, name, desc, p_type, package, _ = item
    if p_type == "flatpak":
        cmd = ["flatpak", "uninstall", "-y", package]
    else:
        cmd = ["sudo", "pacman", "-Rns", "--noconfirm", package]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

def update_all_system():
    cmd = ["bash", "-c", "sudo pacman -Syu --noconfirm && (command -v flatpak >/dev/null && flatpak update -y || true)"]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

def search_pacman(query):
    results = []
    try:
        res = subprocess.run(["pacman", "-Ss", query], capture_output=True, text=True, timeout=5)
        lines = res.stdout.splitlines()
        for i in range(0, len(lines), 2):
            if i + 1 < len(lines):
                header = lines[i]
                desc = lines[i+1].strip()
                pkg_full = header.split()[0]
                pkg_name = pkg_full.split("/")[-1]
                installed = "[installed]" in heade
                results.append((pkg_name, desc, installed))
    except Exception:
        pass
    return results[:25]

def safe_addstr(win, y, x, text, attr=0):
    max_y, max_x = win.getmaxyx()
    if 0 <= y < max_y and 0 <= x < max_x:
        try:
            win.addstr(y, x, text[:max_x - x - 1], attr)
        except curses.error:
            pass

def tui_main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(200)

    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(3, curses.COLOR_CYAN, -1)
    curses.init_pair(4, curses.COLOR_GREEN, -1)
    curses.init_pair(5, curses.COLOR_RED, -1)
    curses.init_pair(6, curses.COLOR_YELLOW, -1)

    categories = load_apps_catalog()
    cat_idx = 0
    item_idx = 0
    in_search = False
    search_query = ""
    search_results = []
    
    active_proc = None
    proc_lines = []
    status_msg = "Select application and press [ENTER] to Install or [X] to Remove"

    # Pre-check installed states
    installed_cache = {}
    for _, items in categories:
        for it in items:
            pkg_id, _, _, p_type, pkg_name, _ = it
            installed_cache[pkg_id] = is_pkg_installed(pkg_id, p_type, pkg_name)

    while True:
        h, w = stdscr.getmaxyx()
        stdscr.erase()

        # Handle active proc output
        if active_proc:
            line = active_proc.stdout.readline()
            if line:
                proc_lines.append(line.strip())
                if len(proc_lines) > 6:
                    proc_lines.pop(0)
            if active_proc.poll() is not None:
                rc = active_proc.poll()
                active_proc = None
                status_msg = f"Task completed with exit code {rc}"
                # Refresh installed cache
                for _, items in categories:
                    for it in items:
                        pkg_id, _, _, p_type, pkg_name, _ = it
                        installed_cache[pkg_id] = is_pkg_installed(pkg_id, p_type, pkg_name)

        # Outer Frame
        safe_addstr(stdscr, 0, 0, "┌" + "─" * (w - 2) + "┐", curses.color_pair(3))
        for y in range(1, h - 1):
            safe_addstr(stdscr, y, 0, "│", curses.color_pair(3))
            safe_addstr(stdscr, y, w - 1, "│", curses.color_pair(3))
        safe_addstr(stdscr, h - 1, 0, "└" + "─" * (w - 2) + "┘", curses.color_pair(3))

        # Title
        title = " [ KORTEX APP HUB // GITHUB CATALOG & SOFTWARE CENTER ] "
        safe_addstr(stdscr, 0, max(2, (w - len(title)) // 2), title, curses.color_pair(2) | curses.A_BOLD)

        # Left Column: Categories
        col1_w = 26
        safe_addstr(stdscr, 2, 3, "CATEGORIES", curses.color_pair(3) | curses.A_BOLD)
        safe_addstr(stdscr, 3, 3, "─" * (col1_w - 4), curses.color_pair(3))
        
        for i, (c_name, _) in enumerate(categories):
            attr = curses.color_pair(2) if (i == cat_idx and not in_search) else curses.color_pair(1)
            safe_addstr(stdscr, 4 + i, 3, f" {c_name:<20}", attr)

        search_tab_attr = curses.color_pair(2) if in_search else curses.color_pair(1)
        safe_addstr(stdscr, 4 + len(categories) + 1, 3, " [S] Global Search    ", search_tab_attr)
        safe_addstr(stdscr, 4 + len(categories) + 2, 3, " [R] Reload Cloud Cat ", curses.color_pair(6))
        safe_addstr(stdscr, 4 + len(categories) + 3, 3, " [U] Update All System", curses.color_pair(1))

        # Vertical Divide
        for y in range(2, h - 5):
            safe_addstr(stdscr, y, col1_w + 1, "│", curses.color_pair(3))

        # Right Column: Items List
        col2_x = col1_w + 3
        right_w = w - col2_x - 3

        if in_search:
            safe_addstr(stdscr, 2, col2_x, f"ARCH REPO & FLATPAK SEARCH: '{search_query}'", curses.color_pair(3) | curses.A_BOLD)
            safe_addstr(stdscr, 3, col2_x, "─" * right_w, curses.color_pair(3))

            if not search_results:
                safe_addstr(stdscr, 5, col2_x, "Type query and press Enter. [ESC] to return to curated catalog.", curses.A_DIM | curses.color_pair(1))
            else:
                for idx, (p_name, p_desc, p_inst) in enumerate(search_results[:h - 10]):
                    is_sel = (idx == item_idx)
                    attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                    badge = "[INSTALLED]" if p_inst else "[AVAILABLE]"
                    
                    line = f"{p_name:<22}  {badge}"
                    safe_addstr(stdscr, 5 + idx, col2_x, line, attr)
                    if right_w > 45:
                        safe_addstr(stdscr, 5 + idx, col2_x + 36, p_desc[:right_w - 38], curses.A_DIM | curses.color_pair(1))

        else:
            cur_cat_name, cur_items = categories[cat_idx]
            safe_addstr(stdscr, 2, col2_x, f"CATALOG: {cur_cat_name.upper()}", curses.color_pair(3) | curses.A_BOLD)
            safe_addstr(stdscr, 3, col2_x, "─" * right_w, curses.color_pair(3))

            for idx, it in enumerate(cur_items):
                pkg_id, name, desc, p_type, package, _ = it
                is_sel = (idx == item_idx)
                attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                inst = installed_cache.get(pkg_id, False)
                badge = "[INSTALLED]" if inst else "[AVAILABLE]"
                type_tag = f"[{p_type.upper()}]"
                
                line = f"{name:<24}  {type_tag:<9}  {badge}"
                safe_addstr(stdscr, 5 + (idx * 2), col2_x, line, attr)
                safe_addstr(stdscr, 6 + (idx * 2), col2_x + 2, desc[:right_w - 4], curses.A_DIM | curses.color_pair(1))

        # Active Terminal Log Box (Bottom)
        log_y = h - 6
        safe_addstr(stdscr, log_y, 2, "┌" + "─" * (w - 6) + "┐", curses.color_pair(3))
        safe_addstr(stdscr, log_y, 4, " [ LIVE ACTIVITY LOG ] ", curses.color_pair(2))
        
        if proc_lines:
            for l_idx, pline in enumerate(proc_lines[-3:]):
                safe_addstr(stdscr, log_y + 1 + l_idx, 4, pline[:w - 8], curses.color_pair(1))
        else:
            safe_addstr(stdscr, log_y + 1, 4, f">> {status_msg}", curses.color_pair(1))

        # Bottom Controls Ba
        safe_addstr(stdscr, h - 2, 3, " [ENTER] Install/Run   [X] Remove   [S] Search   [R] Reload Catalog   [U] Update   [Q] Exit ", curses.color_pair(2))

        stdscr.refresh()

        try:
            ch = stdscr.getch()
            if ch in (ord('q'), ord('Q'), 27):
                if in_search:
                    in_search = False
                    item_idx = 0
                else:
                    break
            elif ch in (ord('\t'), curses.KEY_BTAB):
                cat_idx = (cat_idx + 1) % len(categories)
                item_idx = 0
            elif ch in (curses.KEY_UP, ord('k')):
                if item_idx > 0:
                    item_idx -= 1
            elif ch in (curses.KEY_DOWN, ord('j')):
                max_items = len(search_results) if in_search else len(categories[cat_idx][1])
                if item_idx < max_items - 1:
                    item_idx += 1
            elif ch in (curses.KEY_LEFT, ord('h')):
                if not in_search and cat_idx > 0:
                    cat_idx -= 1
                    item_idx = 0
            elif ch in (curses.KEY_RIGHT, ord('l')):
                if not in_search and cat_idx < len(categories) - 1:
                    cat_idx += 1
                    item_idx = 0
            elif ch in (ord('r'), ord('R')):
                status_msg = "Refreshing application catalog from GitHub..."
                stdscr.refresh()
                categories = load_apps_catalog()
                cat_idx = 0
                item_idx = 0
                for _, items in categories:
                    for it in items:
                        pkg_id, _, _, p_type, pkg_name, _ = it
                        installed_cache[pkg_id] = is_pkg_installed(pkg_id, p_type, pkg_name)
                status_msg = "Catalog refreshed from GitHub: https://github.com/ArtiomITPROGRAMING/kortex-apps"
            elif ch in (ord('s'), ord('S')):
                curses.echo()
                curses.curs_set(1)
                safe_addstr(stdscr, h - 2, 3, "Search Arch Packages: " + " " * 30, curses.color_pair(3))
                stdscr.refresh()
                query = stdscr.getstr(h - 2, 25, 40).decode("utf-8").strip()
                curses.noecho()
                curses.curs_set(0)
                if query:
                    search_query = query
                    in_search = True
                    status_msg = f"Searching Arch repositories for '{query}'..."
                    stdscr.refresh()
                    search_results = search_pacman(query)
                    item_idx = 0
            elif ch in (ord('u'), ord('U')):
                if not active_proc:
                    status_msg = "Running full system update (pacman -Syu & flatpak update)..."
                    proc_lines = ["[+] Starting system update..."]
                    active_proc = update_all_system()
            elif ch in (10, 13, curses.KEY_ENTER):
                if not active_proc:
                    if in_search and search_results:
                        target_pkg = search_results[item_idx][0]
                        item_tuple = (target_pkg, target_pkg, "", "native", target_pkg, f"sudo pacman -S --noconfirm {target_pkg}")
                        status_msg = f"Installing package '{target_pkg}'..."
                        proc_lines = [f"[+] Launching installation for {target_pkg}..."]
                        active_proc = install_app(item_tuple)
                    elif not in_search:
                        item_tuple = categories[cat_idx][1][item_idx]
                        pkg_id = item_tuple[0]
                        if installed_cache.get(pkg_id, False):
                            # Already installed -> Launch it!
                            status_msg = f"Launching '{item_tuple[1]}'..."
                            subprocess.Popen(f"/usr/local/bin/kortex-open {pkg_id} || {pkg_id} &", shell=True)
                        else:
                            status_msg = f"Installing application '{item_tuple[1]}'..."
                            proc_lines = [f"[+] Installing {item_tuple[1]}..."]
                            active_proc = install_app(item_tuple)
            elif ch in (ord('x'), ord('X')):
                if not active_proc:
                    if in_search and search_results:
                        target_pkg = search_results[item_idx][0]
                        item_tuple = (target_pkg, target_pkg, "", "native", target_pkg, "")
                        status_msg = f"Removing package '{target_pkg}'..."
                        proc_lines = [f"[+] Removing {target_pkg}..."]
                        active_proc = remove_app(item_tuple)
                    elif not in_search:
                        item_tuple = categories[cat_idx][1][item_idx]
                        status_msg = f"Removing application '{item_tuple[1]}'..."
                        proc_lines = [f"[+] Removing {item_tuple[1]}..."]
                        active_proc = remove_app(item_tuple)
        except KeyboardInterrupt:
            break

def main():
    os.environ.setdefault("TERM", "xterm-256color")
    try:
        curses.wrapper(tui_main)
    except Exception as e:
        print(f"[-] Kortex App Hub error: {e}")

if __name__ == "__main__":
    main()
