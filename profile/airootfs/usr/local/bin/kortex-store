#!/usr/bin/env python3
"""
Kortex App Hub (kortex-store)
Curated Software Center, Arch Linux Package Repository & Flatpak Installe
Dynamic cloud-connected catalog powered by https://github.com/ArtiomITPROGRAMING/kortex-apps
Tron / eDEX-UI Cyber Aesthetics with 1-click install, remove, and system-wide update.
"""

import os
import sys
import time
import json
import curses
import subprocess
import shutil
import urllib.request

REMOTE_CATALOG_URL = "https://raw.githubusercontent.com/ArtiomITPROGRAMING/kortex-apps/main/apps.json"
CACHE_PATH = os.path.expanduser("~/.cache/kortex/apps.json")
LOCAL_FALLBACK = "/usr/share/kortex/apps.json"

DEFAULT_CATEGORIES = [
    ("Audio & Music", [
        ("kortex-music", "Kortex Music & Radio", "Built-in Cyberpunk & Synthwave music player", "native", "kortex-music", ""),
        ("spotify", "Spotify Music", "Millions of songs and podcasts via Flatpak", "flatpak", "com.spotify.Client", "flatpak install -y flathub com.spotify.Client"),
        ("audacity", "Audacity Audio Editor", "Multi-track audio editor and waveform recorder", "native", "audacity", "sudo pacman -S --noconfirm audacity")
    ]),
    ("Browsers & Web", [
        ("firefox", "Firefox Web Browser", "Fast, private and extensible browser", "native", "firefox", "sudo pacman -S --noconfirm firefox"),
        ("chromium", "Chromium", "Open-source browser engine behind Chrome", "native", "chromium", "sudo pacman -S --noconfirm chromium"),
        ("torbrowser-launcher", "Tor Browser", "Anonymous web surfing and onion routing", "native", "torbrowser-launcher", "sudo pacman -S --noconfirm torbrowser-launcher")
    ]),
    ("Development & IDE", [
