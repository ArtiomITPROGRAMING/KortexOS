def get_telemetry():
    data = {
        "cpu_percent": 0,
        "temp": 42.0,
        "ram_used": "1.3",
        "ram_total": "3.8",
        "ram_percent": 30,
        "battery": "98%",
        "profile": "BALANCED",
        "hostname": socket.gethostname()
    }
    
    # Try reading KIS telemetry
    if os.path.exists(TELEMETRY_PATH):
        try:
            with open(TELEMETRY_PATH, "r") as f:
                kis = json.load(f)
                data["cpu_percent"] = int(kis.get("cpu_total", 0))
                data["temp"] = kis.get("cpu_temp", 42.0)
                data["profile"] = kis.get("power_profile", "BALANCED")
        except Exception:
            pass

    # Read memory
    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
        mem = {}
        for line in lines:
            parts = line.split(":")
            if len(parts) == 2:
                mem[parts[0].strip()] = int(parts[1].split()[0])
        total_k = mem.get("MemTotal", 1)
        avail_k = mem.get("MemAvailable", total_k)
        used_k = total_k - avail_k
        data["ram_used"] = f"{used_k / (1024 * 1024):.1f}"
        data["ram_total"] = f"{total_k / (1024 * 1024):.1f}"
        data["ram_percent"] = int((used_k / total_k) * 100)
    except Exception:
        pass

    return data

class LinkHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass # Silence normal logs

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(MOBILE_HTML.encode("utf-8"))
        elif self.path == "/api/telemetry":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(get_telemetry()).encode("utf-8"))
        elif self.path == "/api/clipboard":
            text = ""
            try:
                res = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=1)
                text = res.stdout
            except Exception:
                pass
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"text": text}).encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        content_len = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_len).decode("utf-8") if content_len > 0 else "{}"
        try:
            req = json.loads(body)
        except Exception:
            req = {}

        if self.path == "/api/action":
            action = req.get("action")
            if action == "lock":
                subprocess.Popen(["/usr/local/bin/kortex-lock"])
            elif action == "cycle_theme":
                themes = ["mono", "amber", "matrix", "cyan"]
                cur = "mono"
                try:
                    res = subprocess.run(["kortex-ctl", "status"], capture_output=True, text=True)
                    for line in res.stdout.splitlines():
                        if "Active Theme:" in line:
                            cur = line.split(":", 1)[1].strip().lower()
                            break
                except Exception:
                    pass
                idx = (themes.index(cur) + 1) % len(themes) if cur in themes else 0
                subprocess.Popen(["kortex-ctl", "theme", themes[idx]])
            elif action == "profile_overdrive":
                subprocess.Popen(["kortex-ctl", "profile", "overdrive"])
            elif action == "profile_eco":
                subprocess.Popen(["kortex-ctl", "profile", "stealth"])
            elif action == "vol_up":
                subprocess.Popen(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%+"])
            elif action == "vol_down":
                subprocess.Popen(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"])
            elif action == "panic":
                subprocess.Popen(["sudo", "/usr/local/bin/kortex-net-guard", "--panic"])

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"status": "ok"}')

        elif self.path == "/api/clipboard":
            text = req.get("text", "")
            if text:
                try:
                    subprocess.run(["wl-copy"], input=text.encode("utf-8"), timeout=1)
                except Exception:
                    pass
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"status": "ok"}')

def main():
    server = HTTPServer(("0.0.0.0", PORT), LinkHandler)
    print(f"[*] Kortex Link Daemon active on port {PORT}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        server.server_close()

if __name__ == "__main__":
    main()
