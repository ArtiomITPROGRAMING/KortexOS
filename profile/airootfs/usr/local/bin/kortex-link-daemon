#!/usr/bin/env python3
"""
Kortex Link Daemon (kortex-link-daemon)
Lightweight HTTP & REST server (port 8090) providing a responsive mobile eDEX-UI
second screen dashboard and remote command interface.
"""

import os
import sys
import json
import time
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandle
import socket

PORT = 8090
TELEMETRY_PATH = "/run/kortex/telemetry.json"

MOBILE_HTML = """<!DOCTYPE html>
