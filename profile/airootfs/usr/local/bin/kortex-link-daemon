<script>
function updateTelemetry() {
  fetch('/api/telemetry')
    .then(r => r.json())
    .then(data => {
      document.getElementById('cpu-stat').innerText = data.cpu_percent + '% (' + data.temp + '°C)';
      document.getElementById('cpu-bar').style.width = data.cpu_percent + '%';

      document.getElementById('ram-stat').innerText = data.ram_used + ' / ' + data.ram_total + ' GiB (' + data.ram_percent + '%)';
      document.getElementById('ram-bar').style.width = data.ram_percent + '%';

      document.getElementById('status-info').innerText = 'Power Profile: [' + data.profile + '] | Battery: ' + data.battery + ' | Host: ' + data.hostname;
    })
    .catch(e => {
      document.getElementById('status-info').innerText = 'Connection paused';
    });
}

function sendAction(action) {
  fetch('/api/action', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action: action })
  });
}

function pushClip() {
  const text = document.getElementById('clip-text').value;
  fetch('/api/clipboard', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ text: text })
  });
}

function fetchClip() {
  fetch('/api/clipboard')
    .then(r => r.json())
    .then(d => {
      if (d.text) document.getElementById('clip-text').value = d.text;
    });
}

setInterval(updateTelemetry, 1000);
updateTelemetry();
</script>
</body>
</html>
