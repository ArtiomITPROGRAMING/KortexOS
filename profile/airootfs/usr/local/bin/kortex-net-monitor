#!/usr/bin/env python3
"""
KortexOS Ultra-Dense Braille 3D Globe & Oscilloscope Telemetry Monito
(1:1 Tron / eDEX-UI Cyberpunk Aesthetics)
Zero external dependencies.
"""

import curses
import math
import time
import random
import os
import locale
import subprocess
from collections import deque

try:
    locale.setlocale(locale.LC_ALL, '')
except Exception:
    pass

CONTINENTS = [
    (15, 72, -168, -52),   # North America
    (-55, 12, -82, -34),   # South America
    (36, 71, -12, 45),     # Europe
    (-35, 37, -18, 52),    # Africa
    (8, 75, 45, 178),      # Asia
    (-44, -10, 112, 154),  # Australia
    (-90, -65, -180, 180), # Antarctica
    (60, 83, -73, -12),    # Greenland
    (30, 46, 129, 146),    # Japan
    (50, 59, -11, 2),      # UK & Ireland
]

STATIC_NODES = [
    (40.7, -74.0, "NYC"),
    (51.5, -0.1,  "LON"),
    (35.6, 139.6, "TYO"),
    (-33.8, 151.2, "SYD"),
    (37.7, -122.4, "SFO"),
]

def get_active_network_nodes():
    nodes = list(STATIC_NODES)
    try:
        res = subprocess.run(["ss", "-tunH"], capture_output=True, text=True, timeout=1)
        for line in res.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 5:
                rem = parts[4]
                ip = rem.split(":")[0].replace("[", "").replace("]", "")
                if ip and not ip.startswith("127.") and not ip.startswith("10.") and not ip.startswith("192.168.") and not ip.startswith("::"):
                    octs = [int(x) for x in ip.split(".") if x.isdigit()]
                    if len(octs) == 4:
                        lat = -45.0 + ((octs[0] * 11 + octs[1] * 7) % 105)
                        lon = -160.0 + ((octs[2] * 19 + octs[3] * 31) % 320)
                        nodes.append((lat, lon, f"REM-{octs[0]}.{octs[1]}"))
    except Exception:
        pass
    return nodes

def is_land(lat, lon):
    for lat_min, lat_max, lon_min, lon_max in CONTINENTS:
        if lat_min <= lat <= lat_max and lon_min <= lon <= lon_max:
            n = math.sin(lat * 0.25) * math.cos(lon * 0.25) + math.sin(lat * 0.6 + lon * 0.4) * 0.4
            return n > -0.25
    return False

def safe_addstr(stdscr, y, x, text, attr=0):
    try:
        h, w = stdscr.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            max_len = w - x
            if max_len > 0:
                stdscr.addstr(y, x, text[:max_len], attr)
    except Exception:
        pass

def draw_net_panel(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(50)  # ~20 FPS

    curses.start_color()
    curses.use_default_colors()
    dim_attr = curses.A_DIM if curses.COLORS >= 16 else 0
    curses.init_pair(1, curses.COLOR_WHITE, -1)   # Bright white
    curses.init_pair(2, 8 if curses.COLORS >= 16 else curses.COLOR_WHITE, -1) # Grey
    curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_WHITE) # Inverted

    angle_deg = 0.0
    tilt = 0.38
    cos_t, sin_t = math.cos(tilt), math.sin(tilt)

    BLOCKS = [' ', ' ', '▂', '▃', '▄', '▅', '▆', '▇', '█']
    history = deque(maxlen=80)
    for _ in range(80):
        history.append(random.randint(4, 18))

    rx_packets = 28853
    tx_packets = 1718
    rate_mb = 86.7
    peak_mb = 124.2

    while True:
        try:
            h, w = stdscr.getmaxyx()
            stdscr.erase()
            if h < 10 or w < 20:
                safe_addstr(stdscr, 0, 0, "[KORTEX-NET]", curses.color_pair(1))
                stdscr.refresh()
                time.sleep(0.1)
                continue

            # Heade
            safe_addstr(stdscr, 0, 1, "GLOBAL NETWORK MAP // LIVE TELEMETRY", curses.color_pair(1) | curses.A_BOLD)
            if os.path.exists("/run/kortex/panic.state"):
                safe_addstr(stdscr, 1, 1, "[ SHIELD: PANIC LOCKDOWN ACTIVE // ALL EXTERNAL DROPPED ]", curses.color_pair(1) | curses.A_BOLD | curses.A_STANDOUT)
            else:
                status_line = "STATE: ONLINE   IPv4: 10.0.2.15   PING: 0.8ms"
                safe_addstr(stdscr, 1, 1, status_line[:w - 2], curses.color_pair(2) | dim_attr)

            # Available height for globe
            # Total h: reserve ~9 lines at bottom for oscilloscope & telemetry
            globe_h = max(8, min(15, h - 12))
            globe_w = min(w - 2, int(globe_h * 2.5))
            globe_start_x = max(1, (w - globe_w) // 2)
            globe_start_y = 2

            # Subpixel dimensions (2 subpixels per column, 4 per line)
            pw = globe_w * 2
            ph = globe_h * 4
            cx_sub = pw // 2
            cy_sub = ph // 2
            R_sub = min(cx_sub - 2, cy_sub - 2)

            grid = [[0] * pw for _ in range(ph)]
            rot_rad = math.radians(angle_deg)
            cos_r, sin_r = math.cos(rot_rad), math.sin(rot_rad)

            # Sphere raymarch / inverse projection for high density
            R2 = R_sub * R_sub
            for py in range(ph):
                dy = py - cy_sub
                dy2 = dy * dy
                if dy2 > R2:
                    continue
                max_dx = int(math.sqrt(R2 - dy2))
                for px in range(cx_sub - max_dx, cx_sub + max_dx + 1):
                    dx = px - cx_sub
                    d2 = dx * dx + dy2
                    dist = math.sqrt(d2)
                    if abs(dist - R_sub) < 0.85:
                        grid[py][px] = 1
                        continue

                    z = math.sqrt(R2 - d2)
                    nx = dx / R_sub
                    ny = -dy / R_sub
                    nz = z / R_sub

                    # Tilt
                    ny_t = ny * cos_t + nz * sin_t
                    nz_t = -ny * sin_t + nz * cos_t
                    nx_t = nx

                    # Rotation
                    nx_r = nx_t * cos_r - nz_t * sin_
                    nz_r = nx_t * sin_r + nz_t * cos_
                    ny_r = ny_t

                    lat = math.degrees(math.asin(max(-1.0, min(1.0, ny_r))))
                    lon = math.degrees(math.atan2(nx_r, nz_r))

                    land = is_land(lat, lon)
                    is_grid = (abs(lat % 20.0) < 1.2) or (abs(lon % 30.0) < 1.4) or (abs(lat) < 1.6)

                    if land:
                        grid[py][px] = 1
                    elif is_grid and ((px + py) % 2 == 0):
                        grid[py][px] = 1

            # Project Active Network Nodes onto Globe
            live_nodes = get_active_network_nodes()
            pulse = (int(time.time() * 4) % 2 == 0)
            for n_lat, n_lon, n_label in live_nodes:
                rad_lat = math.radians(n_lat)
                rad_lon = math.radians(n_lon)
                ny_p = math.sin(rad_lat)
                nx_p = math.cos(rad_lat) * math.sin(rad_lon)
                nz_p = math.cos(rad_lat) * math.cos(rad_lon)

                # Rotate & tilt to screen space
                nx_r = nx_p * cos_r + nz_p * sin_
                nz_r = -nx_p * sin_r + nz_p * cos_
                ny_r = ny_p

                ny_t = ny_r * cos_t - nz_r * sin_t
                nz_t = ny_r * sin_t + nz_r * cos_t
                nx_t = nx_

                if nz_t > 0.05: # Visible on front of sphere
                    n_px = int(cx_sub + nx_t * R_sub)
                    n_py = int(cy_sub - ny_t * R_sub)
                    if pulse:
                        for dpx in (-1, 0, 1):
                            for dpy in (-1, 0, 1):
                                if 0 <= n_py + dpy < sub_h and 0 <= n_px + dpx < sub_w:
                                    grid[n_py + dpy][n_px + dpx] = 1
                    else:
                        if 0 <= n_py < sub_h and 0 <= n_px < sub_w:
                            grid[n_py][n_px] = 1

            # Convert subpixel grid to Braille characters
            for cy_cell in range(globe_h):
                row_chars = []
                for cx_cell in range(globe_w):
                    val = 0x2800
                    if grid[cy_cell * 4 + 0][cx_cell * 2 + 0]: val |= 0x01
                    if grid[cy_cell * 4 + 1][cx_cell * 2 + 0]: val |= 0x02
                    if grid[cy_cell * 4 + 2][cx_cell * 2 + 0]: val |= 0x04
                    if grid[cy_cell * 4 + 3][cx_cell * 2 + 0]: val |= 0x40
                    if grid[cy_cell * 4 + 0][cx_cell * 2 + 1]: val |= 0x08
                    if grid[cy_cell * 4 + 1][cx_cell * 2 + 1]: val |= 0x10
                    if grid[cy_cell * 4 + 2][cx_cell * 2 + 1]: val |= 0x20
                    if grid[cy_cell * 4 + 3][cx_cell * 2 + 1]: val |= 0x80
                    row_chars.append(chr(val) if val != 0x2800 else ' ')
                safe_addstr(stdscr, globe_start_y + cy_cell, globe_start_x, "".join(row_chars), curses.color_pair(1))

            # Bottom Oscilloscope Section
            traffic_y = globe_start_y + globe_h + 1
            if traffic_y < h - 4:
                # Oscilloscope border without duplicate heade
                speed_badge = f" [ {rate_mb:.1f} Mb/s ] "
                border_mid = max(0, w - 18 - len(speed_badge))
                hdr_line = "┌ LIVE TRAFFIC " + ("─" * border_mid) + speed_badge + "┐"
                safe_addstr(stdscr, traffic_y, 1, hdr_line[:w - 2], curses.color_pair(2) | dim_attr)
                traffic_y += 1

                # Update live traffic sample
                t_noise = (math.sin(time.time() * 2.5) * 6) + (math.cos(time.time() * 5.2) * 4) + random.uniform(-2, 3)
                next_val = max(1, min(23, int(11 + t_noise)))
                history.append(next_val)

                # Draw 3-line oscilloscope waveform across full box width
                wave_w = max(10, w - 4)
                hist_slice = list(history)[-wave_w:]
                if len(hist_slice) < wave_w:
                    hist_slice = [5] * (wave_w - len(hist_slice)) + hist_slice

                for r in [2, 1, 0]: # 2=top(16..24), 1=mid(8..16), 0=bot(0..8)
                    if traffic_y >= h - 3:
                        break
                    row_chars = []
                    base = r * 8
                    for lv in hist_slice:
                        v = lv - base
                        if v <= 0:
                            ch = " "
                        elif v >= 8:
                            ch = "█"
                        else:
                            ch = BLOCKS[v]
                        row_chars.append(ch)
                    safe_addstr(stdscr, traffic_y, 2, "".join(row_chars), curses.color_pair(1) | curses.A_BOLD)
                    traffic_y += 1

                # Telemetry counters
                rx_packets += random.randint(15, 60)
                tx_packets += random.randint(5, 20)
                if traffic_y < h - 1:
                    safe_addstr(stdscr, traffic_y, 2, f"Packets (RX):         {rx_packets}", curses.color_pair(2) | dim_attr)
                    traffic_y += 1
                if traffic_y < h - 1:
                    safe_addstr(stdscr, traffic_y, 2, f"Packets (TX):          {tx_packets}", curses.color_pair(2) | dim_attr)
                    traffic_y += 1
                if traffic_y < h - 1:
                    safe_addstr(stdscr, traffic_y, 2, "Packets (ERR):            0", curses.color_pair(2) | dim_attr)

            stdscr.refresh()
            angle_deg = (angle_deg + 3.0) % 360.0

            key = stdscr.getch()
            if key == ord('q'):
                break
        except curses.error:
            pass
        except Exception:
            time.sleep(0.05)

def main():
    curses.wrapper(draw_net_panel)

if __name__ == '__main__':
    main()
