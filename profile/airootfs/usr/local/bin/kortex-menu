#!/usr/bin/env python3
"""
KortexOS Main Start Menu (kortex-menu)
Windows 11 + macOS Launchpad Hybrid Start Menu.
Triggered by Super+D or Waybar [ KORTEX ] button.
Displays Desktop Mode Switcher, Core Apps, Control & Settings, User Plugins, and All Installed Apps.
"""

import os
import sys
import glob
import subprocess

ROFI_THEME = os.path.expanduser("~/.config/rofi/kortex-start.rasi")
FALLBACK_THEME = "/etc/skel/.config/rofi/kortex-start.rasi"
PLUGINS_DIR = os.path.expanduser("~/.config/kortex/plugins")
GLOBAL_PLUGINS_DIR = "/usr/share/kortex/plugins"

PINNED_ITEMS = [
    ("  Режим Mac / Windows (Окна, Стекло и Нижний Док)", "/usr/local/bin/kortex-layout floating"),
    ("⊞  Режим Cyber-Deck (Хакерская Сетка 5 Панелей)",    "/usr/local/bin/kortex-layout grid"),
    ("▤  Режим Разработчика (Чистый Тайлинг на весь экран)","/usr/local/bin/kortex-layout tiling"),
    ("🔍 Поиск и Калькулятор Spotlight (Super+Space)",      "/usr/local/bin/kortex-spotlight"),
    ("🌐 Веб-Браузер Firefox (Интернет / Super+B)",         "/usr/local/bin/kortex-launch firefox"),
    ("📁 Проводник Файлов Yazi (Win+E)",                    "kitty --class kortex-files -e yazi"),
    ("🐚 Терминал Kitty (Super+Enter)",                     "/usr/local/bin/kortex-launch kitty"),
    ("💬 Мессенджер KortexGram (E2EE Чат)",                 "/usr/local/bin/kortex-gram"),
    ("🎵 Музыка и Synthwave Радио",                         "/usr/local/bin/kortex-open music"),
    ("🏪 Магазин Программ (App Hub / Super+P)",             "/usr/local/bin/kortex-open store"),
    ("🤖 ИИ-Ассистент Kortex AI (Super+A)",                 "/usr/local/bin/kortex-open ai"),
    ("🎨 Настройки, Темы и Стекло (Theme Studio / Super+S)","/usr/local/bin/kortex-open settings"),
    ("🎛️ Центр Управления: Звук, Яркость, Wi-Fi (Super+C)", "/usr/local/bin/kortex-control-center"),
    ("📊 Диспетчер Задач (Task Manager / Ctrl+Shift+Esc)",  "kitty --class kortex-taskmgr --title 'Task Manager (btop)' -e btop"),
    ("🛡️ Сетевой Экран (Net Guard / Super+N)",              "/usr/local/bin/kortex-open net-guard"),
    ("💾 Бэкапы и Крипто-Сейф (Vault)",                     "/usr/local/bin/kortex-open vault"),
    ("📖 Обучение и Гид по Системе (Welcome Tour)",         "/usr/local/bin/kortex-open tour"),
    ("⌨️ Шпаргалка Горячих Клавиш (Super+F1)",              "/usr/local/bin/kortex-help-hud"),
    ("💿 Установить KortexOS на Диск (Installer)",          "/usr/local/bin/kortex-open install"),
    ("🔒 Заблокировать Экран (Win+L)",                      "/usr/local/bin/kortex-open lock"),
    ("🔄 Перезагрузить Компьютер (Reboot)",                 "systemctl reboot"),
    ("⏻  Выключить Компьютер (Power Off)",                  "systemctl poweroff"),
]

def get_plugins():
    plugins = {}
    for d in [PLUGINS_DIR, GLOBAL_PLUGINS_DIR]:
        if os.path.exists(d):
            for path in glob.glob(f"{d}/*"):
                if os.path.isfile(path) and os.access(path, os.X_OK):
                    name = os.path.basename(path)
                    plugins[f"🔌 Плагин: {name}"] = path
    return plugins

def get_desktop_apps():
    apps = {}
    search_dirs = [
        "/usr/share/applications",
        os.path.expanduser("~/.local/share/applications"),
        "/var/lib/flatpak/exports/share/applications"
    ]
    for d in search_dirs:
        if os.path.exists(d):
            for path in glob.glob(f"{d}/*.desktop"):
                try:
                    name, exec_cmd, nodisplay = None, None, False
                    with open(path, "r", encoding="utf-8", errors="ignore") as f:
                        in_desktop = False
                        for line in f:
                            line = line.strip()
                            if line == "[Desktop Entry]":
                                in_desktop = True
                                continue
                            elif line.startswith("[") and line != "[Desktop Entry]":
                                in_desktop = False
                            if in_desktop:
                                if line.startswith("Name=") and not name:
                                    name = line.split("=", 1)[1].strip()
                                elif line.startswith("Exec=") and not exec_cmd:
                                    exec_cmd = line.split("=", 1)[1].strip()
                                elif line.startswith("NoDisplay=true"):
                                    nodisplay = True
                    if name and exec_cmd and not nodisplay:
                        clean_exec = " ".join([p for p in exec_cmd.split() if not p.startswith("%")])
                        apps[name] = clean_exec
                except Exception:
                    pass
    return apps

def main():
    theme = ROFI_THEME if os.path.exists(ROFI_THEME) else FALLBACK_THEME
    desktop_apps = get_desktop_apps()
    plugins = get_plugins()

    menu_map = {}
    options = []

    for label, cmd in PINNED_ITEMS:
        options.append(label)
        menu_map[label] = cmd

    if plugins:
        hdr_p = "───[ ПЛАГИНЫ (~/.config/kortex/plugins) ]───"
        options.append(hdr_p)
        menu_map[hdr_p] = ""
        for p_label, p_cmd in plugins.items():
            options.append(p_label)
            menu_map[p_label] = p_cmd

    hdr_a = "──────────────[ ВСЕ ПРОГРАММЫ / ALL APPS ]──────────────"
    options.append(hdr_a)
    menu_map[hdr_a] = ""

    for name in sorted(desktop_apps.keys(), key=lambda s: s.lower()):
        lbl = f"  ▸ {name}"
        options.append(lbl)
        menu_map[lbl] = desktop_apps[name]

    input_text = "\n".join(options)

    cmd = [
        "rofi",
        "-dmenu",
        "-i",
        "-p", "⊞ ПУСК // KORTEX",
        "-theme", theme
    ]

    try:
        proc = subprocess.run(cmd, input=input_text, capture_output=True, text=True)
        selected = proc.stdout.strip()
        if selected and selected in menu_map and menu_map[selected]:
            action = menu_map[selected]
            subprocess.Popen(action, shell=True)
    except Exception:
        sys.exit(1)

if __name__ == "__main__":
    main()
