#!/usr/bin/env python3
"""
Kortex AI Background Daemon
Monitors local GGUF models, provides background neural service, and exposes system diagnostics.
"""

import os
import sys
import time
import glob
import subprocess
import signal

MODEL_DIR = "/usr/share/kortex/models"
USER_MODEL_DIR = os.path.expanduser("~/.local/share/kortex/models")

def find_local_model():
    for d in (MODEL_DIR, USER_MODEL_DIR):
        if os.path.exists(d):
            models = glob.glob(f"{d}/*.gguf")
            if models:
                return models[0]
    return None

def main():
    print("[*] Kortex AI Background Daemon initialized.")
    server_proc = None
    
    def cleanup(sig, frame):
        if server_proc:
            server_proc.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    while True:
        # Check if llama-server binary exists and a model is downloaded
        model_path = find_local_model()
        llama_bin = "/usr/bin/llama-server"
        
        if model_path and os.path.exists(llama_bin) and (not server_proc or server_proc.poll() is not None):
            print(f"[+] Launching local neural server with model: {model_path}")
            try:
                server_proc = subprocess.Popen([
                    llama_bin,
                    "-m", model_path,
                    "--host", "127.0.0.1",
                    "--port", "8080",
                    "-c", "2048",
                    "-ngl", "33"
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                print(f"[-] Failed to start llama-server: {e}")

        time.sleep(10)

if __name__ == "__main__":
    main()
