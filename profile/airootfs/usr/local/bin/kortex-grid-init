#!/usr/bin/env bash
# ==============================================================================
# KORTEX-OS DESKTOP SESSION INITIALIZER
# Instant boot into a clean desktop with Cyber Glass wallpaper,
# top Waybar panel, and bottom 6-icon Glass Dock (no OOBE, no 5-panel grid).
# ==============================================================================

exec > >(tee /tmp/kortex-init.log) 2>&1

pkill -9 -f "hyprland-welcome|hyprland-dialog|hyprland-donate" 2>/dev/null || true

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    w_sock=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name "wayland-*" -type s 2>/dev/null | head -n 1 | xargs -r basename || true)
    export WAYLAND_DISPLAY="${w_sock:-wayland-1}"
fi

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    h_sig=$(find "$XDG_RUNTIME_DIR/hypr" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -n 1 | xargs -r basename || true)
    export HYPRLAND_INSTANCE_SIGNATURE="$h_sig"
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if systemd-detect-virt --quiet 2>/dev/null; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
fi

mkdir -p "$HOME/.config/kortex" 2>/dev/null || true
touch "$HOME/.config/kortex/.setup_done" 2>/dev/null || true

# Allow hyprland.start background commands to initialize before watchdog checks
sleep 0.5

# 1. Ensure default wallpaper (/usr/share/backgrounds/kortex/cyber_glass.png) is active
if ! pgrep -x hyprpaper >/dev/null 2>&1; then
    hyprpaper >/dev/null 2>&1 &
fi

# 2. Ensure top Waybar panel is running
if ! pgrep -f "^(/usr/bin/)?waybar$" >/dev/null 2>&1; then
    waybar >/dev/null 2>&1 &
fi

# 3. Ensure bottom 6-icon Dock is running
if [ -f "$HOME/.config/waybar/config-dock" ]; then
    if ! pgrep -f "waybar -c .*config-dock" >/dev/null 2>&1; then
        waybar -c "$HOME/.config/waybar/config-dock" -s "$HOME/.config/waybar/style-dock.css" >/dev/null 2>&1 &
    fi
fi

exit 0
