#!/usr/bin/env bash
# ==============================================================================
# KORTEX-OS GRID INITIALIZER
# Staggered Cyberpunk Workspace Spawner (eDEX-UI 5-Module Layout)
# ==============================================================================

# Enable file logging for debugging
exec > >(tee /tmp/kortex-init.log) 2>&1

# Suppress Hyprland welcome / dialogs and force config reload
hyprctl reload config-only 2>/dev/null || true
pkill -9 -f "hyprland-welcome|hyprland-dialog|hyprland-donate" 2>/dev/null || true

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Ensure Wayland environment variables are present
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    w_sock=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name "wayland-*" -type s 2>/dev/null | head -n 1 | xargs -r basename || true)
    export WAYLAND_DISPLAY="${w_sock:-wayland-1}"
fi

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    h_sig=$(find "$XDG_RUNTIME_DIR/hypr" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -n 1 | xargs -r basename || true)
    export HYPRLAND_INSTANCE_SIGNATURE="$h_sig"
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

# Auto-detect VM environment and guarantee software renderer fallback for kitty
if systemd-detect-virt --quiet 2>/dev/null; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
fi

# Launch Waybar if not running
if ! pgrep -x waybar >/dev/null 2>&1; then
    waybar >/dev/null 2>&1 &
fi

# Prevent duplicate launches of grid modules (kill all prior kitty instances)
pkill -f kitty 2>/dev/null || true
sleep 0.2

# 1. Main Center Terminal (First) with 5 eDEX-UI tabs
if [ -f /etc/kortex/kitty-main.session ]; then
    kitty --class kortex-term --session /etc/kortex/kitty-main.session &
else
    kitty --class kortex-term --title "MAIN" &
fi
sleep 0.15

# 2. System Telemetry Pulse (Left)
kitty --class kortex-pulse -e /usr/local/bin/kortex-sys-panel &
sleep 0.15

# 3. 3D Globe & Network Telemetry (Right-Top)
kitty --class kortex-net -e /usr/local/bin/kortex-net-monitor &
sleep 0.15

# 4. File Grid Explorer (Center-Bottom)
kitty --class kortex-files -e /usr/local/bin/kortex-file-grid &
sleep 0.15

# 5. Interactive QWERTY Keyboard (Right-Bottom)
kitty --class kortex-kb -e /usr/local/bin/kortex-keyboard &
sleep 0.2

# Automatically align all 5 windows to their target coordinates & sizes
/usr/local/bin/kortex-grid-align &
