#!/usr/bin/env python3
"""
Kortex AI Assistant (kortex-ai)
Autonomous offline neural assistant for KortexOS Intelligence System.
Supports interactive Tron TUI chat, error analysis, command execution, and local LLM connectors.
"""

import os
import sys

# Ensure clean terminal environment for curses
if "TERM" not in os.environ or os.environ["TERM"] in ("", "unknown"):
    os.environ["TERM"] = "xterm-256color"

import re
import json
import time
import curses
import subprocess
import urllib.request
import urllib.erro

