#!/usr/bin/env python3
"""
Kortex Link Companion & ADB Cyber-Deck (kortex-link)
Displays QR code for smartphone second screen pairing and manages ADB connected devices.
"""

import os
import sys
import time
import socket
import curses
import subprocess

PORT = 8090

def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def get_qr_lines(url):
    try:
        res = subprocess.run(["qrencode", "-t", "UTF8", url], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout:
            return res.stdout.splitlines()
    except Exception:
        pass
    return []

def get_adb_info():
    devices = []
    try:
        res = subprocess.run(["adb", "devices", "-l"], capture_output=True, text=True, timeout=2)
        for line in res.stdout.splitlines():
            line = line.strip()
            if line and not line.startswith("List of devices"):
                parts = line.split()
                if len(parts) >= 2 and parts[1] == "device":
                    dev_id = parts[0]
                    # Get model
                    model = "Android Device"
                    for p in parts[2:]:
                        if p.startswith("model:"):
                            model = p.split("model:")[1]
                    # Get battery level
                    bat = "N/A"
                    try:
                        b_res = subprocess.run(["adb", "-s", dev_id, "shell", "dumpsys", "battery"], capture_output=True, text=True, timeout=2)
                        for b_line in b_res.stdout.splitlines():
                            if "level:" in b_line:
                                bat = b_line.split("level:")[1].strip() + "%"
                                break
                    except Exception:
                        pass
                    devices.append((dev_id, model, bat))
    except Exception:
        pass
    return devices

def safe_addstr(win, y, x, text, attr=0):
    max_y, max_x = win.getmaxyx()
    if 0 <= y < max_y and 0 <= x < max_x:
        try:
            win.addstr(y, x, text[:max_x - x - 1], attr)
        except curses.error:
            pass

def tui_main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(1000)

    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)
    curses.init_pair(3, curses.COLOR_CYAN, -1)
    curses.init_pair(4, curses.COLOR_GREEN, -1)

    ip = get_local_ip()
    url = f"http://{ip}:{PORT}"
    qr_lines = get_qr_lines(url)
    adb_devs = get_adb_info()
    last_adb_check = time.time()

    while True:
        now = time.time()
        if now - last_adb_check > 4.0:
            last_adb_check = now
            adb_devs = get_adb_info()

        h, w = stdscr.getmaxyx()
        stdscr.erase()

        # Border
        safe_addstr(stdscr, 0, 0, "┌" + "─" * (w - 2) + "┐", curses.color_pair(1))
        for y in range(1, h - 1):
            safe_addstr(stdscr, y, 0, "│", curses.color_pair(1))
            safe_addstr(stdscr, y, w - 1, "│", curses.color_pair(1))
        safe_addstr(stdscr, h - 1, 0, "└" + "─" * (w - 2) + "┘", curses.color_pair(1))

        # Title
        title = " [ KORTEX-LINK // MOBILE COMPANION & ADB CYBER-DECK ] "
        safe_addstr(stdscr, 0, max(2, (w - len(title)) // 2), title, curses.color_pair(2))

        # Left Column: QR Code
        safe_addstr(stdscr, 2, 3, " [ SMARTPHONE SECOND SCREEN ] ", curses.color_pair(3) | curses.A_BOLD)
        safe_addstr(stdscr, 3, 3, f"URL: {url}", curses.color_pair(4) | curses.A_BOLD)
        safe_addstr(stdscr, 4, 3, "Scan with phone camera to pair in 2 seconds:", curses.A_DIM | curses.color_pair(1))

        qr_start_y = 6
        if qr_lines:
            for i, line in enumerate(qr_lines):
                if qr_start_y + i < h - 3:
                    safe_addstr(stdscr, qr_start_y + i, 3, line, curses.color_pair(1))
        else:
            safe_addstr(stdscr, qr_start_y + 2, 5, "[ QR Engine Initializing ]", curses.color_pair(1))
            safe_addstr(stdscr, qr_start_y + 4, 5, f"Open browser: {url}", curses.color_pair(4))

        # Right Column: ADB & Device Telemetry
        col2_x = max(42, w // 2)
        if col2_x < w - 15:
            safe_addstr(stdscr, 2, col2_x, " [ ANDROID ADB BRIDGE STATUS ] ", curses.color_pair(3) | curses.A_BOLD)
            
            if adb_devs:
                dev_y = 4
                for dev_id, model, bat in adb_devs:
                    if dev_y < h - 4:
                        safe_addstr(stdscr, dev_y, col2_x, f"• DEVICE: {model}", curses.color_pair(1) | curses.A_BOLD)
                        safe_addstr(stdscr, dev_y + 1, col2_x, f"  SERIAL : {dev_id} | BATTERY: {bat}", curses.color_pair(4))
                        safe_addstr(stdscr, dev_y + 2, col2_x, "  STATUS : ONLINE & AUTHORIZED", curses.color_pair(1))
                        safe_addstr(stdscr, dev_y + 3, col2_x, "  [P] Push ~/Downloads to Phone", curses.color_pair(3))
                        dev_y += 5
            else:
                safe_addstr(stdscr, 4, col2_x, "No Android device detected via USB/WiFi.", curses.A_DIM | curses.color_pair(1))
                safe_addstr(stdscr, 5, col2_x, "Connect device with USB debugging enabled.", curses.A_DIM | curses.color_pair(1))
                safe_addstr(stdscr, 7, col2_x, "WIRELESS ADB INSTRUCTION:", curses.color_pair(1))
                safe_addstr(stdscr, 8, col2_x, "  1. adb tcpip 5555", curses.A_DIM | curses.color_pair(1))
                safe_addstr(stdscr, 9, col2_x, "  2. adb connect <phone_ip>:5555", curses.A_DIM | curses.color_pair(1))

            # Features list
            feat_y = max(14, h - 8)
            safe_addstr(stdscr, feat_y, col2_x, "MOBILE DECK CAPABILITIES:", curses.color_pair(2))
            safe_addstr(stdscr, feat_y + 1, col2_x, "• Live CPU & RAM Telemetry HUD", curses.color_pair(1))
            safe_addstr(stdscr, feat_y + 2, col2_x, "• Touch-to-Lock & Theme Switcher", curses.color_pair(1))
            safe_addstr(stdscr, feat_y + 3, col2_x, "• Emergency Panic Lockdown Trigger", curses.color_pair(1))
            safe_addstr(stdscr, feat_y + 4, col2_x, "• Two-Way Realtime Clipboard Sync", curses.color_pair(1))

        # Bottom Bar
        safe_addstr(stdscr, h - 2, 3, " [Q] Close Companion Deck     [R] Refresh Devices ", curses.color_pair(2))

        stdscr.refresh()

        try:
            ch = stdscr.getch()
            if ch in (ord('q'), ord('Q'), 27):
                break
            elif ch in (ord('r'), ord('R')):
                adb_devs = get_adb_info()
            elif ch in (ord('p'), ord('P')) and adb_devs:
                # Push downloads
                dev_id = adb_devs[0][0]
                subprocess.Popen(["adb", "-s", dev_id, "push", os.path.expanduser("~/Downloads"), "/sdcard/Download/"])
        except KeyboardInterrupt:
            break

def main():
    os.environ.setdefault("TERM", "xterm-256color")
    try:
        curses.wrapper(tui_main)
    except Exception as e:
        print(f"[-] Kortex Link error: {e}")

if __name__ == "__main__":
    main()
