#!/usr/bin/env python3
"""
KortexOS Grid Alignment Engine
Applies precise percentage coordinates and dimensions to the 5 modular desktop windows.
"""

import subprocess
import json
import os
import glob
import time

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hypr_dirs = glob.glob(f"{env['XDG_RUNTIME_DIR']}/hypr/*")
        if hypr_dirs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(hypr_dirs[0])
    return env

def hypr_dispatch(cmd_str, env):
    parts = cmd_str.split(" ", 1)
    try:
        subprocess.run(["hyprctl", "dispatch"] + parts, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

def main():
    env = get_hypr_env()

    # Wait for the 5 target clients to map
    target_classes = {"kortex-pulse", "kortex-term", "kortex-net", "kortex-files", "kortex-kb"}
    
    for _ in range(30):
        try:
            out = subprocess.check_output(["hyprctl", "-j", "clients"], env=env, text=True, timeout=2)
            clients = json.loads(out)
            found = {c.get("class") for c in clients}
            if target_classes.issubset(found):
                break
        except Exception:
            pass
        time.sleep(0.1)

    # Fetch active monitor size
    mw, mh = 1920, 1080
    try:
        mon_out = subprocess.check_output(["hyprctl", "-j", "monitors"], env=env, text=True, timeout=2)
        monitors = json.loads(mon_out)
        if monitors:
            mw = monitors[0].get("width", 1920)
            mh = monitors[0].get("height", 1080)
    except Exception:
        pass

    # Window geometry map (exact percentages)
    # 1. kortex-pulse: move 0.5% 4%,  size 19% 95%
    # 2. kortex-term:  move 20% 4%,   size 57% 62%
    # 3. kortex-net:   move 77.5% 4%, size 22% 62%
    # 4. kortex-files: move 20% 67%,  size 33% 32%
    # 5. kortex-kb:    move 53.5% 67%, size 46% 32%
    layout = {
        "kortex-pulse": (int(mw * 0.005), int(mh * 0.04), int(mw * 0.19),  int(mh * 0.95)),
        "kortex-term":  (int(mw * 0.20),  int(mh * 0.04), int(mw * 0.57),  int(mh * 0.62)),
        "kortex-net":   (int(mw * 0.775), int(mh * 0.04), int(mw * 0.22),  int(mh * 0.62)),
        "kortex-files": (int(mw * 0.20),  int(mh * 0.67), int(mw * 0.33),  int(mh * 0.32)),
        "kortex-kb":    (int(mw * 0.535), int(mh * 0.67), int(mw * 0.46),  int(mh * 0.32)),
    }

    for cls, (x, y, w, h) in layout.items():
        hypr_dispatch(f"focuswindow class:{cls}", env)
        time.sleep(0.04)
        hypr_dispatch(f"resizewindowpixel exact {w} {h},class:{cls}", env)
        time.sleep(0.04)
        hypr_dispatch(f"movewindowpixel exact {x} {y},class:{cls}", env)
        time.sleep(0.04)

    # Focus main terminal so user can type immediately
    time.sleep(0.05)
    hypr_dispatch("focuswindow class:kortex-term", env)

if __name__ == "__main__":
    main()
