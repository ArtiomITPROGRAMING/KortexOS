#!/usr/bin/env python3
"""
KortexOS Popup Alignment Engine
Positions floating dialog windows (kortex-settings, kortex-ai, kortex-install)
centered and precisely sized on screen.
"""

import subprocess
import json
import os
import glob
import time
import sys

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hypr_dirs = glob.glob(f"{env['XDG_RUNTIME_DIR']}/hypr/*")
        if hypr_dirs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(hypr_dirs[0])
    return env

def main():
    target_cls = sys.argv[1] if len(sys.argv) > 1 else "kortex-settings"
    env = get_hypr_env()

    # Wait up to 1.5s for window
    for _ in range(30):
        try:
            out = subprocess.check_output(["hyprctl", "-j", "clients"], env=env, text=True)
            clients = json.loads(out)
            if any(c.get("class") == target_cls for c in clients):
                break
        except Exception:
            pass
        time.sleep(0.05)

    # Monitor size
    mw, mh = 1920, 1080
    try:
        mon_out = subprocess.check_output(["hyprctl", "-j", "monitors"], env=env, text=True)
        monitors = json.loads(mon_out)
        if monitors:
            mw = monitors[0].get("width", 1920)
            mh = monitors[0].get("height", 1080)
    except Exception:
        pass

    pw, ph = int(mw * 0.64), int(mh * 0.74)
    px, py = (mw - pw) // 2, (mh - ph) // 2

    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ window = 'class:{target_cls}' }})"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.04)
    subprocess.run(["hyprctl", "dispatch", "hl.dsp.window.float()"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.04)
    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.window.resize({{ x = {pw}, y = {ph} }})"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.04)
    subprocess.run(["hyprctl", "dispatch", f"hl.dsp.window.move({{ x = {px}, y = {py} }})"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
