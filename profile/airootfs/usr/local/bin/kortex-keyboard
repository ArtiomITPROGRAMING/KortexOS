#!/usr/bin/env python3
"""
KortexOS Full-Matrix Interactive Cyberpunk Keyboard Subsystem
(1:1 Tron / eDEX-UI Aesthetics)
Full-width 6-row layout with F-keys, clean labels, and dynamic illumination.
"""

import curses
import os
import sys
import time
import threading
import locale

try:
    locale.setlocale(locale.LC_ALL, '')
except Exception:
    pass

# Scancode mapping to key identifiers
SCANCODE_MAP = {
    1: "ESC", 59: "F1", 60: "F2", 61: "F3", 62: "F4", 63: "F5", 64: "F6", 65: "F7", 66: "F8", 67: "F9", 68: "F10", 87: "F11", 88: "F12",
    41: "~", 2: "1", 3: "2", 4: "3", 5: "4", 6: "5", 7: "6", 8: "7", 9: "8", 10: "9", 11: "0", 12: "-", 13: "=", 14: "BKSP",
    15: "TAB", 16: "Q", 17: "W", 18: "E", 19: "R", 20: "T", 21: "Y", 22: "U", 23: "I", 24: "O", 25: "P", 26: "[", 27: "]", 43: "\\",
    58: "CAPS", 30: "A", 31: "S", 32: "D", 33: "F", 34: "G", 35: "H", 36: "J", 37: "K", 38: "L", 39: ";", 40: "'", 28: "ENTER",
    42: "SHIFT", 44: "Z", 45: "X", 46: "C", 47: "V", 48: "B", 49: "N", 50: "M", 51: ",", 52: ".", 53: "/", 54: "SHIFT",
    29: "CTRL", 125: "SUPER", 56: "ALT", 57: "SPACE", 100: "ALT", 126: "SUPER", 97: "CTRL",
    105: "◄", 103: "▲", 108: "▼", 106: "►"
}

pressed_labels = set()
lock = threading.Lock()

def evdev_listener():
    """Background listener for /dev/input keyboard events"""
    global pressed_labels
    try:
        import evdev
        from evdev import ecodes
        import select

        devices = [evdev.InputDevice(path) for path in evdev.list_devices()]
        kbd_devs = [d for d in devices if ecodes.EV_KEY in d.capabilities()]
        if not kbd_devs:
            return

        while True:
            r, _, _ = select.select(kbd_devs, [], [], 0.5)
            for dev in r:
                try:
                    for ev in dev.read():
                        if ev.type == ecodes.EV_KEY:
                            lbl = SCANCODE_MAP.get(ev.code, "")
                            with lock:
                                if ev.value in (1, 2) and lbl:
                                    pressed_labels.add(lbl)
                                elif ev.value == 0 and lbl:
                                    pressed_labels.discard(lbl)
                except Exception:
                    pass
    except Exception:
        pass

# 6-Row keyboard layout: (display_label, key_id, relative_weight)
ROWS_DEF = [
    [("ESC", "ESC", 1.1), ("F1", "F1", 1.0), ("F2", "F2", 1.0), ("F3", "F3", 1.0), ("F4", "F4", 1.0), ("F5", "F5", 1.0), ("F6", "F6", 1.0), ("F7", "F7", 1.0), ("F8", "F8", 1.0), ("F9", "F9", 1.0), ("F10", "F10", 1.0), ("F11", "F11", 1.0), ("F12", "F12", 1.1)],
    [("~", "~", 1.0), ("1", "1", 1.0), ("2", "2", 1.0), ("3", "3", 1.0), ("4", "4", 1.0), ("5", "5", 1.0), ("6", "6", 1.0), ("7", "7", 1.0), ("8", "8", 1.0), ("9", "9", 1.0), ("0", "0", 1.0), ("-", "-", 1.0), ("=", "=", 1.0), ("BKSP", "BKSP", 1.8)],
    [("TAB", "TAB", 1.5), ("Q", "Q", 1.0), ("W", "W", 1.0), ("E", "E", 1.0), ("R", "R", 1.0), ("T", "T", 1.0), ("Y", "Y", 1.0), ("U", "U", 1.0), ("I", "I", 1.0), ("O", "O", 1.0), ("P", "P", 1.0), ("[", "[", 1.0), ("]", "]", 1.0), ("\\", "\\", 1.2)],
    [("CAPS", "CAPS", 1.7), ("A", "A", 1.0), ("S", "S", 1.0), ("D", "D", 1.0), ("F", "F", 1.0), ("G", "G", 1.0), ("H", "H", 1.0), ("J", "J", 1.0), ("K", "K", 1.0), ("L", "L", 1.0), (";", ";", 1.0), ("'", "'", 1.0), ("ENTER", "ENTER", 2.0)],
    [("SHIFT", "SHIFT", 2.2), ("Z", "Z", 1.0), ("X", "X", 1.0), ("C", "C", 1.0), ("V", "V", 1.0), ("B", "B", 1.0), ("N", "N", 1.0), ("M", "M", 1.0), (",", ",", 1.0), (".", ".", 1.0), ("/", "/", 1.0), ("SHIFT", "SHIFT", 2.5)],
    [("CTRL", "CTRL", 1.4), ("SUPER", "SUPER", 1.3), ("ALT", "ALT", 1.3), ("SPACE", "SPACE", 5.6), ("ALT", "ALT", 1.3), ("SUPER", "SUPER", 1.3), ("CTRL", "CTRL", 1.4), ("◄", "◄", 1.0), ("▲", "▲", 1.0), ("▼", "▼", 1.0), ("►", "►", 1.0)],
]

def safe_addstr(stdscr, y, x, text, attr=0):
    try:
        h, w = stdscr.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            max_len = w - x
            if max_len > 0:
                stdscr.addstr(y, x, text[:max_len], attr)
    except Exception:
        pass

def draw_keyboard(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(50)

    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)   # Standard outline & text
    dim_color = 8 if curses.COLORS >= 16 else curses.COLOR_WHITE
    curses.init_pair(2, dim_color, -1)            # Dim border
    curses.init_pair(3, curses.COLOR_BLACK, curses.COLOR_WHITE) # Inverted active / illuminated

    # Background evdev hardware listener
    t = threading.Thread(target=evdev_listener, daemon=True)
    t.start()

    transient = {}
    demo_keys = ["S", "I", "ENTER", "SPACE", "A", "F5", "CTRL", "SUPER", "E"]
    demo_idx = 0
    next_demo = time.time() + 1.5

    while True:
        try:
            h, w = stdscr.getmaxyx()
            stdscr.erase()

            # Non-blocking curses key reading
            ch = stdscr.getch()
            if ch != -1:
                ch_s = chr(ch).upper() if 32 <= ch <= 126 else ""
                if ch_s:
                    transient[ch_s] = time.time() + 0.35
                elif ch in (10, 13):
                    transient["ENTER"] = time.time() + 0.35
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    transient["BKSP"] = time.time() + 0.35
                elif ch == 27:
                    transient["ESC"] = time.time() + 0.35
                elif ch == 9:
                    transient["TAB"] = time.time() + 0.35
                elif ch == curses.KEY_LEFT:
                    transient["◄"] = time.time() + 0.35
                elif ch == curses.KEY_UP:
                    transient["▲"] = time.time() + 0.35
                elif ch == curses.KEY_DOWN:
                    transient["▼"] = time.time() + 0.35
                elif ch == curses.KEY_RIGHT:
                    transient["►"] = time.time() + 0.35
                elif curses.KEY_F(1) <= ch <= curses.KEY_F(12):
                    transient[f"F{ch - curses.KEY_F(1) + 1}"] = time.time() + 0.35

            now = time.time()
            if now > next_demo:
                transient[demo_keys[demo_idx % len(demo_keys)]] = now + 0.5
                demo_idx += 1
                next_demo = now + 2.5

            active = set(pressed_labels)
            for k, exp in list(transient.items()):
                if now < exp:
                    active.add(k)
                else:
                    del transient[k]

            # Calculate adaptive layout to fill 96% of module width
            target_w = max(40, min(w - 2, int(w * 0.96)))
            start_x = max(1, (w - target_w) // 2)

            # Height math: 6 rows
            # If h >= 19: 3 lines per row (18 lines total)
            # If h < 19: compact 2 lines per row or 3 lines with top offset
            row_h = 3 if h >= 19 else 2
            total_h = len(ROWS_DEF) * row_h
            start_y = max(0, (h - total_h) // 2)

            for r_idx, row in enumerate(ROWS_DEF):
                row_y = start_y + r_idx * row_h
                if row_y >= h:
                    break

                # Distribute target_w across row
                n = len(row)
                avail_w = target_w - (n - 1)
                tot_u = sum(u for _, _, u in row)
                widths = [max(3, int(avail_w * (u / tot_u))) for _, _, u in row]
                diff = avail_w - sum(widths)
                
                # Distribute remaining width to largest keys
                sorted_idx = sorted(range(n), key=lambda i: row[i][2], reverse=True)
                for i in range(abs(diff)):
                    idx = sorted_idx[i % n]
                    widths[idx] += 1 if diff > 0 else -1

                curr_x = start_x
                for (disp_lbl, key_id, _), k_w in zip(row, widths):
                    is_active = (disp_lbl in active) or (key_id in active)
                    inner_w = k_w - 2

                    if row_h == 3:
                        if is_active:
                            attr = curses.color_pair(3) | curses.A_BOLD
                            top_line = " " * k_w
                            mid_line = disp_lbl.center(k_w)
                            bot_line = " " * k_w
                        else:
                            attr = curses.color_pair(1)
                            top_line = "┌" + ("─" * inner_w) + "┐"
                            mid_line = "│" + disp_lbl.center(inner_w) + "│"
                            bot_line = "└" + ("─" * inner_w) + "┘"

                        safe_addstr(stdscr, row_y, curr_x, top_line, attr)
                        safe_addstr(stdscr, row_y + 1, curr_x, mid_line, attr)
                        safe_addstr(stdscr, row_y + 2, curr_x, bot_line, attr)
                    else: # 2-line compact mode
                        if is_active:
                            attr = curses.color_pair(3) | curses.A_BOLD
                            top_line = disp_lbl.center(k_w)
                            bot_line = " " * k_w
                        else:
                            attr = curses.color_pair(1)
                            top_line = "┌" + disp_lbl.center(inner_w, "─") + "┐"
                            bot_line = "└" + ("─" * inner_w) + "┘"

                        safe_addstr(stdscr, row_y, curr_x, top_line, attr)
                        safe_addstr(stdscr, row_y + 1, curr_x, bot_line, attr)

                    curr_x += k_w + 1

            stdscr.refresh()
            time.sleep(0.05)
        except curses.error:
            pass
        except Exception:
            time.sleep(0.05)

def main():
    curses.wrapper(draw_keyboard)

if __name__ == "__main__":
    main()
