#!/usr/bin/env bash
# ==============================================================================
# KortexOS Smart Application Launcher (kortex-launch)
# Launches user applications directly on the current workspace with audio cue.
# ==============================================================================

set -eu

if [ "$#" -eq 0 ]; then
    echo "Usage: kortex-launch <command> [args...]"
    exit 1
fi

# Play subtle audio feedback
/usr/local/bin/kortex-audio-fx --play win_open >/dev/null 2>&1 &

# Execute target command in background
nohup "$@" >/dev/null 2>&1 &

exit 0
