#!/usr/bin/env python3
"""
KORTEX-PROFILE: Eternal Profile & Portable Archive Engine (.kortex)
Commands:
  export [file.kortex]  : Package master-state.json, themes, wallpapers & plugins into a .kortex archive
  import <file.kortex>  : Import, restore wallpapers & immediately apply a .kortex archive
  reset                 : Reset all customization back to factory defaults
  status                : Display active master-state.json summary and installed plugins
"""

import os
import sys
import json
import shutil
import tarfile
import tempfile
import subprocess
import argparse
import datetime

CONF_DIR = os.path.expanduser("~/.config/kortex")
MASTER_STATE = os.path.join(CONF_DIR, "master-state.json")
CONFIG_JSON = os.path.join(CONF_DIR, "config.json")
PLUGINS_DIR = os.path.join(CONF_DIR, "plugins")
USER_WALL_DIR = os.path.join(CONF_DIR, "wallpapers")
HYPR_DIR = os.path.expanduser("~/.config/hypr")
WAYBAR_DIR = os.path.expanduser("~/.config/waybar")
SKEL_DIR = "/etc/skel/.config"

def ensure_dirs():
    for d in (CONF_DIR, PLUGINS_DIR, USER_WALL_DIR, HYPR_DIR, WAYBAR_DIR):
        os.makedirs(d, exist_ok=True)

def load_master():
    ensure_dirs()
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_master(st):
    ensure_dirs()
    with open(MASTER_STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    with open(CONFIG_JSON, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)

def apply_live(st):
    if os.path.exists("/usr/local/bin/kortex-theme-apply"):
        subprocess.run(["/usr/local/bin/kortex-theme-apply"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    wp = st.get("wallpaper", {})
    desk_p = wp.get("desktop", {}).get("path", "")
    if desk_p and os.path.exists("/usr/local/bin/kortex-wallpaper"):
        subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", desk_p], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    term_wp = wp.get("terminal", {})
    if os.path.exists("/usr/local/bin/kortex-wallpaper"):
        if term_wp.get("image_enabled") and term_wp.get("image_path"):
            subprocess.run(["/usr/local/bin/kortex-wallpaper", "terminal", term_wp["image_path"], str(term_wp.get("dimming", 0.75))], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.run(["/usr/local/bin/kortex-wallpaper", "terminal", "none"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    phil = st.get("interface", {}).get("philosophy", "cyberdeck")
    if os.path.exists("/usr/local/bin/kortex-layout"):
        mode_map = {"cyberdeck": "grid", "macbook": "floating", "tiling": "tiling"}
        subprocess.run(["/usr/local/bin/kortex-layout", mode_map.get(phil, "grid")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def cmd_export(output_path=None):
    st = load_master()
    if not output_path:
        now_str = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        output_path = f"kortex-profile-{now_str}.kortex"

    output_path = os.path.abspath(os.path.expanduser(output_path))
    print(f"[*] Packaging KortexOS Eternal Profile to: {output_path}")

    with tempfile.TemporaryDirectory() as tmp_dir:
        with open(os.path.join(tmp_dir, "master-state.json"), "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        with open(os.path.join(tmp_dir, "config.json"), "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)

        for conf_name in ("theme.lua", "theme.conf", "binds.conf", "hyprpaper.conf"):
            src = os.path.join(HYPR_DIR, conf_name)
            if os.path.exists(src):
                shutil.copy2(src, os.path.join(tmp_dir, conf_name))

        for w_name in ("style.css", "style-dock.css"):
            w_src = os.path.join(WAYBAR_DIR, w_name)
            if os.path.exists(w_src):
                shutil.copy2(w_src, os.path.join(tmp_dir, f"waybar_{w_name}"))

        # Bundle desktop and terminal wallpapers inside archive
        wall_bundle = os.path.join(tmp_dir, "wallpapers")
        os.makedirs(wall_bundle, exist_ok=True)
        wp = st.get("wallpaper", {})
        desk_path = wp.get("desktop", {}).get("path", "")
        if desk_path and os.path.exists(desk_path):
            shutil.copy2(desk_path, os.path.join(wall_bundle, "desktop_" + os.path.basename(desk_path)))
        term_path = wp.get("terminal", {}).get("image_path", "")
        if term_path and os.path.exists(term_path):
            shutil.copy2(term_path, os.path.join(wall_bundle, "terminal_" + os.path.basename(term_path)))

        if os.path.exists(PLUGINS_DIR) and os.listdir(PLUGINS_DIR):
            shutil.copytree(PLUGINS_DIR, os.path.join(tmp_dir, "plugins"), dirs_exist_ok=True)

        with tarfile.open(output_path, "w:gz") as tar:
            for item in os.listdir(tmp_dir):
                tar.add(os.path.join(tmp_dir, item), arcname=item)

    print(f"[+] Successfully exported profile: {output_path} ({os.path.getsize(output_path)} bytes)")

def cmd_import(input_path):
    input_path = os.path.expanduser(input_path)
    if not os.path.exists(input_path):
        print(f"[-] Profile file not found: {input_path}")
        sys.exit(1)

    print(f"[*] Importing profile from: {input_path}")
    ensure_dirs()

    with tempfile.TemporaryDirectory() as tmp_dir:
        try:
            with tarfile.open(input_path, "r:gz") as tar:
                tar.extractall(path=tmp_dir)
        except Exception as e:
            print(f"[-] Corrupt or invalid .kortex profile: {e}")
            sys.exit(1)

        m_src = os.path.join(tmp_dir, "master-state.json")
        c_src = os.path.join(tmp_dir, "config.json")
        target_json = m_src if os.path.exists(m_src) else c_src
        if not os.path.exists(target_json):
            print("[-] Invalid profile: missing master-state.json inside archive")
            sys.exit(1)

        with open(target_json, "r", encoding="utf-8") as f:
            st = json.load(f)

        # Restore bundled wallpapers
        wall_bundle = os.path.join(tmp_dir, "wallpapers")
        if os.path.exists(wall_bundle):
            for wf in os.listdir(wall_bundle):
                src_w = os.path.join(wall_bundle, wf)
                dst_w = os.path.join(USER_WALL_DIR, wf)
                shutil.copy2(src_w, dst_w)
                if wf.startswith("desktop_"):
                    orig_desk = st.get("wallpaper", {}).get("desktop", {}).get("path", "")
                    if not orig_desk or not os.path.exists(orig_desk):
                        st.setdefault("wallpaper", {}).setdefault("desktop", {})["path"] = dst_w
                elif wf.startswith("terminal_"):
                    orig_term = st.get("wallpaper", {}).get("terminal", {}).get("image_path", "")
                    if not orig_term or not os.path.exists(orig_term):
                        st.setdefault("wallpaper", {}).setdefault("terminal", {})["image_path"] = dst_w

        save_master(st)

        for cname in ("theme.lua", "theme.conf", "binds.conf"):
            src = os.path.join(tmp_dir, cname)
            if os.path.exists(src):
                shutil.copy2(src, os.path.join(HYPR_DIR, cname))

        p_src = os.path.join(tmp_dir, "plugins")
        if os.path.exists(p_src):
            shutil.copytree(p_src, PLUGINS_DIR, dirs_exist_ok=True)

    apply_live(st)
    print("[+] Eternal Profile imported and applied across all layers!")

def cmd_reset():
    print("[*] Resetting KortexOS to factory defaults...")
    ensure_dirs()
    if os.path.exists("/usr/local/bin/kortex-theme-apply"):
        subprocess.run(["/usr/local/bin/kortex-theme-apply", "--reset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if os.path.exists("/usr/local/bin/kortex-wallpaper"):
        subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", "grid"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["/usr/local/bin/kortex-wallpaper", "terminal", "none"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("[+] KortexOS customization restored to factory defaults!")

def cmd_status():
    st = load_master()
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})
    phil = st.get("interface", {}).get("philosophy", "cyberdeck")
    wp = st.get("wallpaper", {})
    plugins = [p for p in os.listdir(PLUGINS_DIR) if os.path.isfile(os.path.join(PLUGINS_DIR, p))] if os.path.exists(PLUGINS_DIR) else []

    print("┌────────────────────────────────────────────────────────┐")
    print("│         KORTEX-OS ETERNAL PROFILE SUMMARY              │")
    print("└────────────────────────────────────────────────────────┘")
    print(f"  Master State File  : {MASTER_STATE}")
    print(f"  Desktop Philosophy : [{phil.upper()}]")
    print(f"  Color Theme        : [{th.get('name', 'cyan').upper()}] (Primary: {pal.get('primary_accent', '#00f0ff')})")
    print(f"  Border Mode & Size : {borders.get('mode', 'dual_gradient')} / {borders.get('size', 2)}px / Rounding {borders.get('rounding', 6)}px")
    print(f"  Kawase Blur        : {'Enabled' if glass.get('blur_enabled', True) else 'Disabled'} (Size {glass.get('blur_size', 8)} / {glass.get('blur_passes', 3)} passes)")
    print(f"  Window Opacity     : Active {int(glass.get('opacity_active', 0.95)*100)}% / Inactive {int(glass.get('opacity_inactive', 0.85)*100)}%")
    print(f"  Desktop Wallpaper  : {wp.get('desktop', {}).get('path', 'Default')}")
    print(f"  Installed Plugins  : {len(plugins)} in ~/.config/kortex/plugins/")

def main():
    parser = argparse.ArgumentParser(description="KortexOS Eternal Profile Manager")
    sub = parser.add_subparsers(dest="command")

    exp_p = sub.add_parser("export", help="Export customization & wallpapers to a .kortex archive")
    exp_p.add_argument("file", nargs="?", help="Output .kortex file path")

    imp_p = sub.add_parser("import", help="Import customization & wallpapers from a .kortex archive")
    imp_p.add_argument("file", help="Input .kortex file path")

    sub.add_parser("reset", help="Reset all settings to factory default")
    sub.add_parser("status", help="Show active profile summary")

    args = parser.parse_args()
    if args.command == "export":
        cmd_export(args.file)
    elif args.command == "import":
        cmd_import(args.file)
    elif args.command == "reset":
        cmd_reset()
    else:
        cmd_status()

if __name__ == "__main__":
    main()
