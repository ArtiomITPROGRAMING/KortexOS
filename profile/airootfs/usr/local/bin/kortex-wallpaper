#!/usr/bin/env python3
"""
KORTEX-WALLPAPER: Per-App & Global Wallpaper Engine for KortexOS
Supports Desktop Wallpaper (hyprpaper / swww / pure black / cyber grid)
and Per-App Terminal Wallpaper (Kitty background_image + tint dimming)
"""

import sys
import os
import json
import glob
import subprocess

STATE_FILE = os.path.expanduser("~/.config/kortex/master-state.json")
LEGACY_CONF = os.path.expanduser("~/.config/kortex/config.json")
HYPRPAPER_CONF = os.path.expanduser("~/.config/hypr/hyprpaper.conf")
KITTY_CONF = os.path.expanduser("~/.config/kitty/kitty.conf")
WALLPAPER_DIR = "/usr/share/kortex/wallpapers"

PRESETS = {
    "grid": os.path.join(WALLPAPER_DIR, "cyber_grid.png"),
    "glass": os.path.join(WALLPAPER_DIR, "cyber_glass.png"),
    "black": os.path.join(WALLPAPER_DIR, "pitch_black.png"),
    "default": os.path.join(WALLPAPER_DIR, "cyber_grid.png")
}

def load_master_state():
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    if os.path.exists(LEGACY_CONF):
        try:
            with open(LEGACY_CONF, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_master_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hdir = f"{env['XDG_RUNTIME_DIR']}/hypr"
        if os.path.exists(hdir):
            sigs = os.listdir(hdir)
            if sigs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]
    return env

def apply_desktop_wallpaper(img_path):
    # Resolve preset if shorthand
    if img_path.lower() in PRESETS:
        img_path = PRESETS[img_path.lower()]
    
    if not os.path.exists(img_path):
        # Fallback to black if not found
        img_path = PRESETS["black"]

    # 1. Update hyprpaper.conf
    os.makedirs(os.path.dirname(HYPRPAPER_CONF), exist_ok=True)
    hyprpaper_content = f"""# Auto-generated by Kortex Wallpaper Engine
preload = {img_path}
wallpaper = ,{img_path}
splash = false
ipc = on
"""
    try:
        with open(HYPRPAPER_CONF, "w", encoding="utf-8") as f:
            f.write(hyprpaper_content)
    except Exception as e:
        print(f"[-] Warning: Failed to write hyprpaper.conf: {e}")

    # 2. Live apply via hyprpaper / swww / hyprctl
    env = get_hypr_env()
    
    # Try swww if daemon running
    swww_running = subprocess.run(["pgrep", "-x", "swww-daemon"], capture_output=True).returncode == 0
    if swww_running:
        subprocess.run(["swww", "img", img_path, "--transition-type", "fade", "--transition-step", "90"], env=env, capture_output=True)
    else:
        # Check hyprpaper
        hp_running = subprocess.run(["pgrep", "-x", "hyprpaper"], capture_output=True).returncode == 0
        if hp_running:
            subprocess.run(["hyprctl", "hyprpaper", "preload", img_path], env=env, capture_output=True, timeout=2)
            subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f",{img_path}"], env=env, capture_output=True, timeout=2)
        else:
            # Start hyprpaper in background
            subprocess.Popen(["hyprpaper", "-c", HYPRPAPER_CONF], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 3. Update master state
    st = load_master_state()
    if "wallpaper" not in st:
        st["wallpaper"] = {}
    st["wallpaper"]["desktop"] = {
        "path": img_path,
        "type": "custom" if img_path not in PRESETS.values() else "preset"
    }
    save_master_state(st)
    print(f"[+] Desktop wallpaper applied: {img_path}")

def apply_terminal_wallpaper(img_path, dimming=0.35):
    """
    Sets Kitty terminal background image and dimming (background_tint)
    """
    enable = bool(img_path and img_path.lower() != "none" and os.path.exists(img_path))
    dim_val = max(0.0, min(0.95, float(dimming)))

    os.makedirs(os.path.dirname(KITTY_CONF), exist_ok=True)
    lines = []
    if os.path.exists(KITTY_CONF):
        with open(KITTY_CONF, "r", encoding="utf-8") as f:
            lines = f.readlines()

    # Filter out existing wallpaper keys
    filtered = [l for l in lines if not any(l.strip().startswith(k) for k in [
        "background_image", "background_image_layout", "background_tint"
    ])]

    if enable:
        filtered.append("\n# Kortex Per-App Terminal Wallpaper\n")
        filtered.append(f"background_image {img_path}\n")
        filtered.append("background_image_layout scaled\n")
        filtered.append(f"background_tint {dim_val:.2f}\n")

    with open(KITTY_CONF, "w", encoding="utf-8") as f:
        f.writelines(filtered)

    # Live reload all running kitty instances
    subprocess.run("kill -SIGUSR1 $(pidof kitty) 2>/dev/null || true", shell=True)

    # Update state
    st = load_master_state()
    if "wallpaper" not in st:
        st["wallpaper"] = {}
    st["wallpaper"]["terminal"] = {
        "image_enabled": enable,
        "image_path": img_path if enable else "",
        "dimming": dim_val
    }
    save_master_state(st)
    status_str = f"image: {img_path} (tint: {dim_val:.2f})" if enable else "DISABLED"
    print(f"[+] Kitty terminal wallpaper: {status_str}")

def print_status():
    st = load_master_state()
    wp = st.get("wallpaper", {})
    desk = wp.get("desktop", {}).get("path", "Default Cyber Grid")
    term_wp = wp.get("terminal", {})
    term_img = term_wp.get("image_path", "None") if term_wp.get("image_enabled") else "Disabled"
    dim = term_wp.get("dimming", 0.35)
    print("┌────────────────────────────────────────────────────────┐")
    print("│             KORTEX WALLPAPER ENGINE STATUS             │")
    print("└────────────────────────────────────────────────────────┘")
    print(f"  Desktop Wallpaper  : {desk}")
    print(f"  Terminal Wallpaper : {term_img}")
    print(f"  Terminal Dimming   : {int(dim * 100)}%")
    print(f"  Available Presets  : {', '.join(PRESETS.keys())}")

def main():
    if len(sys.argv) < 2:
        print_status()
        print("\nUsage:")
        print("  kortex-wallpaper desktop <path|grid|glass|black>")
        print("  kortex-wallpaper terminal <path|none> [dimming 0.0-0.95]")
        print("  kortex-wallpaper status")
        sys.exit(0)

    cmd = sys.argv[1].lower()
    if cmd in ("desktop", "desk", "set"):
        target = sys.argv[2] if len(sys.argv) > 2 else "grid"
        apply_desktop_wallpaper(target)
    elif cmd in ("terminal", "term", "kitty"):
        target = sys.argv[2] if len(sys.argv) > 2 else "none"
        dim = float(sys.argv[3]) if len(sys.argv) > 3 else 0.35
        apply_terminal_wallpaper(target, dim)
    elif cmd in ("status", "info"):
        print_status()
    else:
        # Shorthand: treat arg as desktop wallpaper target
        apply_desktop_wallpaper(cmd)

if __name__ == "__main__":
    main()
