#!/usr/bin/env python3
"""
KORTEX-SPOTLIGHT: Instant Unified Center Search, File Finder, Calculator & Action HUD
Triggered via Super + Space (MacBook Spotlight UX on Arch Linux)
Supports:
- Application Launcher (.desktop files)
- Fast File Search (Home directory, Documents, Configs, Backgrounds)
- Built-in Math Calculator (e.g., 42*8, sqrt(256), sin(pi/2))
- Quick Commands: theme cyan, opacity 85, layout mac, wallpaper matrix, etc.
"""

import sys
import os
import re
import math
import glob
import subprocess

def get_apps():
    apps = {}
    dirs = [
        "/usr/share/applications",
        os.path.expanduser("~/.local/share/applications")
    ]
    for d in dirs:
        if not os.path.exists(d):
            continue
        for df in glob.glob(os.path.join(d, "*.desktop")):
            try:
                name = None
                exec_cmd = None
                with open(df, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        if line.startswith("Name=") and not name:
                            name = line.split("=", 1)[1].strip()
                        elif line.startswith("Exec=") and not exec_cmd:
                            exec_cmd = line.split("=", 1)[1].strip().split("%")[0].strip()
                        elif line.startswith("NoDisplay=true"):
                            name = None
                            break
                if name and exec_cmd:
                    apps[f"⚡ App: {name}"] = exec_cmd
            except Exception:
                pass
    return apps

def get_indexed_files(max_files=120):
    files = {}
    search_roots = [
        os.path.expanduser("~"),
        os.path.expanduser("~/.config/kortex"),
        os.path.expanduser("~/.config/hypr"),
        "/usr/share/backgrounds/kortex"
    ]
    count = 0
    for root_dir in search_roots:
        if not os.path.exists(root_dir):
            continue
        for dirpath, dirnames, filenames in os.walk(root_dir):
            # Prune hidden cache/git folders except .config/kortex and .config/hypr
            dirnames[:] = [d for d in dirnames if not d.startswith(".") or d in (".config", "kortex", "hypr")][:8]
            depth = dirpath[len(root_dir):].count(os.sep)
            if depth > 2:
                continue
            for fn in filenames:
                if fn.startswith(".") and fn not in (".bashrc", ".bash_profile"):
                    continue
                full_p = os.path.join(dirpath, fn)
                short_p = full_p.replace(os.path.expanduser("~"), "~")
                files[f"📄 File: {short_p}"] = full_p
                count += 1
                if count >= max_files:
                    return files
    return files

def open_file(filepath):
    ext = os.path.splitext(filepath)[1].lower()
    if ext in (".png", ".jpg", ".jpeg", ".gif", ".webp"):
        subprocess.Popen(["imv", filepath])
    elif ext in (".mp4", ".mkv", ".mp3", ".wav", ".ogg", ".flac"):
        subprocess.Popen(["mpv", filepath])
    else:
        subprocess.Popen(["kitty", "--class", "kortex-files", "-e", "nano", filepath])

def evaluate_math(expr):
    cleaned = expr.strip()
    if not re.match(r'^[0-9\+\-\*\/\%\^\(\)\.\s\,a-zA-Z]+$', cleaned):
        return None
    if cleaned.isalpha():
        return None
    safe_dict = {
        "sin": math.sin, "cos": math.cos, "tan": math.tan,
        "sqrt": math.sqrt, "log": math.log, "log10": math.log10,
        "pi": math.pi, "e": math.e, "pow": math.pow, "abs": abs,
        "round": round
    }
    try:
        py_expr = cleaned.replace("^", "**")
        val = eval(py_expr, {"__builtins__": None}, safe_dict)
        if isinstance(val, (int, float)):
            return str(val)
        return None
    except Exception:
        return None

def notify(title, msg):
    try:
        subprocess.run(["notify-send", "-a", "KORTEX SPOTLIGHT", "-t", "3000", title, msg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def copy_clipboard(text):
    try:
        p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass

def main():
    apps = get_apps()
    files = get_indexed_files()

    commands = {
        "🎛️ Control Center: Volume, Brightness, Wi-Fi, BT & DND": "/usr/local/bin/kortex-control-center",
        "💬 KortexGram: E2EE Cyberpunk Messenger": "/usr/local/bin/kortex-gram",
        "🎵 Music: Cyberdeck Audio & Synthwave Radio": "/usr/local/bin/kortex-open music",
        "📖 System Tour & Guide: Interactive Navigator": "/usr/local/bin/kortex-open tour",
        "🏪 Store: Kortex App Hub (Software Center)": "/usr/local/bin/kortex-open store",
        "⚙️ Settings: Kortex Theme Studio Pro": "/usr/local/bin/kortex-settings",
        "🧭 OOBE: Run Initial Setup Wizard": "kitty --class kortex-oobe --title 'KORTEX-OS SETUP' -e /usr/local/bin/kortex-oobe --force",
        "🎨 Theme: Cyber Cyan (Neon Blue)": "/usr/local/bin/kortex-theme-apply --theme cyan",
        "🎨 Theme: Tokyo Night (Indigo & Lavender)": "/usr/local/bin/kortex-theme-apply --theme tokyonight",
        "🎨 Theme: Dracula (Gothic Violet & Pink)": "/usr/local/bin/kortex-theme-apply --theme dracula",
        "🎨 Theme: Matrix (Phosphor Green)": "/usr/local/bin/kortex-theme-apply --theme matrix",
        "🎨 Theme: Amber CRT (Vintage 80s)": "/usr/local/bin/kortex-theme-apply --theme amber",
        "🎨 Theme: Mono Tron (Minimalist White)": "/usr/local/bin/kortex-theme-apply --theme mono",
        "🎨 Theme: Crimson (Red Combat HUD)": "/usr/local/bin/kortex-theme-apply --theme crimson",
        "🖥️ Layout: MacBook Pro Mode (Glass & Dock)": "/usr/local/bin/kortex-layout floating",
        "🖥️ Layout: Cyber-Deck (eDEX 5-Panel Grid)": "/usr/local/bin/kortex-layout grid",
        "🖥️ Layout: Pure Tiling (Pro Developer)": "/usr/local/bin/kortex-layout tiling",
        "🖼️ Wallpaper: Cyber Grid (Vector Tron)": "/usr/local/bin/kortex-wallpaper desktop grid",
        "🖼️ Wallpaper: Cyber Glass (MacBook Mesh)": "/usr/local/bin/kortex-wallpaper desktop glass",
        "🖼️ Wallpaper: Matrix Rain (Phosphor Code)": "/usr/local/bin/kortex-wallpaper desktop matrix",
        "🖼️ Wallpaper: Tokyo Horizon (Synthwave)": "/usr/local/bin/kortex-wallpaper desktop tokyo",
        "🖼️ Wallpaper: Pitch Black (OLED #000000)": "/usr/local/bin/kortex-wallpaper desktop black",
        "💻 Terminal Wallpaper: Tron Grid": "/usr/local/bin/kortex-wallpaper terminal tron 0.75",
        "💻 Terminal Wallpaper: Matrix Bitgrid": "/usr/local/bin/kortex-wallpaper terminal matrix 0.75",
        "💻 Terminal Wallpaper: Dark Carbon": "/usr/local/bin/kortex-wallpaper terminal carbon 0.75",
        "💻 Terminal Wallpaper: Disable": "/usr/local/bin/kortex-wallpaper terminal none",
        "⌨️ Cheatsheet: System Hotkeys (HUD)": "/usr/local/bin/kortex-help-hud",
        "🔒 System: Lock Screen": "/usr/local/bin/kortex-open lock",
        "🔄 System: Reboot": "systemctl reboot",
        "🛑 System: Power Off": "systemctl poweroff"
    }

    candidates = list(commands.keys()) + sorted(list(apps.keys())) + sorted(list(files.keys()))
    prompt_text = "\n".join(candidates)

    rofi_theme = """
    * { font: "JetBrainsMono Nerd Font 12"; }
    window {
        width: 720px;
        border-radius: 14px;
        border: 2px;
        border-color: #00f0ff;
        background-color: rgba(10, 12, 16, 0.92);
        padding: 12px;
        location: center;
        anchor: center;
    }
    mainbox { background-color: transparent; spacing: 10px; }
    inputbar {
        background-color: rgba(18, 22, 31, 0.88);
        border-radius: 10px;
        padding: 10px 14px;
        children: [ prompt, entry ];
    }
    prompt { text-color: #00f0ff; font-weight: bold; margin: 0 8px 0 0; }
    entry {
        text-color: #ffffff;
        placeholder: "Apps, files, math (42*8), theme cyan, opacity 85, layout mac...";
        placeholder-color: #6e7681;
    }
    listview { lines: 9; background-color: transparent; spacing: 4px; }
    element { border-radius: 8px; padding: 8px 12px; background-color: transparent; text-color: #c9d1d9; }
    element selected {
        background-color: rgba(0, 240, 255, 0.20);
        text-color: #00f0ff;
        border: 1px;
        border-color: #00f0ff;
    }
    """

    res = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "🔍 SPOTLIGHT", "-theme-str", rofi_theme],
        input=prompt_text,
        capture_output=True,
        text=True
    )

    choice = res.stdout.strip()
    if not choice:
        sys.exit(0)

    if choice in commands:
        subprocess.Popen(commands[choice], shell=True)
        sys.exit(0)

    if choice in apps:
        subprocess.Popen(apps[choice], shell=True)
        sys.exit(0)

    if choice in files:
        open_file(files[choice])
        sys.exit(0)

    math_val = evaluate_math(choice)
    if math_val is not None:
        copy_clipboard(math_val)
        notify("Calculator Result (Copied)", f"{choice} = {math_val}")
        print(f"{choice} = {math_val}")
        sys.exit(0)

    lower = choice.lower().strip()
    if lower in ("music", "player", "radio", "song", "play"):
        subprocess.Popen("/usr/local/bin/kortex-open music", shell=True)
        sys.exit(0)

    if lower in ("tour", "guide", "welcome", "help", "gid", "spravka"):
        subprocess.Popen("/usr/local/bin/kortex-open tour", shell=True)
        sys.exit(0)

    if lower.startswith("theme "):
        t_name = lower.split(" ", 1)[1].strip()
        subprocess.run(["/usr/local/bin/kortex-theme-apply", "--theme", t_name])
        notify("Kortex Theme", f"Applied theme: {t_name.upper()}")
        sys.exit(0)

    if lower.startswith("layout "):
        l_name = lower.split(" ", 1)[1].strip()
        if l_name in ("mac", "macbook", "floating", "float", "classic"):
            subprocess.run(["/usr/local/bin/kortex-layout", "floating"])
        elif l_name in ("grid", "cyber", "cyberdeck"):
            subprocess.run(["/usr/local/bin/kortex-layout", "grid"])
        elif l_name in ("tiling", "tile", "dev"):
            subprocess.run(["/usr/local/bin/kortex-layout", "tiling"])
        notify("Kortex Layout", f"Switched layout: {l_name.upper()}")
        sys.exit(0)

    if lower.startswith("wallpaper "):
        w_target = choice.split(" ", 1)[1].strip()
        subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", w_target])
        notify("Kortex Wallpaper", f"Updated desktop wallpaper: {w_target}")
        sys.exit(0)

    if lower.startswith("opacity "):
        op_val = lower.split(" ", 1)[1].strip()
        subprocess.run(["/usr/local/bin/kortex-theme-apply", "--opacity", op_val])
        notify("Kortex Glass", f"Window opacity set to: {op_val}")
        sys.exit(0)

    if os.path.exists(os.path.expanduser(choice)):
        open_file(os.path.expanduser(choice))
        sys.exit(0)

    subprocess.Popen(choice, shell=True)

if __name__ == "__main__":
    main()
