def run_bg(cmd):
    try:
        subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def mark_tour_done():
    os.makedirs(CONF_DIR, exist_ok=True)
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            f.write("done\n")
    except Exception:
        pass

def draw_tour(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)
    curses.use_default_colors()

    # Define color pairs if possible
    has_colors = curses.has_colors()
    if has_colors:
        curses.start_color()
        curses.init_pair(1, curses.COLOR_CYAN, -1)     # Accent / cyan
        curses.init_pair(2, curses.COLOR_GREEN, -1)    # Success / actions
        curses.init_pair(3, curses.COLOR_YELLOW, -1)   # Highlights / tips
        curses.init_pair(4, curses.COLOR_MAGENTA, -1)  # Headers
        curses.init_pair(5, curses.COLOR_BLACK, curses.COLOR_CYAN) # Active tab
        curses.init_pair(6, curses.COLOR_RED, -1)      # Alert / close

    current_step = 0
    total_steps = len(STEPS)

    while True:
        stdscr.clear()
        max_y, max_x = stdscr.getmaxyx()

        if max_y < 24 or max_x < 75:
            stdscr.addstr(0, 0, "Окно слишком мало. Пожалуйста, увеличьте размер окна терминала.", curses.A_BOLD)
            stdscr.refresh()
            ch = stdscr.getch()
            if ch in (ord('q'), ord('Q'), 27):
                break
            continue

        # Header ASCII banner
        banner_top = "  ███████╗ ██████╗ ██████╗ ████████╗███████╗██╗  ██╗    ████████╗ ██████╗ ██╗   ██╗██████╗ "
        banner_bot = "  ██╔════╝██╔═══██╗██╔══██╗╚══██╔══╝██╔════╝╚██╗██╔╝    ╚══██╔══╝██╔═══██╗██║   ██║██╔══██╗"
        tagline    = "  >> KORTEX OS :: ИНТЕРАКТИВНЫЙ ПРОВОДНИК И ТУР ПО СИСТЕМЕ (v1.0.0) <<"

        try:
            if has_colors:
                stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
            stdscr.addstr(1, max(0, (max_x - len(banner_top)) // 2), banner_top[:max_x-1])
            stdscr.addstr(2, max(0, (max_x - len(banner_bot)) // 2), banner_bot[:max_x-1])
            stdscr.addstr(3, max(0, (max_x - len(tagline)) // 2), tagline[:max_x-1])
            if has_colors:
                stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
        except curses.error:
            pass

        # Navigation Tabs
        tab_y = 5
        tab_str = " "
        try:
            curr_x = 2
            for i, st in enumerate(STEPS):
                name = f" {st['short']} "
                if i == current_step:
                    if has_colors:
                        stdscr.attron(curses.color_pair(5) | curses.A_BOLD)
                    stdscr.addstr(tab_y, curr_x, name)
                    if has_colors:
                        stdscr.attroff(curses.color_pair(5) | curses.A_BOLD)
                else:
                    if has_colors:
                        stdscr.attron(curses.A_DIM)
                    stdscr.addstr(tab_y, curr_x, name)
                    if has_colors:
                        stdscr.attroff(curses.A_DIM)
                curr_x += len(name) + 2
        except curses.error:
            pass

        # Horizontal Divider
        try:
            stdscr.addstr(6, 1, "─" * (max_x - 2))
        except curses.error:
            pass

        # Step Content Card
        step_data = STEPS[current_step]
        content_y = 8

        for item_type, text in step_data["content"]:
            if content_y >= max_y - 4:
                break
            try:
                if item_type == "title":
                    if has_colors:
                        stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
                    stdscr.addstr(content_y, 4, text[:max_x-6])
                    if has_colors:
                        stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
                    content_y += 2
                elif item_type == "bullet":
                    if has_colors:
                        stdscr.attron(curses.color_pair(3) | curses.A_BOLD)
                    stdscr.addstr(content_y, 4, text[:max_x-6])
                    if has_colors:
                        stdscr.attroff(curses.color_pair(3) | curses.A_BOLD)
                    content_y += 1
                elif item_type == "text":
                    stdscr.addstr(content_y, 6, text[:max_x-8])
                    content_y += 1
                elif item_type == "action":
                    if has_colors:
                        stdscr.attron(curses.color_pair(2) | curses.A_BOLD)
                    stdscr.addstr(content_y, 6, f"▶  {text[:max_x-10]}")
                    if has_colors:
                        stdscr.attroff(curses.color_pair(2) | curses.A_BOLD)
                    content_y += 1
                elif item_type == "tip":
                    if has_colors:
                        stdscr.attron(curses.color_pair(3))
                    stdscr.addstr(content_y, 4, text[:max_x-6])
                    if has_colors:
                        stdscr.attroff(curses.color_pair(3))
                    content_y += 1
                elif item_type == "blank":
                    content_y += 1
            except curses.error:
                pass

        # Footer Bar with Controls
        footer_y = max_y - 2
        try:
            stdscr.addstr(max_y - 3, 1, "─" * (max_x - 2))
            footer_text = f" [◄ Назад]  [Далее ►]  [1-6: Вкладки]  [G/M/T: Режимы]  [S: Поиск]  [C: Настройки]  [Q: Завершить] ({current_step+1}/{total_steps})"
            if has_colors:
                stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
            stdscr.addstr(footer_y, max(1, (max_x - len(footer_text)) // 2), footer_text[:max_x-2])
            if has_colors:
                stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)
        except curses.error:
            pass

        stdscr.refresh()

        # Handle User Input
        key = stdscr.getch()

        if key in (curses.KEY_RIGHT, ord(' '), ord('n'), ord('N'), curses.KEY_DOWN):
            if current_step < total_steps - 1:
                current_step += 1
            else:
                mark_tour_done()
                break
        elif key in (curses.KEY_LEFT, ord('p'), ord('P'), curses.KEY_UP):
            if current_step > 0:
                current_step -= 1
        elif ord('1') <= key <= ord('6'):
            current_step = key - ord('1')
        elif key in (ord('q'), ord('Q'), 27):
            mark_tour_done()
            break
        elif key in (curses.KEY_ENTER, 10, 13):
            if current_step == total_steps - 1:
                mark_tour_done()
                break
            else:
                current_step += 1
        # Interactive Live Actions:
        elif key in (ord('g'), ord('G')):
            run_bg("/usr/local/bin/kortex-layout grid")
        elif key in (ord('m'), ord('M')):
            run_bg("/usr/local/bin/kortex-layout floating")
        elif key in (ord('t'), ord('T')):
            run_bg("/usr/local/bin/kortex-layout tiling")
        elif key in (ord('s'), ord('S')):
            run_bg("/usr/local/bin/kortex-spotlight")
        elif key in (ord('c'), ord('C')):
            run_bg("/usr/local/bin/kortex-open settings")
        elif key in (ord('w'), ord('W')):
            run_bg("/usr/local/bin/kortex-wallpaper desktop")
        elif key in (ord('i'), ord('I')):
            mark_tour_done()
            curses.endwin()
            os.system("/usr/local/bin/kortex-install")
            break

def main():
    # If headless / no terminal, gracefully exit
    if not sys.stdin.isatty():
        print("[*] Kortex Tour requires an interactive terminal.")
        sys.exit(0)

    try:
        curses.wrapper(draw_tour)
    except KeyboardInterrupt:
        pass
    finally:
        mark_tour_done()
        print("\n[+] Тур завершен! Добро пожаловать в KortexOS.")
        print("[*] Вы всегда можете снова открыть этот гид командой 'kortex-tour' или через [ ? GUIDE ] в панели.")

if __name__ == "__main__":
    main()
