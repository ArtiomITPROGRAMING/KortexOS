#!/usr/bin/env python3
"""
Kortex Vault: System Snapshots & Encrypted Project Container Manager (kortex-vault)
Provides 1-click config/system snapshot creation & rollback, and an encrypted LUKS
crypto-vault container for confidential data.
"""

import os
import sys
import time
import curses
import subprocess
import glob
import getpass

USER_VAULT_DIR = os.path.expanduser("~/.local/share/kortex/vault")
SNAPSHOT_DIR = os.path.join(USER_VAULT_DIR, "snapshots")
VAULT_CONTAINER = os.path.join(USER_VAULT_DIR, "vault.img")
VAULT_MOUNT = os.path.expanduser("~/Vault")
VAULT_NAME = "kortex_vault"

def get_snapshots():
    os.makedirs(SNAPSHOT_DIR, exist_ok=True)
    files = glob.glob(f"{SNAPSHOT_DIR}/*.tar.zst")
    files.sort(reverse=True)
    snaps = []
    for f in files:
        name = os.path.basename(f)
        size_mb = os.path.getsize(f) / (1024 * 1024)
        mtime = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(os.path.getmtime(f)))
        snaps.append((name, size_mb, mtime, f))
    return snaps

def create_snapshot(desc="manual"):
    os.makedirs(SNAPSHOT_DIR, exist_ok=True)
    ts = time.strftime("%Y%m%d_%H%M%S")
    out_tar = f"{SNAPSHOT_DIR}/kortex_snap_{ts}_{desc}.tar.zst"
    
    # Check if btrfs subvolume exists
    try:
        res = subprocess.run(["btrfs", "subvolume", "show", "/"], capture_output=True, text=True)
        if res.returncode == 0:
            btrfs_dir = "/.snapshots"
            os.makedirs(btrfs_dir, exist_ok=True)
            subprocess.run(["btrfs", "subvolume", "snapshot", "-r", "/", f"{btrfs_dir}/snap_{ts}"], stdout=subprocess.DEVNULL)
    except Exception:
        pass

    # Collect config paths
    paths = [
        "/etc/kortex",
        os.path.expanduser("~/.config/hypr"),
        os.path.expanduser("~/.config/waybar"),
        os.path.expanduser("~/.config/kitty"),
        "/usr/local/bin/kortex*",
        "/etc/systemd/system/kortex*"
    ]
    valid_paths = []
    for p in paths:
        matched = glob.glob(p)
        valid_paths.extend(matched)

    if valid_paths:
        cmd = ["tar", "--zstd", "-cf", out_tar] + valid_paths
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True, out_tar
    return False, "No valid paths found"

def rollback_snapshot(snap_path):
    if not os.path.exists(snap_path):
        return False, "Snapshot not found"
    try:
        subprocess.run(["tar", "--zstd", "-xf", snap_path, "-C", "/"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Reload hyprland
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True, "Snapshot restored successfully"
    except Exception as e:
        return False, str(e)

def is_vault_open():
    return os.path.exists(f"/dev/mapper/{VAULT_NAME}") and os.path.ismount(VAULT_MOUNT)

def open_vault(passphrase):
    if is_vault_open():
        return True, "Vault already mounted"
    if not os.path.exists(VAULT_CONTAINER):
        return False, "Vault container does not exist. Press [N] to create one."
    
    os.makedirs(VAULT_MOUNT, exist_ok=True)
    try:
        p1 = subprocess.run(
            ["sudo", "cryptsetup", "open", VAULT_CONTAINER, VAULT_NAME],
            input=f"{passphrase}\n",
            capture_output=True,
            text=True
        )
        if p1.returncode != 0:
            return False, "Invalid passphrase or cryptsetup error"

        p2 = subprocess.run(
            ["sudo", "mount", f"/dev/mapper/{VAULT_NAME}", VAULT_MOUNT],
            capture_output=True,
            text=True
        )
        if p2.returncode != 0:
            subprocess.run(["sudo", "cryptsetup", "close", VAULT_NAME], stdout=subprocess.DEVNULL)
            return False, "Failed to mount filesystem"

        # Chown to user
        u = getpass.getuser()
        subprocess.run(["sudo", "chown", "-R", f"{u}:{u}", VAULT_MOUNT], stdout=subprocess.DEVNULL)
        subprocess.run(["kortex-audio-fx", "--play", "granted"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True, f"Vault unlocked at {VAULT_MOUNT}"
    except Exception as e:
        return False, str(e)

def lock_vault():
    if not is_vault_open() and not os.path.exists(f"/dev/mapper/{VAULT_NAME}"):
        return True, "Vault already locked"
    try:
        subprocess.run(["sync"])
        subprocess.run(["sudo", "umount", "-f", VAULT_MOUNT], stdout=subprocess.DEVNULL)
        subprocess.run(["sudo", "cryptsetup", "close", VAULT_NAME], stdout=subprocess.DEVNULL)
        subprocess.run(["kortex-audio-fx", "--play", "alert"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True, "Vault locked and secured"
    except Exception as e:
        return False, str(e)

def create_vault_container(passphrase, size_mb=512):
    os.makedirs(os.path.dirname(VAULT_CONTAINER), exist_ok=True)
    try:
        # Allocate container file
        subprocess.run(["sudo", "fallocate", "-l", f"{size_mb}M", VAULT_CONTAINER], check=True)
        # Format LUKS
        p = subprocess.run(
            ["sudo", "cryptsetup", "luksFormat", "--batch-mode", VAULT_CONTAINER],
            input=f"{passphrase}\n",
            capture_output=True,
            text=True
        )
        if p.returncode != 0:
            return False, "Failed to format LUKS container"
        
        # Open and mkfs.ext4
        p_open = subprocess.run(
            ["sudo", "cryptsetup", "open", VAULT_CONTAINER, VAULT_NAME],
            input=f"{passphrase}\n",
            capture_output=True,
            text=True
        )
        if p_open.returncode != 0:
            return False, "Failed to open new container"

        subprocess.run(["sudo", "mkfs.ext4", "-q", f"/dev/mapper/{VAULT_NAME}"], check=True)
        subprocess.run(["sudo", "cryptsetup", "close", VAULT_NAME], check=True)
        return True, f"Encrypted Vault created ({size_mb}MB)"
    except Exception as e:
        return False, str(e)

def safe_addstr(win, y, x, text, attr=0):
    max_y, max_x = win.getmaxyx()
    if 0 <= y < max_y and 0 <= x < max_x:
        try:
            win.addstr(y, x, text[:max_x - x - 1], attr)
        except curses.error:
            pass

def tui_main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(500)

    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)
    curses.init_pair(3, curses.COLOR_CYAN, -1)
    curses.init_pair(4, curses.COLOR_GREEN, -1)
    curses.init_pair(5, curses.COLOR_RED, -1)

    active_tab = 0 # 0: Snapshots, 1: Crypto Vault
    selected_idx = 0
    status_msg = "Vault & Snapshot Sentinel Ready"
    status_color = 1

    while True:
        h, w = stdscr.getmaxyx()
        stdscr.erase()

        # Border
        safe_addstr(stdscr, 0, 0, "┌" + "─" * (w - 2) + "┐", curses.color_pair(1))
        for y in range(1, h - 1):
            safe_addstr(stdscr, y, 0, "│", curses.color_pair(1))
            safe_addstr(stdscr, y, w - 1, "│", curses.color_pair(1))
        safe_addstr(stdscr, h - 1, 0, "└" + "─" * (w - 2) + "┘", curses.color_pair(1))

        # Title
        title = " [ KORTEX-VAULT // SNAPSHOT MANAGER & CRYPTO CONTAINER ] "
        safe_addstr(stdscr, 0, max(2, (w - len(title)) // 2), title, curses.color_pair(2))

        # Tabs
        tab0_attr = curses.color_pair(2) if active_tab == 0 else curses.color_pair(1)
        tab1_attr = curses.color_pair(2) if active_tab == 1 else curses.color_pair(1)
        safe_addstr(stdscr, 2, 4, " [1] SYSTEM SNAPSHOTS ", tab0_attr)
        safe_addstr(stdscr, 2, 28, " [2] ENCRYPTED PROJECT VAULT ", tab1_attr)

        if active_tab == 0:
            # Snapshots Tab
            snaps = get_snapshots()
            safe_addstr(stdscr, 4, 4, "NAME                                SIZE      CREATED AT", curses.color_pair(3))
            safe_addstr(stdscr, 5, 4, "─" * min(68, w - 8), curses.color_pair(1))

            if not snaps:
                safe_addstr(stdscr, 7, 6, "No snapshots found. Press [C] to create your first snapshot.", curses.A_DIM | curses.color_pair(1))
            else:
                for i, (s_name, s_size, s_time, _) in enumerate(snaps[:h - 12]):
                    attr = curses.color_pair(2) if i == selected_idx else curses.color_pair(1)
                    line = f"{s_name:<34}  {s_size:5.1f}MB  {s_time}"
                    safe_addstr(stdscr, 6 + i, 4, line, attr)

            # Snapshots controls
            btn_y = h - 4
            safe_addstr(stdscr, btn_y, 4, "[C] Create Snapshot   [R] Rollback Selected   [D] Delete   [TAB] Switch Tab", curses.color_pair(1) | curses.A_BOLD)

        else:
            # Crypto Vault Tab
            vault_open = is_vault_open()
            safe_addstr(stdscr, 4, 4, "ENCRYPTED VAULT CONTAINER STATUS:", curses.color_pair(3))
            
            st_text = " [ UNLOCKED & MOUNTED AT ~/Vault ] " if vault_open else " [ LOCKED // SECURE ] "
            st_pair = curses.color_pair(4) if vault_open else curses.color_pair(5)
            safe_addstr(stdscr, 6, 6, f"STATUS       : {st_text}", st_pair | curses.A_BOLD)
            safe_addstr(stdscr, 8, 6, f"CONTAINER    : {VAULT_CONTAINER}", curses.color_pair(1))
            safe_addstr(stdscr, 9, 6, f"MOUNT POINT  : {VAULT_MOUNT}", curses.color_pair(1))
            safe_addstr(stdscr, 10, 6, "ENCRYPTION   : AES-XTS-PLAIN64 512-BIT (LUKS2)", curses.color_pair(1))

            exists = os.path.exists(VAULT_CONTAINER)
            safe_addstr(stdscr, 11, 6, f"IMAGE FILE   : {'EXISTS' if exists else 'NOT INITIALIZED'}", curses.color_pair(4 if exists else 5))

            v_btn_y = h - 4
            if vault_open:
                safe_addstr(stdscr, v_btn_y, 4, "[L] Lock & Unmount Vault    [TAB] Switch Tab    [Q] Exit", curses.color_pair(1) | curses.A_BOLD)
            else:
                safe_addstr(stdscr, v_btn_y, 4, "[O] Unlock & Mount Vault    [N] Create New Vault    [TAB] Switch Tab    [Q] Exit", curses.color_pair(1) | curses.A_BOLD)

        # Bottom Status Message
        safe_addstr(stdscr, h - 2, 4, f">> {status_msg}", curses.color_pair(status_color))

        stdscr.refresh()

        try:
            ch = stdscr.getch()
            if ch in (ord('q'), ord('Q'), 27):
                break
            elif ch in (ord('\t'), curses.KEY_BTAB):
                active_tab = 1 if active_tab == 0 else 0
                selected_idx = 0
            elif ch == ord('1'):
                active_tab = 0
            elif ch == ord('2'):
                active_tab = 1
            elif active_tab == 0:
                snaps = get_snapshots()
                if ch in (curses.KEY_UP, ord('k')) and selected_idx > 0:
                    selected_idx -= 1
                elif ch in (curses.KEY_DOWN, ord('j')) and selected_idx < len(snaps) - 1:
                    selected_idx += 1
                elif ch in (ord('c'), ord('C')):
                    status_msg = "Creating snapshot archive..."
                    stdscr.refresh()
                    ok, res = create_snapshot()
                    status_msg = f"Snapshot created: {os.path.basename(res)}" if ok else f"Error: {res}"
                    status_color = 4 if ok else 5
                elif ch in (ord('r'), ord('R')) and snaps:
                    snap_file = snaps[selected_idx][3]
                    status_msg = f"Restoring {snaps[selected_idx][0]}..."
                    stdscr.refresh()
                    ok, res = rollback_snapshot(snap_file)
                    status_msg = res
                    status_color = 4 if ok else 5
                elif ch in (ord('d'), ord('D')) and snaps:
                    snap_file = snaps[selected_idx][3]
                    try:
                        os.remove(snap_file)
                        status_msg = f"Deleted {snaps[selected_idx][0]}"
                        status_color = 1
                        selected_idx = max(0, selected_idx - 1)
                    except Exception as e:
                        status_msg = f"Failed to delete: {e}"
                        status_color = 5
            elif active_tab == 1:
                if ch in (ord('o'), ord('O')) and not is_vault_open():
                    curses.echo()
                    curses.curs_set(1)
                    safe_addstr(stdscr, h - 2, 4, "Enter Vault Passphrase: " + " " * 30, curses.color_pair(3))
                    stdscr.refresh()
                    passphrase = stdscr.getstr(h - 2, 28, 64).decode("utf-8")
                    curses.noecho()
                    curses.curs_set(0)
                    if passphrase:
                        status_msg = "Unlocking container..."
                        stdscr.refresh()
                        ok, res = open_vault(passphrase)
                        status_msg = res
                        status_color = 4 if ok else 5
                elif ch in (ord('l'), ord('L')) and is_vault_open():
                    status_msg = "Locking container..."
                    stdscr.refresh()
                    ok, res = lock_vault()
                    status_msg = res
                    status_color = 4 if ok else 5
                elif ch in (ord('n'), ord('N')) and not os.path.exists(VAULT_CONTAINER):
                    curses.echo()
                    curses.curs_set(1)
                    safe_addstr(stdscr, h - 2, 4, "Set New Vault Passphrase: " + " " * 30, curses.color_pair(3))
                    stdscr.refresh()
                    passphrase = stdscr.getstr(h - 2, 30, 64).decode("utf-8")
                    curses.noecho()
                    curses.curs_set(0)
                    if passphrase:
                        status_msg = "Formatting new 512MB LUKS encrypted container..."
                        stdscr.refresh()
                        ok, res = create_vault_container(passphrase, 512)
                        status_msg = res
                        status_color = 4 if ok else 5
        except KeyboardInterrupt:
            break

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("--snapshot", "-s"):
            desc = sys.argv[2] if len(sys.argv) > 2 else "manual"
            ok, res = create_snapshot(desc)
            print(f"[+] Snapshot created: {res}" if ok else f"[-] Snapshot failed: {res}")
            return
        elif arg in ("--list", "-l"):
            snaps = get_snapshots()
            print(f"KortexOS Snapshots in {SNAPSHOT_DIR}:")
            for s_name, s_size, s_time, _ in snaps:
                print(f"  • {s_name:<34} {s_size:5.1f}MB  ({s_time})")
            return
        elif arg == "--open" and len(sys.argv) > 2:
            ok, res = open_vault(sys.argv[2])
            print(f"[{'+' if ok else '-'}] {res}")
            return
        elif arg == "--lock":
            ok, res = lock_vault()
            print(f"[{'+' if ok else '-'}] {res}")
            return
        elif arg in ("--status", "-st"):
            st = "OPEN" if is_vault_open() else "LOCKED"
            print(f"Vault: {st} | Container: {VAULT_CONTAINER} | Mount: {VAULT_MOUNT}")
            return

    os.environ.setdefault("TERM", "xterm-256color")
    try:
        curses.wrapper(tui_main)
    except Exception as e:
        print(f"[-] Kortex Vault error: {e}")

if __name__ == "__main__":
    main()
