#!/usr/bin/env python3
"""
KORTEX-SETTINGS: Упрощённое окно «Настройки» в один экран
Поддерживает управление мышью и клавиатурой (↑/↓, ←/→, Enter, Пробел, 1-6):
1. Цветовая тема (Cyber Cyan, Tokyo Night, Dracula, Matrix, Mono)
2. Обои рабочего стола (Cyber Glass, Tokyo Horizon, Cyber Grid, Matrix, Pitch Black)
3. Эффект матового стекла / прозрачности (Вкл / Выкл)
4. Язык и раскладка клавиатуры (EN + RU (Alt+Shift), EN + RO, DE)
5. Wi-Fi и Звук (/usr/local/bin/kortex-control-center / nmtui)
6. Установка KortexOS на жёсткий диск (/usr/local/bin/kortex-open install)
"""

import os
import sys
import json
import curses
import subprocess
import shutil

CONF_DIR = os.path.expanduser("~/.config/kortex")
MASTER_STATE = os.path.join(CONF_DIR, "master-state.json")
LEGACY_STATE = os.path.join(CONF_DIR, "config.json")

THEME_PRESETS = [
    ("cyan",       "Cyber Cyan"),
    ("tokyonight", "Tokyo Night"),
    ("dracula",    "Dracula"),
    ("matrix",     "Matrix"),
    ("mono",       "Mono"),
]

DESKTOP_WALLS = [
    ("glass",  "Cyber Glass",   "/usr/share/backgrounds/kortex/cyber_glass.png"),
    ("tokyo",  "Tokyo Horizon", "/usr/share/backgrounds/kortex/tokyo_horizon.png"),
    ("grid",   "Cyber Grid",    "/usr/share/backgrounds/kortex/cyber_grid.png"),
    ("matrix", "Matrix",        "/usr/share/backgrounds/kortex/matrix_rain.png"),
    ("black",  "Pitch Black",   "/usr/share/backgrounds/kortex/pitch_black.png"),
]

KB_LAYOUTS = [
    ("us,ru", "EN + RU (Alt+Shift)", "grp:alt_shift_toggle"),
    ("us,ro", "EN + RO",             "grp:alt_shift_toggle"),
    ("de",    "DE",                  "grp:alt_shift_toggle"),
]

def load_state():
    os.makedirs(CONF_DIR, exist_ok=True)
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    subprocess.run(["/usr/local/bin/kortex-theme-apply"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_state(st):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(MASTER_STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    with open(LEGACY_STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)

def trigger_theme_apply(extra_args=None):
    cmd = ["/usr/local/bin/kortex-theme-apply"]
    if extra_args:
        cmd.extend(extra_args)
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
    except Exception:
        pass

def get_theme_label(st):
    cur = st.get("theme", {}).get("name", "cyan")
    for k, label in THEME_PRESETS:
        if k == cur:
            return label
    return "Cyber Cyan"

def get_wallpaper_label(st):
    path = st.get("wallpaper", {}).get("desktop", {}).get("path", "/usr/share/backgrounds/kortex/cyber_glass.png")
    bname = os.path.basename(path)
    for _, label, fpath in DESKTOP_WALLS:
        if os.path.basename(fpath) == bname:
            return label
    return "Cyber Glass"

def get_glass_enabled(st):
    return bool(st.get("theme", {}).get("glass", {}).get("blur_enabled", True))

def get_kb_label(st):
    cur_kb = st.get("system", {}).get("kb_layout", "us,ru")
    for k, label, _ in KB_LAYOUTS:
        if k == cur_kb:
            return label
    return "EN + RU (Alt+Shift)"

def safe_addstr(win, y, x, s, attr=curses.A_NORMAL):
    h, w = win.getmaxyx()
    if 0 <= y < h and 0 <= x < w:
        try:
            win.addstr(y, x, s[:max(1, w - x - 1)], attr)
        except curses.error:
            pass

def settings_tui(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(False)
    stdscr.keypad(True)
    try:
        curses.mouseinterval(0)
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
    except Exception:
        pass

    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(3, curses.COLOR_CYAN, -1)
    curses.init_pair(4, curses.COLOR_GREEN, -1)
    curses.init_pair(5, curses.COLOR_YELLOW, -1)

    cur_row = 0
    row_y_map = {}
    st = load_state()
    status_msg = "Управление: [↑/↓] Выбор пункта  |  [←/→ / Enter / Клик мыши] Изменить / Открыть  |  [Q/Esc] Выход"

    def activate_row(row, delta):
        nonlocal status_msg, st
        st.setdefault("theme", {}).setdefault("glass", {})
        st.setdefault("system", {})

        if row == 0:
            keys = [k for k, _ in THEME_PRESETS]
            cur = st.get("theme", {}).get("name", "cyan")
            idx = (keys.index(cur) + delta) % len(keys) if cur in keys else 0
            nxt_key, nxt_label = THEME_PRESETS[idx]
            trigger_theme_apply(["--theme", nxt_key])
            st = load_state()
            status_msg = f"Цветовая тема: {nxt_label}"

        elif row == 1:
            paths = [os.path.basename(p) for _, _, p in DESKTOP_WALLS]
            cur_p = os.path.basename(st.get("wallpaper", {}).get("desktop", {}).get("path", "cyber_glass.png"))
            idx = (paths.index(cur_p) + delta) % len(DESKTOP_WALLS) if cur_p in paths else 0
            w_key, w_label, _ = DESKTOP_WALLS[idx]
            subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", w_key], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            st = load_state()
            status_msg = f"Обои рабочего стола: {w_label}"

        elif row == 2:
            enabled = not get_glass_enabled(st)
            st["theme"]["glass"]["blur_enabled"] = enabled
            st["theme"]["glass"]["opacity_active"] = 0.95 if enabled else 1.0
            st["theme"]["glass"]["opacity_inactive"] = 0.85 if enabled else 1.0
            st["theme"]["glass"]["opacity_panels"] = 0.90 if enabled else 1.0
            save_state(st)
            trigger_theme_apply()
            st = load_state()
            status_msg = f"Эффект матового стекла / прозрачности: {'Вкл' if enabled else 'Выкл'}"

        elif row == 3:
            keys = [k for k, _, _ in KB_LAYOUTS]
            cur_kb = st.get("system", {}).get("kb_layout", "us,ru")
            idx = (keys.index(cur_kb) + delta) % len(KB_LAYOUTS) if cur_kb in keys else 0
            kb_code, kb_label, kb_opt = KB_LAYOUTS[idx]
            st["system"]["kb_layout"] = kb_code
            st["system"]["kb_toggle"] = kb_opt
            save_state(st)
            trigger_theme_apply()
            st = load_state()
            status_msg = f"Язык и раскладка клавиатуры: {kb_label}"

        elif row == 4:
            if delta < 0:
                subprocess.Popen(["kitty", "--class", "nm-connection-editor", "-e", "nmtui"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                status_msg = "Открыт менеджер сетей Wi-Fi (nmtui)"
            else:
                subprocess.run(["pkill", "-x", "rofi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.Popen(["/usr/local/bin/kortex-control-center"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                status_msg = "Открыто меню Wi-Fi и Звук"

        elif row == 5:
            curses.endwin()
            os.makedirs("/run/kortex-persistence", exist_ok=True)
            save_state(st)
            try:
                shutil.copy2(MASTER_STATE, "/run/kortex-persistence/master-state.json")
            except Exception:
                pass
            subprocess.Popen(["/usr/local/bin/kortex-open", "install"])
            sys.exit(0)

    while True:
        try:
            h, w = stdscr.getmaxyx()
            stdscr.erase()

            border_top = "┌───[ ⚙️ НАСТРОЙКИ СИСТЕМЫ KORTEXOS ]" + "─" * max(0, w - 39) + "┐"
            safe_addstr(stdscr, 0, 1, border_top, curses.color_pair(3) | curses.A_BOLD)
            if h >= 18:
                safe_addstr(stdscr, 1, 3, "Простая настройка внешнего вида, раскладки, сети и установки ОС в один экран", curses.color_pair(1))
                safe_addstr(stdscr, 2, 1, "├" + "─" * max(1, w - 3) + "┤", curses.color_pair(3))

            glass_on = get_glass_enabled(st)
            rows = [
                ("1. 🎨 Цветовая тема",                  f"◄  {get_theme_label(st):^22}  ►", "Cyber Cyan, Tokyo Night, Dracula, Matrix, Mono"),
                ("2. 🖼️ Обои рабочего стола",            f"◄  {get_wallpaper_label(st):^22}  ►", "Cyber Glass, Tokyo Horizon, Cyber Grid, Matrix, Pitch Black"),
                ("3. ✨ Матовое стекло и прозрачность",   f"◄  {'Вкл' if glass_on else 'Выкл':^22}  ►", "Размытие фона и прозрачность окон (Вкл / Выкл)"),
                ("4. ⌨️ Язык и раскладка клавиатуры",    f"◄  {get_kb_label(st):^22}  ►", "Переключение раскладки: EN + RU (Alt+Shift), EN + RO, DE"),
                ("5. 🎛️ Wi-Fi и Звук",                   "[ Открыть Звук и Сеть / nmtui ]", "Настройка громкости, яркости, Wi-Fi и Bluetooth"),
                ("6. 💿 Установка KortexOS на диск",      "[ Запустить установщик ОС ]", "Установить систему на жёсткий диск или SSD с вашими настройками"),
            ]

            row_y_map.clear()
            if h >= 24:
                y, row_step, show_desc = 4, 3, True
            elif h >= 18:
                y, row_step, show_desc = 3, 2, True
            else:
                y, row_step, show_desc = 1, 1, False

            val_x = min(44, max(26, w - 34))
            bar_w = max(1, min(76, w - 4))

            for idx, (title, val_str, desc) in enumerate(rows):
                is_sel = (idx == cur_row)
                prefix = " ▶ " if is_sel else "   "
                attr_main = curses.color_pair(2) | curses.A_BOLD if is_sel else curses.color_pair(1) | curses.A_BOLD
                attr_val = curses.color_pair(2) | curses.A_BOLD if is_sel else curses.color_pair(4) | curses.A_BOLD
                if is_sel:
                    safe_addstr(stdscr, y, 2, " " * bar_w, attr_main)
                safe_addstr(stdscr, y, 2, f"{prefix}{title}", attr_main)
                safe_addstr(stdscr, y, val_x, val_str, attr_val)
                row_y_map[y] = idx
                if show_desc:
                    safe_addstr(stdscr, y + 1, 8, desc, curses.color_pair(3) if is_sel else curses.color_pair(1))
                    row_y_map[y + 1] = idx
                y += row_step

            if h >= 10:
                safe_addstr(stdscr, h - 3, 1, "└" + "─" * max(1, w - 3) + "┘", curses.color_pair(3))
            safe_addstr(stdscr, max(0, h - 2), 3, status_msg[:max(1, w - 6)], curses.color_pair(5) | curses.A_BOLD)
            stdscr.refresh()

            ch = stdscr.getch()
            if ch in (ord('q'), ord('Q'), 27):
                break
            elif ch == curses.KEY_UP:
                cur_row = (cur_row - 1) % len(rows)
            elif ch == curses.KEY_DOWN:
                cur_row = (cur_row + 1) % len(rows)
            elif ord('1') <= ch <= ord('6'):
                cur_row = ch - ord('1')
                activate_row(cur_row, 1)
            elif ch == curses.KEY_LEFT:
                activate_row(cur_row, -1)
            elif ch in (curses.KEY_RIGHT, 10, 13, curses.KEY_ENTER, ord(' ')):
                activate_row(cur_row, 1)
            elif ch == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                    if my in row_y_map:
                        cur_row = row_y_map[my]
                        if bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED):
                            if cur_row in (0, 1, 2, 3) and val_x <= mx <= val_x + 4:
                                activate_row(cur_row, -1)
                            elif cur_row == 4 and mx >= val_x + 22:
                                activate_row(cur_row, -1)
                            else:
                                activate_row(cur_row, 1)
                except Exception:
                    pass

        except Exception as e:
            status_msg = f"Примечание: {e}"

def main():
    if "--apply" in sys.argv or "-a" in sys.argv:
        trigger_theme_apply()
        sys.exit(0)
    try:
        curses.wrapper(settings_tui)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
