def load_state():
    os.makedirs(CONF_DIR, exist_ok=True)
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                d = json.load(f)
                res = DEFAULT_STATE.copy()
                for k, v in d.items():
                    if isinstance(v, dict) and k in res:
                        res[k].update(v)
                    else:
                        res[k] = v
                return res
        except Exception:
            pass
    return DEFAULT_STATE.copy()

def save_state(st):
    os.makedirs(CONF_DIR, exist_ok=True)
    try:
        with open(MASTER_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        with open(LEGACY_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

def trigger_theme_apply():
    try:
        subprocess.run(["/usr/local/bin/kortex-theme-apply"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
    except Exception:
        pass

def safe_addstr(win, y, x, s, attr=curses.A_NORMAL):
    h, w = win.getmaxyx()
    if 0 <= y < h and 0 <= x < w:
        try:
            win.addstr(y, x, s[:w - x - 1], attr)
        except curses.error:
            pass

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5)
        return res.stdout.strip(), res.stderr.strip(), res.returncode
    except Exception as e:
        return "", str(e), 1

def settings_tui(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(False)
    stdscr.keypad(True)

    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(3, curses.COLOR_CYAN, -1)
    curses.init_pair(4, curses.COLOR_GREEN, -1)
    curses.init_pair(5, curses.COLOR_YELLOW, -1)
    curses.init_pair(6, curses.COLOR_RED, -1)

    tab_titles = [
        "1:PHILOSOPHY",
        "2:THEME STUDIO PRO",
        "3:WALLPAPERS",
        "4:KEYBINDS",
        "5:HARDWARE & DISK"
    ]
    cur_tab = 1
    cur_row = 0
    status_msg = "Ready. Use [1-5] or [TAB] to switch tabs, [UP/DOWN] to navigate, [ENTER/SPACE] to modify."

    hex_input_mode = False
    custom_hex_buffer = ""
    active_hex_field = "primary_accent"

    while True:
        try:
            h, w = stdscr.getmaxyx()
            stdscr.erase()
            st = load_state()

            # Top Header
            border_top = "┌───[ KORTEX-OS MASTER CUSTOMIZATION STUDIO // v3.0 ]" + "─" * max(0, w - 55) + "┐"
            safe_addstr(stdscr, 0, 1, border_top, curses.color_pair(3) | curses.A_BOLD)

            # Tabs
            tab_x = 3
            for i, title in enumerate(tab_titles):
                attr = curses.color_pair(2) | curses.A_BOLD if i == cur_tab else curses.color_pair(1)
                safe_addstr(stdscr, 2, tab_x, f" {title} ", attr)
                tab_x += len(title) + 3
            safe_addstr(stdscr, 3, 1, "├" + "─" * (w - 3) + "┤", curses.color_pair(1))

            # ==================================================================
            # TAB 0: PHILOSOPHY & LAYOUT
            # ==================================================================
            if cur_tab == 0:
                cur_phil = st.get("interface", {}).get("philosophy", "cyberdeck")
                safe_addstr(stdscr, 5, 4, "PRIMARY INTERFACE PHILOSOPHY & WORKSPACE LAYOUT:", curses.color_pair(3) | curses.A_BOLD)

                phil_items = [
                    ("cyberdeck", "Cyber-Deck Mode (eDEX-UI 5-Panel Grid)", "5-module HUD: System pulse, network globe, terminal, file grid & virtual deck"),
                    ("macbook",   "MacBook Pro Mode (Glass & Dock)",        "Frosted glass blur, floating windows with [ _ ][ □ ][ ✕ ] buttons & gestures"),
                    ("tiling",    "Pure Tiling Mode (Pro Developer)",       "Strict full-screen dwindle tiling without distraction panels or on-screen deck")
                ]
                row_idx = 0
                for p_key, p_name, p_desc in phil_items:
                    is_active = (cur_phil == p_key)
                    is_sel = (cur_row == row_idx)
                    marker = "● " if is_active else "○ "
                    attr = curses.color_pair(2) if is_sel else (curses.color_pair(4) | curses.A_BOLD if is_active else curses.color_pair(1))
                    safe_addstr(stdscr, 8 + (row_idx * 3), 6, f"{marker}{p_name:<42}", attr)
                    safe_addstr(stdscr, 9 + (row_idx * 3), 10, p_desc, curses.color_pair(1))
                    row_idx += 1

                # Toggle Grid Widgets (for Cyberdeck)
                safe_addstr(stdscr, 19, 4, "CYBER-DECK STARTER WIDGETS (Toggle modules on Workspace 1):", curses.color_pair(3) | curses.A_BOLD)
                widgets = st.get("grid_widgets", {})
                for mod_id, mod_name, _, _ in GRID_MODULES:
                    is_sel = (cur_row == row_idx)
                    is_on = widgets.get(mod_id, True)
                    check = "[x]" if is_on else "[ ]"
                    attr = curses.color_pair(2) if is_sel else (curses.color_pair(4) if is_on else curses.color_pair(1))
                    safe_addstr(stdscr, 21 + (row_idx - 3), 6, f"{check} {mod_name}", attr)
                    row_idx += 1

            # ==================================================================
            # TAB 1: THEME STUDIO PRO
            # ==================================================================
            elif cur_tab == 1:
                th = st.get("theme", {})
                pal = th.get("palette", {})
                borders = th.get("borders", {})
                glass = th.get("glass", {})

                cur_accent = pal.get("primary_accent", "#00f0ff").lstrip("#")
                b_size = int(borders.get("size", 2))
                b_round = int(borders.get("rounding", 6))
                b_mode = borders.get("mode", "dual_gradient")
                b_angle = int(borders.get("gradient_angle", 45))
                g_radius = int(borders.get("glow_radius", 15))

                act_op = float(glass.get("opacity_active", 0.95))
                inact_op = float(glass.get("opacity_inactive", 0.85))
                panel_op = float(glass.get("opacity_panels", 0.90))
                blur = bool(glass.get("blur_enabled", True))
                blur_size = int(glass.get("blur_size", 8))
                blur_passes = int(glass.get("blur_passes", 3))

                row_idx = 0
                safe_addstr(stdscr, 4, 4, "🎨 CORE PALETTE PRESETS (Instant Live Apply):", curses.color_pair(3) | curses.A_BOLD)
                for p_key, p_data in THEME_PRESETS.items():
                    is_sel = (cur_row == row_idx)
                    is_active = (cur_accent.lower() == p_data["accent"].lower())
                    marker = "● " if is_active else "○ "
                    attr = curses.color_pair(2) if is_sel else (curses.color_pair(4) | curses.A_BOLD if is_active else curses.color_pair(1))
                    safe_addstr(stdscr, 6 + row_idx, 6, f"{marker}{p_data['name']:<14} (#{p_data['accent']}) : {p_data['desc']}", attr)
                    row_idx += 1

                # Custom Hex Input
                is_sel = (cur_row == row_idx)
                custom_lbl = f"  Custom Accent HEX : #{custom_hex_buffer if hex_input_mode else cur_accent} {'[TYPING...]' if hex_input_mode else '(Press ENTER to type)'}"
                attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                safe_addstr(stdscr, 6 + row_idx, 6, custom_lbl, attr)
                row_idx += 1

                # Borders & Edges
                safe_addstr(stdscr, 13, 4, "🔲 BORDER & EDGE ENGINE (Use LEFT/RIGHT or ENTER):", curses.color_pair(3) | curses.A_BOLD)
                border_items = [
                    (f"Border Mode      : [ {b_mode.upper()} ]", f"Solid / Dual Gradient / Neon Loop / Glow Shadow"),
                    (f"Border Thickness : [ {b_size}px ]",        f"Range: 0 - 6px"),
                    (f"Corner Rounding  : [ {b_round}px ]",       f"Range: 0 (Cyberpunk) - 20px (macOS)"),
                    (f"Gradient Angle   : [ {b_angle}° ]",        f"Range: 0 - 360° (for dual gradient)"),
                    (f"Glow Radius      : [ {g_radius}px ]",       f"Range: 5 - 40px (for neon bloom shadow)")
                ]
                for label, desc in border_items:
                    is_sel = (cur_row == row_idx)
                    attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                    safe_addstr(stdscr, 15 + (row_idx - 6), 6, f"{label:<32} {desc}", attr)
                    row_idx += 1

                # Glassmorphism & Blur
                safe_addstr(stdscr, 21, 4, "✨ GLASSMORPHISM & BLUR SLIDERS:", curses.color_pair(3) | curses.A_BOLD)
                glass_items = [
                    (f"Active Opacity   : [ {int(act_op*100)}% ]",    f"Range: 50% - 100%"),
                    (f"Inactive Opacity : [ {int(inact_op*100)}% ]",  f"Range: 30% - 100%"),
                    (f"Panel Opacity    : [ {int(panel_op*100)}% ]",  f"Range: 50% - 100% (Waybar/Rofi)"),
                    (f"Kawase Blur      : [ {'ENABLED' if blur else 'DISABLED'} ]", f"Deep background glass diffusion"),
                    (f"Blur Size/Passes : [ Size {blur_size} / {blur_passes}p ]", f"Smoothness and radius")
                ]
                for label, desc in glass_items:
                    is_sel = (cur_row == row_idx)
                    attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                    safe_addstr(stdscr, 23 + (row_idx - 11), 6, f"{label:<32} {desc}", attr)
                    row_idx += 1

            # ==================================================================
            # TAB 2: WALLPAPERS (DESKTOP & PER-APP KITTY)
            # ==================================================================
            elif cur_tab == 2:
                wp = st.get("wallpaper", {})
                desk_path = wp.get("desktop", {}).get("path", "Default Cyber Grid")
                term_wp = wp.get("terminal", {})
                term_enabled = term_wp.get("image_enabled", False)
                term_dim = term_wp.get("dimming", 0.35)

                safe_addstr(stdscr, 5, 4, "🖼️ DESKTOP WALLPAPERS (Live Hyprpaper / SWWW):", curses.color_pair(3) | curses.A_BOLD)
                safe_addstr(stdscr, 6, 6, f"Current Active: {desk_path}", curses.color_pair(1))

                desk_presets = [
                    ("grid",  "Cyber Grid (Vector Tech Canvas)", "/usr/share/kortex/wallpapers/cyber_grid.png"),
                    ("glass", "Cyber Glass (MacBook Multi-Mesh)", "/usr/share/kortex/wallpapers/cyber_glass.png"),
                    ("black", "Pitch Black (OLED Zero Minimalist)", "/usr/share/kortex/wallpapers/pitch_black.png")
                ]
                row_idx = 0
                for p_key, p_label, p_fpath in desk_presets:
                    is_sel = (cur_row == row_idx)
                    is_active = (p_fpath == desk_path or p_key in desk_path.lower())
                    marker = "● " if is_active else "○ "
                    attr = curses.color_pair(2) if is_sel else (curses.color_pair(4) | curses.A_BOLD if is_active else curses.color_pair(1))
                    safe_addstr(stdscr, 8 + row_idx, 6, f"{marker}{p_label:<38} [Apply]", attr)
                    row_idx += 1

                # Kitty Per-App Wallpaper
                safe_addstr(stdscr, 14, 4, "💻 PER-APP TERMINAL WALLPAPER (Kitty Background Image):", curses.color_pair(3) | curses.A_BOLD)
                safe_addstr(stdscr, 15, 6, "Renders custom wallpaper directly inside the Kitty terminal with dimming:", curses.color_pair(1))

                term_items = [
                    (f"Terminal Wallpaper : [ {'ENABLED' if term_enabled else 'DISABLED'} ]", "Toggles background image in kitty.conf"),
                    (f"Dimming / Tint     : [ {int(term_dim*100)}% Dimmed ]", "Ensures code syntax remains 100% legible"),
                    (f"Use Desktop Wallpaper as Terminal Background", "Syncs active desktop wallpaper into Kitty")
                ]
                for label, desc in term_items:
                    is_sel = (cur_row == row_idx)
                    attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                    safe_addstr(stdscr, 17 + (row_idx - 3), 6, f"{label:<42} {desc}", attr)
                    row_idx += 1

            # ==================================================================
            # TAB 3: KEYBIND MANAGER & SPOTLIGHT
            # ==================================================================
            elif cur_tab == 3:
                hotkeys = st.get("hotkeys", {})
                safe_addstr(stdscr, 4, 4, "⌨ VISUAL KEYBIND MANAGER (Targets ~/.config/hypr/binds.conf):", curses.color_pair(3) | curses.A_BOLD)
                safe_addstr(stdscr, 5, 4, "Select any shortcut and press [ENTER] to cycle modifier key combination:", curses.color_pair(1))

                row_idx = 0
                for key_id, name, def_bind, _ in SYSTEM_HOTKEYS:
                    cur_bind = hotkeys.get(key_id, def_bind)
                    is_sel = (cur_row == row_idx)
                    attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                    safe_addstr(stdscr, 7 + row_idx, 6, f"[{cur_bind:^20}]  :  {name}", attr)
                    row_idx += 1

                safe_addstr(stdscr, 7 + len(SYSTEM_HOTKEYS) + 1, 6, "Press [R] to reset all keybindings to factory defaults", curses.color_pair(5))

            # ==================================================================
            # TAB 4: HARDWARE & DISK PERSISTENCE
            # ==================================================================
            elif cur_tab == 4:
                pwr = st.get("system", {}).get("power_profile", "balanced")
                safe_addstr(stdscr, 5, 4, "⚡ ZEN KERNEL HARDWARE POWER & PERFORMANCE:", curses.color_pair(3) | curses.A_BOLD)

                pwr_items = [
                    ("balanced",    "Balanced (Adaptive Schedutil)", "Optimal thermals and responsive 60fps animations"),
                    ("performance", "Overdrive (Maximum Frequency)", "Zero-latency performance for heavy compilation & 3D"),
                    ("powersave",   "Eco Mode (Battery Saver)",      "Low power governor, extended mobile laptop runtime")
                ]
                row_idx = 0
                for p_key, p_label, p_desc in pwr_items:
                    is_sel = (cur_row == row_idx)
                    is_active = (pwr == p_key)
                    marker = "● " if is_active else "○ "
                    attr = curses.color_pair(2) if is_sel else (curses.color_pair(4) | curses.A_BOLD if is_active else curses.color_pair(1))
                    safe_addstr(stdscr, 7 + (row_idx * 2), 6, f"{marker}{p_label:<32}", attr)
                    row_idx += 1

                safe_addstr(stdscr, 15, 4, "💾 PERSISTENCE & HARD DRIVE DEPLOYMENT:", curses.color_pair(3) | curses.A_BOLD)
                persist_items = [
                    ("Export Profile (.kortex)", "Export all themes, widgets & settings to a portable file"),
                    ("Reset to Factory Defaults", "Restore clean initial KortexOS configuration"),
                    ("INSTALL TO DISK (WITH CURRENT SETTINGS)", "Transfer live settings directly into target hard drive installation!")
                ]
                for label, desc in persist_items:
                    is_sel = (cur_row == row_idx)
                    attr = curses.color_pair(2) if is_sel else curses.color_pair(1)
                    safe_addstr(stdscr, 17 + ((row_idx - 3) * 2), 6, f"[ {label} ] : {desc}", attr)
                    row_idx += 1

            # Footer
            border_bottom = "└" + "─" * (w - 3) + "┘"
            safe_addstr(stdscr, h - 3, 1, border_bottom, curses.color_pair(1))
            status_attr = curses.color_pair(4) | curses.A_BOLD if any(w in status_msg.lower() for w in ["applied", "saved", "enabled", "switched", "exported"]) else curses.color_pair(1)
            safe_addstr(stdscr, h - 2, 3, status_msg[:w - 6], status_attr)

            stdscr.refresh()

            # Handle Hex typing
            if hex_input_mode:
                ch = stdscr.getch()
                if ch in (10, 13, curses.KEY_ENTER):
                    hex_input_mode = False
                    val = custom_hex_buffer.replace("#", "").strip()
                    if len(val) == 6 and all(c in "0123456789abcdefABCDEF" for c in val):
                        st["theme"]["palette"]["primary_accent"] = f"#{val}"
                        st["theme"]["palette"]["border_active"] = f"#{val}"
                        st["theme"]["name"] = "custom"
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Custom HEX color applied: #{val}"
                    else:
                        status_msg = f"Invalid hex color '{val}'. Expected 6 characters (e.g. 00f0ff)."
                    custom_hex_buffer = ""
                elif ch in (27,):
                    hex_input_mode = False
                    custom_hex_buffer = ""
                    status_msg = "Custom HEX input cancelled"
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    custom_hex_buffer = custom_hex_buffer[:-1]
                elif 0 <= ch < 256 and chr(ch) in "0123456789abcdefABCDEF":
                    if len(custom_hex_buffer) < 6:
                        custom_hex_buffer += chr(ch).lower()
                continue

            # Standard Key Handling
            ch = stdscr.getch()
            if ch == -1:
                continue
            if ch in (ord('q'), ord('Q'), 27):
                break
            elif ch in (ord('1'), ord('2'), ord('3'), ord('4'), ord('5')):
                cur_tab = ch - ord('1')
                cur_row = 0
            elif ch == ord('\t'):
                cur_tab = (cur_tab + 1) % 5
                cur_row = 0
            elif ch == curses.KEY_UP:
                cur_row = max(0, cur_row - 1)
            elif ch == curses.KEY_DOWN:
                cur_row += 1
            elif ch in (ord('r'), ord('R')) and cur_tab == 3:
                # Reset keybinds
                st["hotkeys"] = DEFAULT_STATE["hotkeys"].copy()
                save_state(st)
                status_msg = "All hotkeys reset to factory defaults."
            elif ch in (10, 13, curses.KEY_ENTER, ord(' '), curses.KEY_LEFT, curses.KEY_RIGHT):
                # Process selection based on current tab
                delta = -1 if ch == curses.KEY_LEFT else 1

                # ------------------------------------------------------
                # TAB 0 ACTIONS: PHILOSOPHY
                # ------------------------------------------------------
                if cur_tab == 0:
                    if cur_row == 0:
                        st["interface"]["philosophy"] = "cyberdeck"
                        save_state(st)
                        subprocess.run(["/usr/local/bin/kortex-layout", "grid"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        status_msg = "Switched to Cyber-Deck 5-Panel Grid layout."
                    elif cur_row == 1:
                        st["interface"]["philosophy"] = "macbook"
                        save_state(st)
                        subprocess.run(["/usr/local/bin/kortex-layout", "floating"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        status_msg = "Switched to MacBook Pro Mode (Glass & Dock)."
                    elif cur_row == 2:
                        st["interface"]["philosophy"] = "tiling"
                        save_state(st)
                        subprocess.run(["/usr/local/bin/kortex-layout", "tiling"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        status_msg = "Switched to Pure Tiling Developer Mode."
                    elif 3 <= cur_row < 3 + len(GRID_MODULES):
                        mod_idx = cur_row - 3
                        mod_id = GRID_MODULES[mod_idx][0]
                        st["grid_widgets"][mod_id] = not st["grid_widgets"].get(mod_id, True)
                        save_state(st)
                        subprocess.run(["/usr/local/bin/kortex-grid-init"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        status_msg = f"Widget '{GRID_MODULES[mod_idx][1]}' toggled."

                # ------------------------------------------------------
                # TAB 1 ACTIONS: THEME STUDIO PRO
                # ------------------------------------------------------
                elif cur_tab == 1:
                    p_keys = list(THEME_PRESETS.keys())
                    if cur_row < len(p_keys):
                        chosen_k = p_keys[cur_row]
                        p_data = THEME_PRESETS[chosen_k]
                        st["theme"]["name"] = chosen_k
                        st["theme"]["palette"]["primary_accent"] = f"#{p_data['accent']}"
                        st["theme"]["palette"]["border_active"] = f"#{p_data['accent']}"
                        st["theme"]["palette"]["secondary_accent"] = f"#{p_data['sec']}"
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Applied Theme: {p_data['name']} (#{p_data['accent']})"
                    elif cur_row == len(p_keys):
                        hex_input_mode = True
                        custom_hex_buffer = ""
                        status_msg = "Type 6-character HEX code (e.g. 00f0ff) and press ENTER:"
                    elif cur_row == len(p_keys) + 1: # Border Mode
                        modes = ["solid", "dual_gradient", "neon_loop", "glow_shadow"]
                        cur_m = st["theme"]["borders"].get("mode", "dual_gradient")
                        nxt_m = modes[(modes.index(cur_m) + delta) % len(modes)]
                        st["theme"]["borders"]["mode"] = nxt_m
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Border Mode set to: {nxt_m.upper()}"
                    elif cur_row == len(p_keys) + 2: # Border Size
                        cur_b = int(st["theme"]["borders"].get("size", 2))
                        new_b = max(0, min(6, cur_b + delta))
                        st["theme"]["borders"]["size"] = new_b
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Border Thickness: {new_b}px"
                    elif cur_row == len(p_keys) + 3: # Rounding
                        cur_r = int(st["theme"]["borders"].get("rounding", 6))
                        new_r = max(0, min(20, cur_r + delta * 2))
                        st["theme"]["borders"]["rounding"] = new_r
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Corner Rounding: {new_r}px"
                    elif cur_row == len(p_keys) + 4: # Gradient Angle
                        cur_a = int(st["theme"]["borders"].get("gradient_angle", 45))
                        new_a = (cur_a + delta * 15) % 360
                        st["theme"]["borders"]["gradient_angle"] = new_a
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Gradient Angle: {new_a}°"
                    elif cur_row == len(p_keys) + 5: # Glow Radius
                        cur_g = int(st["theme"]["borders"].get("glow_radius", 15))
                        new_g = max(5, min(40, cur_g + delta * 5))
                        st["theme"]["borders"]["glow_radius"] = new_g
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Glow Shadow Radius: {new_g}px"
                    elif cur_row == len(p_keys) + 6: # Active Opacity
                        cur_o = float(st["theme"]["glass"].get("opacity_active", 0.95))
                        new_o = max(0.5, min(1.0, round(cur_o + delta * 0.05, 2)))
                        st["theme"]["glass"]["opacity_active"] = new_o
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Active Window Opacity: {int(new_o*100)}%"
                    elif cur_row == len(p_keys) + 7: # Inactive Opacity
                        cur_o = float(st["theme"]["glass"].get("opacity_inactive", 0.85))
                        new_o = max(0.3, min(1.0, round(cur_o + delta * 0.05, 2)))
                        st["theme"]["glass"]["opacity_inactive"] = new_o
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Inactive Window Opacity: {int(new_o*100)}%"
                    elif cur_row == len(p_keys) + 8: # Panel Opacity
                        cur_o = float(st["theme"]["glass"].get("opacity_panels", 0.90))
                        new_o = max(0.5, min(1.0, round(cur_o + delta * 0.05, 2)))
                        st["theme"]["glass"]["opacity_panels"] = new_o
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"System Panel Opacity: {int(new_o*100)}%"
                    elif cur_row == len(p_keys) + 9: # Blur Toggle
                        cur_b = bool(st["theme"]["glass"].get("blur_enabled", True))
                        st["theme"]["glass"]["blur_enabled"] = not cur_b
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Kawase Glass Blur: {'ENABLED' if not cur_b else 'DISABLED'}"
                    elif cur_row == len(p_keys) + 10: # Blur Size/Passes
                        cur_s = int(st["theme"]["glass"].get("blur_size", 8))
                        new_s = max(2, min(20, cur_s + delta * 2))
                        st["theme"]["glass"]["blur_size"] = new_s
                        save_state(st)
                        trigger_theme_apply()
                        status_msg = f"Blur Size set to: {new_s}px"

                # ------------------------------------------------------
                # TAB 2 ACTIONS: WALLPAPERS
                # ------------------------------------------------------
                elif cur_tab == 2:
                    if cur_row == 0:
                        subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", "grid"])
                        status_msg = "Applied Cyber Grid desktop wallpaper."
                    elif cur_row == 1:
                        subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", "glass"])
                        status_msg = "Applied Cyber Glass desktop wallpaper."
                    elif cur_row == 2:
                        subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", "black"])
                        status_msg = "Applied Pitch Black OLED wallpaper."
                    elif cur_row == 3: # Terminal wallpaper toggle
                        cur_en = st.get("wallpaper", {}).get("terminal", {}).get("image_enabled", False)
                        d_path = st.get("wallpaper", {}).get("desktop", {}).get("path", "/usr/share/kortex/wallpapers/cyber_grid.png")
                        new_en = not cur_en
                        dim = st.get("wallpaper", {}).get("terminal", {}).get("dimming", 0.35)
                        subprocess.run(["/usr/local/bin/kortex-wallpaper", "terminal", d_path if new_en else "none", str(dim)])
                        status_msg = f"Kitty Terminal Wallpaper {'ENABLED' if new_en else 'DISABLED'}."
                    elif cur_row == 4: # Dimming
                        cur_dim = float(st.get("wallpaper", {}).get("terminal", {}).get("dimming", 0.35))
                        new_dim = max(0.0, min(0.95, round(cur_dim + delta * 0.05, 2)))
                        t_path = st.get("wallpaper", {}).get("terminal", {}).get("image_path", "")
                        subprocess.run(["/usr/local/bin/kortex-wallpaper", "terminal", t_path if t_path else "none", str(new_dim)])
                        status_msg = f"Terminal Wallpaper Dimming: {int(new_dim*100)}%"
                    elif cur_row == 5: # Sync Desktop to Terminal
                        d_path = st.get("wallpaper", {}).get("desktop", {}).get("path", "/usr/share/kortex/wallpapers/cyber_grid.png")
                        dim = st.get("wallpaper", {}).get("terminal", {}).get("dimming", 0.35)
                        subprocess.run(["/usr/local/bin/kortex-wallpaper", "terminal", d_path, str(dim)])
                        status_msg = "Synced Desktop Wallpaper into Kitty Terminal."

                # ------------------------------------------------------
                # TAB 3 ACTIONS: KEYBINDS
                # ------------------------------------------------------
                elif cur_tab == 3:
                    if cur_row < len(SYSTEM_HOTKEYS):
                        key_id, name, def_bind, _ = SYSTEM_HOTKEYS[cur_row]
                        cur_b = st["hotkeys"].get(key_id, def_bind)
                        # Cycle modifiers: SUPER -> SUPER SHIFT -> ALT -> CTRL
                        mod_cycles = ["SUPER", "SUPER SHIFT", "ALT", "SUPER CTRL"]
                        found_mod = "SUPER"
                        key_char = "Q"
                        for m in mod_cycles:
                            if cur_b.startswith(m):
                                found_mod = m
                                key_char = cur_b[len(m):].lstrip(", ")
                                break
                        next_mod = mod_cycles[(mod_cycles.index(found_mod) + 1) % len(mod_cycles)]
                        new_bind = f"{next_mod}, {key_char}"
                        st["hotkeys"][key_id] = new_bind
                        save_state(st)
                        status_msg = f"Keybind for '{name}' changed to: {new_bind}"

                # ------------------------------------------------------
                # TAB 4 ACTIONS: HARDWARE & PERSISTENCE
                # ------------------------------------------------------
                elif cur_tab == 4:
                    if cur_row == 0:
                        st["system"]["power_profile"] = "balanced"
                        save_state(st)
                        status_msg = "Hardware profile: BALANCED (Zen schedutil)."
                    elif cur_row == 1:
                        st["system"]["power_profile"] = "performance"
                        save_state(st)
                        status_msg = "Hardware profile: OVERDRIVE (Max performance)."
                    elif cur_row == 2:
                        st["system"]["power_profile"] = "powersave"
                        save_state(st)
                        status_msg = "Hardware profile: ECO MODE (Battery saver)."
                    elif cur_row == 3: # Export
                        exp_path = os.path.expanduser("~/my-kortex-setup.kortex")
                        subprocess.run(["/usr/local/bin/kortex-profile", "export", exp_path])
                        status_msg = f"Profile exported to: {exp_path}"
                    elif cur_row == 4: # Reset
                        subprocess.run(["/usr/local/bin/kortex-profile", "reset"])
                        status_msg = "All settings reset to clean factory defaults."
                    elif cur_row == 5: # Install to disk
                        curses.endwin()
                        print("\n\033[1;36m[*] Launching KortexOS System Installer with current settings...\033[0m")
                        os.makedirs("/run/kortex-persistence", exist_ok=True)
                        save_state(st)
                        import shutil
                        shutil.copy2(MASTER_STATE, "/run/kortex-persistence/master-state.json")
                        time.sleep(1)
                        if os.path.exists("/usr/local/bin/kortex-install"):
                            subprocess.run(["/usr/local/bin/kortex-install"])
                        sys.exit(0)

        except Exception as e:
            status_msg = f"Notice: {e}"

def main():
    if "--apply" in sys.argv or "-a" in sys.argv:
        trigger_theme_apply()
        sys.exit(0)

    try:
        curses.wrapper(settings_tui)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
