ROFI_THEME = os.path.expanduser("~/.config/rofi/theme.rasi")
GTK3_CSS = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
GTK4_CSS = os.path.expanduser("~/.config/gtk-4.0/gtk.css")

