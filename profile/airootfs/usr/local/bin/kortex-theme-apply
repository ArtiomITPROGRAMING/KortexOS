def clean_hex(color_str):
    if not color_str:
        return "00f0ff"
    s = str(color_str).strip().lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    return s[:6] if len(s) >= 6 else "00f0ff"

def hex_to_rgb(hex_code):
    h = clean_hex(hex_code)
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)

def deep_merge(base, override):
    res = json.loads(json.dumps(base))
    for k, v in override.items():
        if isinstance(v, dict) and isinstance(res.get(k), dict):
            res[k] = deep_merge(res[k], v)
        else:
            res[k] = v
    return res

def load_master():
    os.makedirs(CONF_DIR, exist_ok=True)
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                d = json.load(f)
                return deep_merge(DEFAULT_MASTER, d)
        except Exception:
            pass
    return json.loads(json.dumps(DEFAULT_MASTER))

def save_master(st):
    os.makedirs(CONF_DIR, exist_ok=True)
    os.makedirs(BACKUP_DIR, exist_ok=True)
    try:
        with open(MASTER_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        with open(LEGACY_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        snap = os.path.join(BACKUP_DIR, "latest-persistence.json")
        shutil.copy2(MASTER_STATE, snap)
    except Exception as e:
        print(f"[-] Persistence save error: {e}")

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hdir = f"{env['XDG_RUNTIME_DIR']}/hypr"
        if os.path.exists(hdir):
            sigs = os.listdir(hdir)
            if sigs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]
    return env

def apply_hyprland(st, env):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})
    anim = th.get("animations", {}).get("mode", "smooth")
    sys_cfg = st.get("system", {})

    b_active = clean_hex(pal.get("border_active", "#00f0ff"))
    b_inactive = clean_hex(pal.get("border_inactive", "#1b2430"))
    b_sec = clean_hex(pal.get("secondary_accent", "#0088cc"))
    b_crit = clean_hex(pal.get("alert_critical", "#ff003c"))
    glow_col = clean_hex(pal.get("primary_accent", "#00f0ff"))

    border_size = max(0, min(6, int(borders.get("size", 2))))
    rounding = max(0, min(20, int(borders.get("rounding", 6))))
    gaps_in = max(0, int(borders.get("gaps_in", 6)))
    gaps_out = max(0, int(borders.get("gaps_out", 10)))
    mode = borders.get("mode", "dual_gradient")
    angle = int(borders.get("gradient_angle", 45)) % 360
    glow_radius = max(1, min(40, int(borders.get("glow_radius", 15))))

    act_op = max(0.5, min(1.0, float(glass.get("opacity_active", 0.95))))
    inact_op = max(0.3, min(1.0, float(glass.get("opacity_inactive", 0.85))))
    blur = bool(glass.get("blur_enabled", True))
    blur_size = max(1, min(20, int(glass.get("blur_size", 8))))
    blur_passes = max(1, min(5, int(glass.get("blur_passes", 3))))
    blur_vibrancy = max(0.0, min(1.0, float(glass.get("blur_vibrancy", 0.1696))))
    xray = bool(glass.get("xray", False))

    kb_layout = sys_cfg.get("kb_layout", "us,ru")
    kb_toggle = sys_cfg.get("kb_toggle", "grp:alt_shift_toggle")

    # Lua active_border & keyword string
    if mode == "solid":
        col_active_str = f"rgb({b_active})"
        lua_active_border = f'"rgb({b_active})"'
    elif mode == "dual_gradient":
        col_active_str = f"rgb({b_active}) rgb({b_sec}) {angle}deg"
        lua_active_border = f'{{ colors = {{"rgb({b_active})", "rgb({b_sec})"}}, angle = {angle} }}'
    elif mode == "neon_loop":
        col_active_str = f"rgb({b_active}) rgb({b_sec}) rgb({b_crit}) rgb({b_active}) {angle}deg"
        lua_active_border = f'{{ colors = {{"rgb({b_active})", "rgb({b_sec})", "rgb({b_crit})", "rgb({b_active})"}}, angle = {angle} }}'
    else:  # glow_shadow
        col_active_str = f"rgb({b_active})"
        lua_active_border = f'"rgb({b_active})"'

    col_inactive_str = f"rgb({b_inactive})"
    shadow_col_str = f"rgba({glow_col}66)"
    glow_enabled = "true" if mode in ("glow_shadow", "neon_loop") else "false"
    shadow_enabled = "true" if (mode in ("glow_shadow", "neon_loop") or blur) else "false"
    blur_str = "true" if blur else "false"
    xray_str = "true" if xray else "false"
    anim_enabled = "false" if anim == "disabled" else "true"
    loop_anim = "true" if mode == "neon_loop" else "false"

    os.makedirs(os.path.dirname(HYPR_LUA_THEME), exist_ok=True)
    lua_content = f"""-- ==============================================================================
-- KORTEX-OS LIVE GENERATED HYPRLAND 0.57+ LUA THEME
-- Managed by Kortex Unified Design & Persistence Engine
-- ==============================================================================

hl.config({{
    general = {{
        border_size = {border_size},
        gaps_in = {gaps_in},
        gaps_out = {gaps_out},
        col = {{
            active_border = {lua_active_border},
            inactive_border = "{col_inactive_str}",
        }},
    }},
    decoration = {{
        rounding = {rounding},
        active_opacity = {act_op:.2f},
        inactive_opacity = {inact_op:.2f},
        shadow = {{
            enabled = {shadow_enabled},
            range = {glow_radius},
            render_power = 3,
            color = "{shadow_col_str}",
        }},
        glow = {{
            enabled = {glow_enabled},
            range = {glow_radius},
            render_power = 3,
            color = "{shadow_col_str}",
        }},
        blur = {{
            enabled = {blur_str},
            size = {blur_size},
            passes = {blur_passes},
            new_optimizations = true,
            xray = {xray_str},
            vibrancy = {blur_vibrancy:.4f},
        }},
    }},
    animations = {{
        enabled = {anim_enabled},
    }},
    input = {{
        kb_layout = "{kb_layout}",
        kb_options = "{kb_toggle}",
    }},
}})

hl.animation({{ leaf = "borderangle", enabled = {loop_anim}, speed = 28, bezier = "linear", style = "loop" }})
"""
    with open(HYPR_LUA_THEME, "w", encoding="utf-8") as lf:
        lf.write(lua_content)

    # Also write legacy theme.conf for reference
    with open(HYPR_THEME, "w", encoding="utf-8") as f:
        f.write(f"# Kortex Theme Snapshot\n# border_size={border_size} rounding={rounding} mode={mode}\n")

    # Apply live via hyprctl eval (native Hyprland 0.57+ Lua VM)
    try:
        subprocess.run(
            ["hyprctl", "eval", f"pcall(dofile, '{HYPR_LUA_THEME}')"],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3
        )
    except Exception:
        pass

    # Also run keyword batch fallback
    batch_cmds = [
        f"keyword general:border_size {border_size}",
        f"keyword general:col.active_border '{col_active_str}'",
        f"keyword general:col.inactive_border '{col_inactive_str}'",
        f"keyword general:gaps_in {gaps_in}",
        f"keyword general:gaps_out {gaps_out}",
        f"keyword decoration:rounding {rounding}",
        f"keyword decoration:active_opacity {act_op:.2f}",
        f"keyword decoration:inactive_opacity {inact_op:.2f}",
        f"keyword decoration:blur:enabled {blur_str}",
        f"keyword decoration:blur:size {blur_size}",
        f"keyword decoration:blur:passes {blur_passes}",
        f"keyword decoration:blur:xray {xray_str}",
        f"keyword decoration:blur:vibrancy {blur_vibrancy:.4f}",
        f"keyword decoration:shadow:enabled {shadow_enabled}",
        f"keyword decoration:shadow:range {glow_radius}",
    ]
    try:
        subprocess.run(["hyprctl", "--batch", " ; ".join(batch_cmds)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except Exception:
        pass

def apply_waybar(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})
    phil = st.get("interface", {}).get("philosophy", "cyberdeck")

    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    crit = pal.get("alert_critical", "#ff003c")
    b_act = pal.get("border_active", "#00f0ff")

    rnd = int(borders.get("rounding", 6))
    op_panel = float(glass.get("opacity_panels", 0.90))

    r, g, b = hex_to_rgb(base)
    bg_rgba = f"rgba({r}, {g}, {b}, {op_panel:.2f})"
    r_s, g_s, b_s = hex_to_rgb(surf)
    surf_rgba = f"rgba({r_s}, {g_s}, {b_s}, {min(1.0, op_panel + 0.05):.2f})"

    mac_island = f"""
    margin: 6px 12px 0px 12px;
    border-radius: {max(10, rnd)}px;
    border: 1px solid {b_act};
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
""" if phil == "macbook" else f"""
    border-bottom: 2px solid {b_act};
    margin: 0px;
    border-radius: 0px;
"""

    css = f"""/* ==========================================================================
   KORTEX-OS LIVE GENERATED WAYBAR STYLESHEET
   Philosophy: {phil.upper()}
   ========================================================================== */

* {{
    border: none;
    border-radius: 0;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    min-height: 0;
}}

window#waybar {{
    background: {bg_rgba};
    color: #e6edf3;
{mac_island}
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}}

#custom-menu, #custom-logo {{
    background: {pri};
    color: {base};
    padding: 0 10px;
    margin: 3px 4px;
    border-radius: {rnd}px;
    font-weight: 900;
    letter-spacing: 1px;
}}

#custom-layout, #custom-spotlight, #custom-control-center, #custom-guide, #custom-store, #custom-ai, #custom-settings, #custom-guard {{
    background: {surf_rgba};
    color: {pri};
    border: 1px solid {sec};
    border-radius: {rnd}px;
    padding: 0 8px;
    margin: 3px 2px;
}}

#custom-win-min, #custom-win-max, #custom-win-close {{
    background: {surf_rgba};
    color: #c9d1d9;
    border-radius: {rnd}px;
    padding: 0 7px;
    margin: 3px 2px;
    border: 1px solid rgba(255, 255, 255, 0.14);
}}

#custom-win-close:hover {{
    background: {crit};
    color: #ffffff;
    border-color: {crit};
}}

#custom-win-max:hover, #custom-win-min:hover {{
    background: {sec};
    color: #ffffff;
}}

#workspaces button, #taskbar button {{
    padding: 0 8px;
    margin: 3px 2px;
    color: #8b949e;
    border-radius: {rnd}px;
    background: transparent;
}}

#workspaces button.active, #taskbar button.active {{
    color: {base};
    background: {pri};
}}

#clock, #battery, #cpu, #memory, #disk, #pulseaudio, #network, #custom-plugins, #custom-help {{
    background: {surf_rgba};
    color: {pri};
    border-radius: {rnd}px;
    padding: 0 9px;
    margin: 3px 2px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}}

#clock {{
    color: #ffffff;
    border-color: {pri};
}}
"""
    os.makedirs(os.path.dirname(WAYBAR_STYLE), exist_ok=True)
    with open(WAYBAR_STYLE, "w", encoding="utf-8") as f:
        f.write(css)

    dock_css = f"""/* KORTEX-OS MACBOOK PRO INTERACTIVE GLASS DOCK */
* {{
    border: none;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 800;
}}
window#waybar {{
    background: {bg_rgba};
    border: 2px solid {b_act};
    border-radius: {max(14, rnd)}px;
    margin: 0px 0px 8px 0px;
    padding: 4px 10px;
}}
#custom-dock-launchpad, #custom-dock-term, #custom-dock-browser, #custom-dock-files,
#custom-dock-gram, #custom-dock-ai, #custom-dock-music, #custom-dock-store,
#custom-dock-settings, #custom-dock-ctrl, #custom-dock-install {{
    background: {surf_rgba};
    color: {pri};
    border: 1px solid {sec};
    border-radius: {max(8, rnd)}px;
    padding: 4px 12px;
    margin: 4px 4px;
}}
#custom-dock-launchpad:hover, #custom-dock-term:hover, #custom-dock-browser:hover,
#custom-dock-files:hover, #custom-dock-gram:hover, #custom-dock-ai:hover,
#custom-dock-music:hover, #custom-dock-store:hover, #custom-dock-settings:hover,
#custom-dock-ctrl:hover, #custom-dock-install:hover {{
    background: {pri};
    color: {base};
}}
"""
    with open(WAYBAR_DOCK_STYLE, "w", encoding="utf-8") as f:
        f.write(dock_css)

    subprocess.run("pkill -SIGUSR2 waybar 2>/dev/null || true", shell=True)

def apply_kitty(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    glass = th.get("glass", {})

    base = pal.get("base_bg", "#0a0c10")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    crit = pal.get("alert_critical", "#ff003c")
    act_op = float(glass.get("opacity_active", 0.95))

    kitty_theme_content = f"""# Kortex Live Theme
background {base}
foreground #e6edf3
background_opacity {act_op:.2f}

cursor {pri}
cursor_text_color {base}
selection_background {sec}
selection_foreground #ffffff

color0 {base}
color8 #484f58
color1 {crit}
color9 #ff6b81
color2 #00ff41
color10 #7bed9f
color3 #ffb000
color11 #eccc68
color4 {sec}
color12 {pri}
color5 #b537f2
color13 #e056fd
color6 {pri}
color14 #70a1ff
color7 #c9d1d9
color15 #ffffff
"""
    os.makedirs(os.path.dirname(KITTY_THEME), exist_ok=True)
    with open(KITTY_THEME, "w", encoding="utf-8") as f:
        f.write(kitty_theme_content)

    subprocess.run("kill -SIGUSR1 $(pidof kitty) 2>/dev/null || true", shell=True)

def apply_rofi(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})

    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    crit = pal.get("alert_critical", "#ff003c")
    b_act = pal.get("border_active", "#00f0ff")
    rnd = int(borders.get("rounding", 6))
    op = float(glass.get("opacity_panels", 0.90))

    r, g, b = hex_to_rgb(base)
    bg_rgba = f"rgba({r}, {g}, {b}, {op:.2f})"
    r_s, g_s, b_s = hex_to_rgb(surf)
    surf_rgba = f"rgba({r_s}, {g_s}, {b_s}, {min(1.0, op + 0.05):.2f})"

    rasi = f"""/**
 * KORTEX-OS LIVE ROFI / SPOTLIGHT THEME
 */
* {{
    bg-base: {bg_rgba};
    bg-surface: {surf_rgba};
    accent-pri: {pri};
    accent-sec: {sec};
    alert-crit: {crit};
    text-main: #ffffff;
    text-dim: #8b949e;
    border-col: {b_act};
    rounding: {rnd}px;
}}
"""
    os.makedirs(os.path.dirname(ROFI_THEME), exist_ok=True)
    with open(ROFI_THEME, "w", encoding="utf-8") as f:
        f.write(rasi)

def apply_gtk(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    crit = pal.get("alert_critical", "#ff003c")

    gtk_css = f"""@define-color theme_bg_color {base};
@define-color theme_base_color {surf};
@define-color theme_selected_bg_color {pri};
@define-color theme_selected_fg_color {base};
@define-color theme_fg_color #e6edf3;
@define-color theme_text_color #e6edf3;
@define-color error_color {crit};
@define-color warning_color {sec};
@define-color theme_view_hover_decoration_color {pri};
"""
    for p in [GTK3_CSS, GTK4_CSS]:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        try:
            with open(p, "w", encoding="utf-8") as f:
                f.write(gtk_css)
        except Exception:
            pass

def apply_qt(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    base = "#" + clean_hex(pal.get("base_bg", "#0a0c10"))
    surf = "#" + clean_hex(pal.get("surface_bg", "#12161f"))
    pri = "#" + clean_hex(pal.get("primary_accent", "#00f0ff"))
    sec = "#" + clean_hex(pal.get("secondary_accent", "#0088cc"))
    inact = "#" + clean_hex(pal.get("border_inactive", "#1b2430"))

    qt_scheme = f"""[ColorScheme]
active_colors=#ffe6edf3, {surf}, {surf}, {inact}, #ff050608, {inact}, #ffe6edf3, #ffffffff, #ffe6edf3, {base}, {base}, #ff000000, {pri}, {base}, {sec}, {pri}, {surf}, #ff000000, {surf}, #ffe6edf3, #80e6edf3
disabled_colors=#ff6e7681, {surf}, {surf}, {inact}, #ff050608, {inact}, #ff6e7681, #ffffffff, #ff6e7681, {base}, {base}, #ff000000, {inact}, #ff6e7681, {sec}, {pri}, {surf}, #ff000000, {surf}, #ff6e7681, #806e7681
inactive_colors=#ff8b949e, {surf}, {surf}, {inact}, #ff050608, {inact}, #ff8b949e, #ffffffff, #ff8b949e, {base}, {base}, #ff000000, {sec}, {base}, {sec}, {pri}, {surf}, #ff000000, {surf}, #ff8b949e, #808b949e
"""
    for cpath, cfg_path in [(QT5_COLORS, QT5_CONF), (QT6_COLORS, QT6_CONF)]:
        os.makedirs(os.path.dirname(cpath), exist_ok=True)
        try:
            with open(cpath, "w", encoding="utf-8") as f:
                f.write(qt_scheme)
            with open(cfg_path, "w", encoding="utf-8") as f:
                f.write(f"[Appearance]\ncolor_scheme_path={cpath}\ncustom_palette=true\nstyle=Fusion\n")
        except Exception:
            pass

    r_b, g_b, b_b = hex_to_rgb(base)
    r_s, g_s, b_s = hex_to_rgb(surf)
    r_p, g_p, b_p = hex_to_rgb(pri)
    kde_content = f"""[Colors:Window]
BackgroundNormal={r_b},{g_b},{b_b}
BackgroundAlternate={r_s},{g_s},{b_s}
ForegroundNormal=230,237,243
DecorationFocus={r_p},{g_p},{b_p}

[Colors:Selection]
BackgroundNormal={r_p},{g_p},{b_p}
ForegroundNormal={r_b},{g_b},{b_b}
"""
    try:
        os.makedirs(os.path.dirname(KDE_GLOBALS), exist_ok=True)
        with open(KDE_GLOBALS, "w", encoding="utf-8") as f:
            f.write(kde_content)
    except Exception:
        pass

def main():
    st = load_master()

    args = sys.argv[1:]
    idx = 0
    while idx < len(args):
        a = args[idx]
        if a in ("--theme", "-t", "--preset", "-p", "preset") and idx + 1 < len(args):
            t_key = args[idx+1].lower()
            if t_key in THEME_PRESETS:
                p = THEME_PRESETS[t_key]
                st["theme"]["name"] = t_key
                for k_col in ("base_bg", "surface_bg", "primary_accent", "secondary_accent", "border_active", "border_inactive", "alert_critical"):
                    st["theme"]["palette"][k_col] = p[k_col]
            idx += 2
        elif a in ("--list", "-v", "list"):
            print("Available KortexOS Themes:")
            for k, v in THEME_PRESETS.items():
                print(f"  * {k:12} : {v['name']} ({v['primary_accent']})")
            sys.exit(0)
        elif a in ("--layout", "-l") and idx + 1 < len(args):
            l_key = args[idx+1].lower()
            if l_key in ("cyberdeck", "macbook", "tiling", "grid", "floating"):
                mapped = "cyberdeck" if l_key == "grid" else ("macbook" if l_key == "floating" else l_key)
                st["interface"]["philosophy"] = mapped
            idx += 2
        elif a in ("--accent", "-a") and idx + 1 < len(args):
            col = "#" + clean_hex(args[idx+1])
            st["theme"]["palette"]["primary_accent"] = col
            st["theme"]["palette"]["border_active"] = col
            idx += 2
        elif a in ("--opacity", "-o") and idx + 1 < len(args):
            val = float(args[idx+1])
            if val > 1.0:
                val /= 100.0
            st["theme"]["glass"]["opacity_active"] = max(0.5, min(1.0, val))
            idx += 2
        elif a in ("--blur", "-b") and idx + 1 < len(args):
            st["theme"]["glass"]["blur_enabled"] = args[idx+1].lower() in ("1", "true", "yes", "on")
            idx += 2
        elif a in ("--border-mode",) and idx + 1 < len(args):
            m = args[idx+1].lower()
            if m in ("solid", "dual_gradient", "neon_loop", "glow_shadow"):
                st["theme"]["borders"]["mode"] = m
            idx += 2
        elif a in ("--reset",):
            st = json.loads(json.dumps(DEFAULT_MASTER))
            idx += 1
        else:
            idx += 1

    save_master(st)

    env = get_hypr_env()
    apply_hyprland(st, env)
    apply_waybar(st)
    apply_kitty(st)
    apply_rofi(st)
    apply_gtk(st)
    apply_qt(st)

    print("[+] KORTEX THEME ENGINE: Live configurations synchronized across Hyprland, Waybar, Kitty, Rofi, GTK & Qt.")

if __name__ == "__main__":
    main()
