#!/usr/bin/env python3
"""
KORTEX-THEME-APPLY: Unified Design, Geometry & Persistence Generator
Transforms ~/.config/kortex/master-state.json into live synchronized configurations for:
- Hyprland (theme.conf + live hyprctl keyword updates)
- Waybar (style.css + SIGUSR2 reload)
- Kitty (theme.conf + SIGUSR1 reload)
- Rofi (theme.rasi)
- GTK-3 & GTK-4 (gtk.css)
"""

import sys
import os
import json
import glob
import subprocess
import shutil

