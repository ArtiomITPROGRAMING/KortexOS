def clean_hex(color_str):
    if not color_str:
        return "00f0ff"
    s = color_str.strip().lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    return s[:6] if len(s) >= 6 else "00f0ff"

def hex_to_rgb(hex_code):
    h = clean_hex(hex_code)
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)

def hex_to_rgba_str(hex_code, alpha=1.0):
    r, g, b = hex_to_rgb(hex_code)
    return f"rgba({r}, {g}, {b}, {alpha:.2f})"

def hex_to_hypr_rgba(hex_code, alpha_hex="ff"):
    h = clean_hex(hex_code)
    return f"rgba({h}{alpha_hex})"

def load_master():
    os.makedirs(CONF_DIR, exist_ok=True)
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                d = json.load(f)
                res = DEFAULT_MASTER.copy()
                for k, v in d.items():
                    if isinstance(v, dict) and k in res:
                        res[k].update(v)
                    else:
                        res[k] = v
                return res
        except Exception:
            pass
    return DEFAULT_MASTER.copy()

def save_master(st):
    os.makedirs(CONF_DIR, exist_ok=True)
    os.makedirs(BACKUP_DIR, exist_ok=True)
    try:
        with open(MASTER_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        # Also mirror into legacy config.json for backwards compatibility
        with open(LEGACY_STATE, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        # Automatic persistence snapshot
        snap = os.path.join(BACKUP_DIR, "latest-persistence.json")
        shutil.copy2(MASTER_STATE, snap)
    except Exception as e:
        print(f"[-] Persistence save error: {e}")

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hdir = f"{env['XDG_RUNTIME_DIR']}/hypr"
        if os.path.exists(hdir):
            sigs = os.listdir(hdir)
            if sigs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]
    return env

def hypr_keyword(key, val, env):
    try:
        subprocess.run(["hyprctl", "keyword", key, str(val)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

def apply_hyprland(st, env):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})
    anim = th.get("animations", {}).get("mode", "smooth")
    gestures = st.get("interface", {}).get("gestures", True)

    b_active = clean_hex(pal.get("border_active", "#00f0ff"))
    b_inactive = clean_hex(pal.get("border_inactive", "#1b2430"))
    b_sec = clean_hex(pal.get("secondary_accent", "#0088cc"))
    glow_col = clean_hex(pal.get("primary_accent", "#00f0ff"))

    border_size = int(borders.get("size", 2))
    rounding = int(borders.get("rounding", 6))
    gaps_in = int(borders.get("gaps_in", 6))
    gaps_out = int(borders.get("gaps_out", 10))
    mode = borders.get("mode", "dual_gradient")
    angle = int(borders.get("gradient_angle", 45))
    glow_radius = int(borders.get("glow_radius", 15))

    act_op = float(glass.get("opacity_active", 0.95))
    inact_op = float(glass.get("opacity_inactive", 0.85))
    blur = bool(glass.get("blur_enabled", True))
    blur_size = int(glass.get("blur_size", 8))
    blur_passes = int(glass.get("blur_passes", 3))
    blur_vibrancy = float(glass.get("blur_vibrancy", 0.1696))
    xray = bool(glass.get("xray", False))

    # Border configuration string based on mode
    if mode == "solid":
        col_active_str = f"rgb({b_active})"
    elif mode == "dual_gradient":
        col_active_str = f"rgb({b_active}) rgb({b_sec}) {angle}deg"
    elif mode == "neon_loop":
        col_active_str = f"rgb({b_active}) rgb({b_sec}) rgb({b_active}) 45deg"
    elif mode == "glow_shadow":
        col_active_str = f"rgb({b_active})"
    else:
        col_active_str = f"rgb({b_active})"

    col_inactive_str = f"rgb({b_inactive})"
    shadow_col_str = f"rgba({glow_col}55)"

    # Write ~/.config/hypr/theme.conf
    os.makedirs(os.path.dirname(HYPR_THEME), exist_ok=True)
    content = f"""# ==============================================================================
# KORTEX-OS LIVE GENERATED THEME & GEOMETRY
# Managed by Kortex Unified Design & Persistence Engine
# ==============================================================================

# Variables
$col_active = {col_active_str}
$col_inactive = {col_inactive_str}
$col_shadow = {shadow_col_str}

$border_size = {border_size}
$rounding = {rounding}
$gaps_in = {gaps_in}
$gaps_out = {gaps_out}

$active_opacity = {act_op:.2f}
$inactive_opacity = {inact_op:.2f}

# General Layout
general {{
    gaps_in = $gaps_in
    gaps_out = $gaps_out
    border_size = $border_size
    col.active_border = $col_active
    col.inactive_border = $col_inactive
    layout = dwindle
}}

# Decoration & Glassmorphism
decoration {{
    rounding = $rounding
    active_opacity = $active_opacity
    inactive_opacity = $inactive_opacity
    
    shadow {{
        enabled = {'true' if mode == 'glow_shadow' or blur else 'false'}
        range = {glow_radius}
        render_power = 3
        color = $col_shadow
    }}

    blur {{
        enabled = {'true' if blur else 'false'}
        size = {blur_size}
        passes = {blur_passes}
        new_optimizations = true
        xray = {'true' if xray else 'false'}
        vibrancy = {blur_vibrancy:.4f}
    }}
}}

# Gestures (MacBook 3-Finger Swipe)
gestures {{
    workspace_swipe = {'true' if gestures else 'false'}
    workspace_swipe_fingers = 3
    workspace_swipe_distance = 300
    workspace_swipe_invert = true
    workspace_swipe_min_speed_to_force = 30
    workspace_swipe_cancel_ratio = 0.5
}}

# Per-App Transparency & Behavior Rules
windowrulev2 = opacity 1.0 1.0, class:^(firefox|chromium|google-chrome)$
windowrulev2 = opacity 0.92 0.85, class:^(Code|vscodium)$
windowrulev2 = opacity 0.90 0.80, class:^(thunar|nemo|dolphin)$
windowrulev2 = float, class:^(kortex-settings|kortex-help|kortex-oobe)$
windowrulev2 = center, class:^(kortex-settings|kortex-help|kortex-oobe)$
"""
    with open(HYPR_THEME, "w", encoding="utf-8") as f:
        f.write(content)

    # Single batch call for instant zero-lag IPC apply
    batch_cmds = [
        f"keyword general:border_size {border_size}",
        f"keyword general:col.active_border '{col_active_str}'",
        f"keyword general:col.inactive_border '{col_inactive_str}'",
        f"keyword general:gaps_in {gaps_in}",
        f"keyword general:gaps_out {gaps_out}",
        f"keyword decoration:rounding {rounding}",
        f"keyword decoration:active_opacity {act_op}",
        f"keyword decoration:inactive_opacity {inact_op}",
        f"keyword decoration:blur:enabled {'true' if blur else 'false'}",
        f"keyword decoration:blur:size {blur_size}",
        f"keyword decoration:blur:passes {blur_passes}",
        f"keyword gestures:workspace_swipe {'true' if gestures else 'false'}"
    ]
    if anim == "disabled":
        batch_cmds.append("keyword animations:enabled false")
    else:
        batch_cmds.append("keyword animations:enabled true")
        speed = 2 if anim == "fast" else 4
        batch_cmds.append(f"keyword animations:animation 'windows, 1, {speed}, default'")
        batch_cmds.append(f"keyword animations:animation 'workspaces, 1, {speed}, default'")

    batch_str = " ; ".join(batch_cmds)
    try:
        subprocess.run(["hyprctl", "--batch", batch_str], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except Exception:
        pass

def apply_waybar(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})
    phil = st.get("interface", {}).get("philosophy", "cyberdeck")

    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    crit = pal.get("alert_critical", "#ff003c")
    b_act = pal.get("border_active", "#00f0ff")
    
    rnd = int(borders.get("rounding", 6))
    op_panel = float(glass.get("opacity_panels", 0.90))

    # Frosted glass background for waybar
    r, g, b = hex_to_rgb(base)
    bg_rgba = f"rgba({r}, {g}, {b}, {op_panel:.2f})"
    r_s, g_s, b_s = hex_to_rgb(surf)
    surf_rgba = f"rgba({r_s}, {g_s}, {b_s}, {min(1.0, op_panel + 0.05):.2f})"

    mac_island = """
    margin: 6px 12px 0px 12px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
""" if phil == "macbook" else f"""
    border-bottom: 2px solid {b_act};
    margin: 0px;
    border-radius: 0px;
"""

    css = f"""/* ==========================================================================
   KORTEX-OS LIVE GENERATED WAYBAR STYLESHEET
   Philosophy: {phil.upper()}
   ========================================================================== */

* {{
    border: none;
    border-radius: 0;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    min-height: 0;
}}

window#waybar {{
    background: {bg_rgba};
    color: #e6edf3;
{mac_island}
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}}

#custom-logo {{
    background: {pri};
    color: {base};
    padding: 0 10px;
    margin: 3px 6px;
    border-radius: {rnd}px;
    font-weight: 900;
    letter-spacing: 1px;
}}

#custom-layout {{
    background: {surf_rgba};
    color: {pri};
    border: 1px solid {pri};
    border-radius: {rnd}px;
    padding: 0 8px;
    margin: 3px 4px;
}}

#custom-win-min, #custom-win-max, #custom-win-close {{
    background: {surf_rgba};
    color: #8b949e;
    border-radius: {rnd}px;
    padding: 0 7px;
    margin: 3px 2px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}}

#custom-win-close:hover {{
    background: {crit};
    color: #ffffff;
    border-color: {crit};
}}

#custom-win-max:hover, #custom-win-min:hover {{
    background: {sec};
    color: #ffffff;
}}

#workspaces button {{
    padding: 0 8px;
    margin: 3px 2px;
    color: #8b949e;
    border-radius: {rnd}px;
    background: transparent;
}}

#workspaces button.active {{
    color: {base};
    background: {pri};
    box-shadow: 0 0 10px {pri};
}}

#clock, #battery, #cpu, #memory, #pulseaudio, #network, #custom-plugins, #custom-help {{
    background: {surf_rgba};
    color: {pri};
    border-radius: {rnd}px;
    padding: 0 10px;
    margin: 3px 3px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}}

#clock {{
    color: #ffffff;
    border-color: {pri};
}}

#custom-plugins {{
    color: {sec};
}}
"""
    os.makedirs(os.path.dirname(WAYBAR_STYLE), exist_ok=True)
    with open(WAYBAR_STYLE, "w", encoding="utf-8") as f:
        f.write(css)

    # Signal Waybar to reload
    subprocess.run("pkill -SIGUSR2 waybar 2>/dev/null || true", shell=True)

def apply_kitty(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    glass = st.get("theme", {}).get("glass", {})

    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    crit = pal.get("alert_critical", "#ff003c")
    act_op = float(glass.get("opacity_active", 0.95))

    kitty_theme_content = f"""# Kortex Live Theme
background {base}
foreground #e6edf3
background_opacity {act_op:.2f}

cursor {pri}
cursor_text_color {base}
selection_background {sec}
selection_foreground #ffffff

# Black
color0 {base}
color8 #484f58

# Red
color1 {crit}
color9 #ff6b81

# Green
color2 #00ff41
color10 #7bed9f

# Yellow
color3 #ffb000
color11 #eccc68

# Blue / Cyan
color4 {sec}
color12 {pri}

# Magenta
color5 #b537f2
color13 #e056fd

# Cyan
color6 {pri}
color14 #70a1ff

# White
color7 #c9d1d9
color15 #ffffff
"""
    os.makedirs(os.path.dirname(KITTY_THEME), exist_ok=True)
    with open(KITTY_THEME, "w", encoding="utf-8") as f:
        f.write(kitty_theme_content)

    # Signal kitty instances
    subprocess.run("kill -SIGUSR1 $(pidof kitty) 2>/dev/null || true", shell=True)

def apply_rofi(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    borders = th.get("borders", {})
    glass = th.get("glass", {})

    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")
    sec = pal.get("secondary_accent", "#0088cc")
    rnd = int(borders.get("rounding", 6))
    op = float(glass.get("opacity_panels", 0.90))

    r, g, b = hex_to_rgb(base)
    bg_rgba = f"rgba({r}, {g}, {b}, {op:.2f})"
    r_s, g_s, b_s = hex_to_rgb(surf)
    surf_rgba = f"rgba({r_s}, {g_s}, {b_s}, {min(1.0, op + 0.05):.2f})"

    rasi = f"""/**
 * KORTEX-OS LIVE ROFI / SPOTLIGHT THEME
 */
* {{
    bg-base: {bg_rgba};
    bg-surface: {surf_rgba};
    accent-pri: {pri};
    accent-sec: {sec};
    text-main: #ffffff;
    text-dim: #8b949e;
    border-col: {pri};
    rounding: {rnd}px;
}}
"""
    os.makedirs(os.path.dirname(ROFI_THEME), exist_ok=True)
    with open(ROFI_THEME, "w", encoding="utf-8") as f:
        f.write(rasi)

def apply_gtk(st):
    th = st.get("theme", {})
    pal = th.get("palette", {})
    base = pal.get("base_bg", "#0a0c10")
    surf = pal.get("surface_bg", "#12161f")
    pri = pal.get("primary_accent", "#00f0ff")

    gtk_css = f"""@define-color theme_bg_color {base};
@define-color theme_base_color {base};
@define-color theme_selected_bg_color {pri};
@define-color theme_selected_fg_color {base};
@define-color theme_fg_color #e6edf3;
@define-color theme_view_hover_decoration_color {pri};
"""
    for p in [GTK3_CSS, GTK4_CSS]:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        try:
            with open(p, "w", encoding="utf-8") as f:
                f.write(gtk_css)
        except Exception:
            pass

def main():
    st = load_master()

    # Allow CLI overrides:
    # --theme <cyan|matrix|amber|mono|crimson>
    # --preset <name>
    # --layout <cyberdeck|macbook|tiling>
    # --accent <hex>
    # --opacity <0.5-1.0>
    # --blur <true|false>
    args = sys.argv[1:]
    idx = 0
    while idx < len(args):
        a = args[idx]
        if a in ("--theme", "-t", "--preset", "-p", "preset") and idx + 1 < len(args):
            t_key = args[idx+1].lower()
            if t_key in THEME_PRESETS:
                p = THEME_PRESETS[t_key]
                st["theme"]["name"] = t_key
                st["theme"]["palette"].update(p)
            idx += 2
        elif a in ("--list", "-v", "list"):
            print("Available KortexOS Themes:")
            for k, v in THEME_PRESETS.items():
                print(f"  * {k:12} : {v['name']} ({v['primary_accent']})")
            sys.exit(0)
        elif a in ("--layout", "-l") and idx + 1 < len(args):
            l_key = args[idx+1].lower()
            if l_key in ("cyberdeck", "macbook", "tiling", "grid", "floating"):
                mapped = "cyberdeck" if l_key == "grid" else ("macbook" if l_key == "floating" else l_key)
                st["interface"]["philosophy"] = mapped
            idx += 2
        elif a in ("--accent", "-a") and idx + 1 < len(args):
            col = "#" + clean_hex(args[idx+1])
            st["theme"]["palette"]["primary_accent"] = col
            st["theme"]["palette"]["border_active"] = col
            idx += 2
        elif a in ("--opacity", "-o") and idx + 1 < len(args):
            val = float(args[idx+1])
            if val > 1.0: val /= 100.0
            st["theme"]["glass"]["opacity_active"] = max(0.5, min(1.0, val))
            idx += 2
        elif a in ("--blur", "-b") and idx + 1 < len(args):
            st["theme"]["glass"]["blur_enabled"] = args[idx+1].lower() in ("1", "true", "yes", "on")
            idx += 2
        elif a in ("--reset",):
            st = DEFAULT_MASTER.copy()
            idx += 1
        else:
            idx += 1

    save_master(st)

    env = get_hypr_env()
    apply_hyprland(st, env)
    apply_waybar(st)
    apply_kitty(st)
    apply_rofi(st)
    apply_gtk(st)

    print("[+] KORTEX THEME ENGINE: Live configurations synchronized across Hyprland, Waybar, Kitty, Rofi & GTK.")

if __name__ == "__main__":
    main()
