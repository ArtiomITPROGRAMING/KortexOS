#!/usr/bin/env python3
"""
KORTEX-THEME-APPLY: Unified Design, Geometry & Persistence Generator
Transforms ~/.config/kortex/master-state.json into live synchronized configurations for:
- Hyprland 0.57+ (theme.lua + live hyprctl eval & keyword updates)
- Waybar (style.css + style-dock.css + SIGUSR2 reload)
- Kitty (theme.conf + SIGUSR1 reload)
- Rofi (theme.rasi)
- GTK-3 & GTK-4 (gtk.css)
- Qt5 & Qt6 (qt5ct/qt6ct color schemes + kdeglobals)
"""

