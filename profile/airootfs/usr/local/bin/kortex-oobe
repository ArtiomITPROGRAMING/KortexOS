#!/usr/bin/env python3
"""
KORTEX-OOBE: Fullscreen Initial Setup Wizard & Hardware Profiler
Runs on first boot when ~/.config/kortex/.setup_done does not exist.
Integrates MacBook UX + Cyberpunk Philosophy with persistent disk transfer.
"""

import sys
import os
import json
import time
import subprocess
import shutil

SETUP_FLAG = os.path.expanduser("~/.config/kortex/.setup_done")
MASTER_STATE = os.path.expanduser("~/.config/kortex/master-state.json")
BACKUP_DIR = os.path.expanduser("~/.config/kortex/profiles")

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hdir = f"{env['XDG_RUNTIME_DIR']}/hypr"
        if os.path.exists(hdir):
            sigs = os.listdir(hdir)
            if sigs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]
    return env

def clear_screen():
    print("\033[2J\033[H", end="", flush=True)

def print_banner(step_num, step_name):
    clear_screen()
    cyan = "\033[1;36m"
    white = "\033[1;37m"
    gray = "\033[0;90m"
    dim = "\033[2m"
    rst = "\033[0m"

    print(f"{cyan}╔══════════════════════════════════════════════════════════════════════════════╗{rst}")
    print(f"{cyan}║{white}      KORTEX-OS UNIFIED DESIGN & INITIAL SETUP WIZARD (OOBE)                 {cyan}║{rst}")
    print(f"{cyan}║{dim}      MacBook UX on Arch Linux + Cyber-Deck Architecture                      {cyan}║{rst}")
    print(f"{cyan}╠══════════════════════════════════════════════════════════════════════════════╣{rst}")
    print(f"{cyan}║{white}  STEP {step_num}/5 : {step_name.ljust(60)} {cyan}║{rst}")
    print(f"{cyan}╚══════════════════════════════════════════════════════════════════════════════╝{rst}\n")

def menu_select(options, prompt="Choose an option:"):
    cyan = "\033[1;36m"
    yellow = "\033[1;33m"
    rst = "\033[0m"

    print(f"{yellow}{prompt}{rst}\n")
    for idx, (label, desc) in enumerate(options, 1):
        print(f"  {cyan}[{idx}]{rst} \033[1m{label}\033[0m")
        if desc:
            print(f"      \033[0;90m{desc}\033[0m")
    print()

    while True:
        try:
            choice = input(f"Enter choice [1-{len(options)}] (Default: 1): ").strip()
            if not choice:
                return 0
            val = int(choice) - 1
            if 0 <= val < len(options):
                return val
            print("Invalid choice, please re-enter.")
        except (ValueError, KeyboardInterrupt, EOFError):
            return 0

def step_locale_and_keyboard(st):
    print_banner(1, "LANGUAGE, TIMEZONE & KEYBOARD")
    
    # 1. Language
    lang_opts = [
        ("English (US)", "Default global interface language"),
        ("Русский (RU)", "Полный перевод интерфейса и системных утилит"),
        ("Română (RO)", "Limba română pentru sistem și utilitare"),
        ("Deutsch (DE)", "Deutsche Systemsprache")
    ]
    c_lang = menu_select(lang_opts, "Select System Language:")
    langs = ["en", "ru", "ro", "de"]
    chosen_lang = langs[c_lang]
    st["system"]["language"] = chosen_lang

    # 2. Timezone
    tz_opts = [
        ("Europe/Chisinau", "Moldova Local Time (EET / EEST)"),
        ("Europe/Bucharest", "Romania Local Time (EET / EEST)"),
        ("UTC", "Universal Coordinated Time"),
        ("America/New_York", "Eastern Time (US)")
    ]
    c_tz = menu_select(tz_opts, "Select System Timezone:")
    tzs = ["Europe/Chisinau", "Europe/Bucharest", "UTC", "America/New_York"]
    chosen_tz = tzs[c_tz]
    st["system"]["timezone"] = chosen_tz
    try:
        subprocess.run(["timedatectl", "set-timezone", chosen_tz], stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # 3. Keyboard Layout & Toggle
    kb_opts = [
        ("US + Russian (Alt+Shift toggle)", "Standard EN/RU bilingual developer layout"),
        ("US + Romanian (Alt+Shift toggle)", "Standard EN/RO layout with diacritics"),
        ("US + German (Alt+Shift toggle)", "Standard EN/DE layout"),
        ("US Only (English)", "Clean single layout for strict developers")
    ]
    c_kb = menu_select(kb_opts, "Select Keyboard Layout & Switch Hotkey:")
    kbs = [
        ("us,ru", "grp:alt_shift_toggle"),
        ("us,ro", "grp:alt_shift_toggle"),
        ("us,de", "grp:alt_shift_toggle"),
        ("us", "")
    ]
    st["system"]["kb_layout"] = kbs[c_kb][0]
    st["system"]["kb_toggle"] = kbs[c_kb][1]

    # Live apply keyboard layout in Hyprland
    env = get_hypr_env()
    try:
        subprocess.run(["hyprctl", "keyword", "input:kb_layout", kbs[c_kb][0]], env=env, stderr=subprocess.DEVNULL)
        if kbs[c_kb][1]:
            subprocess.run(["hyprctl", "keyword", "input:kb_options", kbs[c_kb][1]], env=env, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def step_network_and_bluetooth(st):
    print_banner(2, "NETWORK & WIRELESS CONNECTIVITY")
    
    net_opts = [
        ("Quick Wi-Fi Connect (Scan nearby SSIDs)", "Scan and connect to local wireless network"),
        ("Interactive Network Manager (nmtui)", "Full terminal network control center"),
        ("Skip Network Setup", "Already connected via Ethernet or skip for now")
    ]
    c_net = menu_select(net_opts, "Wireless & Internet Configuration:")
    
    if c_net == 0:
        print("\n\033[1;36m[*] Scanning for Wi-Fi networks...\033[0m")
        try:
            res = subprocess.run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"], capture_output=True, text=True, timeout=5)
            lines = [l.strip() for l in res.stdout.splitlines() if l.strip()]
            if lines:
                wifi_opts = []
                for l in lines[:8]:
                    parts = l.split(":")
                    ssid = parts[0] or "<Hidden>"
                    sig = parts[1] if len(parts) > 1 else ""
                    sec = parts[2] if len(parts) > 2 else ""
                    wifi_opts.append((f"{ssid} ({sig}% signal)", f"Security: {sec}"))
                wifi_opts.append(("Skip Wi-Fi", "Do not connect now"))
                
                c_wifi = menu_select(wifi_opts, "Select Wi-Fi Network:")
                if c_wifi < len(wifi_opts) - 1:
                    target_ssid = lines[c_wifi].split(":")[0]
                    pwd = input(f"Enter password for '{target_ssid}' (or empty if open): ").strip()
                    if pwd:
                        subprocess.run(["nmcli", "device", "wifi", "connect", target_ssid, "password", pwd])
                    else:
                        subprocess.run(["nmcli", "device", "wifi", "connect", target_ssid])
            else:
                print("No Wi-Fi networks found or Wi-Fi adapter not active. Skipping.")
                time.sleep(1)
        except Exception as e:
            print(f"Network scan skipped: {e}")
            time.sleep(1)
    elif c_net == 1:
        subprocess.run(["nmtui"])

def step_interface_philosophy(st):
    print_banner(3, "INTERFACE PHILOSOPHY & WORKSPACE LAYOUT")
    
    phil_opts = [
        ("Cyber-Deck (eDEX 5-Panel Grid)", "Hacker command center: CPU pulse, network globe, terminal, file grid & virtual deck"),
        ("MacBook Pro Mode (Glass & Dock)", "macOS style: Frosted glass blur, floating windows with [ _ ][ □ ][ ✕ ] buttons & gestures"),
        ("Pure Tiling (Dev Mode)", "Strict full-screen dwindle tiling without distraction panels or on-screen keyboard")
    ]
    c_phil = menu_select(phil_opts, "Select Primary Desktop Experience:")
    phils = ["cyberdeck", "macbook", "tiling"]
    st["interface"]["philosophy"] = phils[c_phil]

    # Live apply layout
    if phils[c_phil] == "cyberdeck":
        subprocess.run(["/usr/local/bin/kortex-layout", "grid"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif phils[c_phil] == "macbook":
        subprocess.run(["/usr/local/bin/kortex-layout", "floating"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["/usr/local/bin/kortex-layout", "tiling"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def step_visual_style(st):
    print_banner(4, "THEME, GLASSMORPHISM & WALLPAPER")

    # 1. Color Palette Preset
    theme_opts = [
        ("Cyber Cyan (Tron Electric Blue)", "Hex: #00f0ff - Crisp electric futuristic glow"),
        ("Tokyo Night (Twilight Violet)", "Hex: #7aa2f7 - Deep indigo and neon lavender aesthetic"),
        ("Dracula Dark (Gothic Violet)", "Hex: #bd93f9 - High contrast purple and pink dark mode"),
        ("Matrix Phosphor (Terminal Green)", "Hex: #00ff41 - Classic hacker green monochrome"),
        ("Amber CRT (Vintage 80s Display)", "Hex: #ffb000 - Warm monochrome phosphor amber"),
        ("Mono Tron (Pure Stealth White)", "Hex: #ffffff - Minimalist high contrast monochrome"),
        ("Crimson Alert (Red Alert Combat)", "Hex: #ff003c - Aggressive military combat HUD")
    ]
    c_th = menu_select(theme_opts, "Select Core Color Palette:")
    themes = ["cyan", "tokyonight", "dracula", "matrix", "amber", "mono", "crimson"]
    chosen_theme = themes[c_th]

    # 2. Border Mode
    border_opts = [
        ("Dual Gradient (Cyber Edge)", "Two-color border with 45-degree angle transitions"),
        ("Solid Color", "Clean uniform solid accent border"),
        ("Animated Neon Loop", "Rotating continuous neon flow along window edges"),
        ("Glow Shadow (Neon Bloom)", "Diffused neon drop-shadow behind active windows")
    ]
    c_border = menu_select(border_opts, "Select Window Border Style:")
    b_modes = ["dual_gradient", "solid", "neon_loop", "glow_shadow"]
    st["theme"]["borders"]["mode"] = b_modes[c_border]

    # 3. Wallpaper
    wall_opts = [
        ("Cyber Grid (Vector Tech Canvas)", "Crisp high-resolution digital blueprint grid"),
        ("Cyber Glass (MacBook Multi-Mesh)", "Deep blue and violet radial glow for glassmorphism"),
        ("Pitch Black (OLED Zero)", "Pure #000000 space background for maximum focus")
    ]
    c_wall = menu_select(wall_opts, "Select Default Desktop Wallpaper:")
    walls = ["grid", "glass", "black"]
    subprocess.run(["/usr/local/bin/kortex-wallpaper", "desktop", walls[c_wall]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Apply chosen theme immediately
    subprocess.run(["/usr/local/bin/kortex-theme-apply", "--theme", chosen_theme], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def step_hardware_and_persistence(st):
    print_banner(5, "HARDWARE PROFILE & DISK INSTALLATION")

    pwr_opts = [
        ("Balanced (Default Recommended)", "Optimal balance between battery life, thermals and 60fps animations"),
        ("Overdrive (Performance Mode)", "Unrestricted CPU governor, instant animations, maximum frame rates"),
        ("Eco Mode (Battery Saver)", "Powersave CPU governor, animations disabled for extended mobile runtime")
    ]
    c_pwr = menu_select(pwr_opts, "Select Hardware Power & Performance Profile:")
    pwrs = ["balanced", "performance", "powersave"]
    st["system"]["power_profile"] = pwrs[c_pwr]

    # Apply power profile if cpupower is installed
    try:
        subprocess.run(["cpupower", "frequency-set", "-g", pwrs[c_pwr]], stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # Save final master state
    os.makedirs(os.path.dirname(MASTER_STATE), exist_ok=True)
    with open(MASTER_STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)

    print("\n\033[1;32m[✓] All customization parameters saved to permanent Master State!\033[0m\n")

    # Install options
    inst_opts = [
        ("Save & Start KortexOS Live Session", "Begin using KortexOS immediately with all chosen settings"),
        ("INSTALL TO DISK (WITH CURRENT SETTINGS)", "Transfer live settings directly into target hard drive installation!")
    ]
    c_inst = menu_select(inst_opts, "Ready to proceed:")
    
    if c_inst == 1:
        print("\n\033[1;36m[*] Launching KortexOS System Installer with automated settings persistence...\033[0m")
        # Ensure persistence directory exists for installer hook
        os.makedirs("/run/kortex-persistence", exist_ok=True)
        shutil.copy2(MASTER_STATE, "/run/kortex-persistence/master-state.json")
        time.sleep(1)
        if os.path.exists("/usr/local/bin/kortex-install"):
            subprocess.run(["/usr/local/bin/kortex-install"])
        else:
            print("[*] Target disk installer initiated.")
            time.sleep(2)

    # Touch setup done flag
    with open(SETUP_FLAG, "w", encoding="utf-8") as f:
        f.write(f"Setup completed at: {time.ctime()}\n")

    clear_screen()
    print("\n\033[1;32m====================================================================\033[0m")
    print("\033[1;37m        KORTEX-OS INITIAL SETUP COMPLETE! WELCOME ABOARD.           \033[0m")
    print("\033[1;32m====================================================================\033[0m")
    print("  • Press \033[1;36mSuper + Space\033[0m anytime for Kortex Spotlight")
    print("  • Press \033[1;36mSuper + Tab\033[0m to toggle between Cyber-Deck, MacBook & Tiling")
    print("  • Press \033[1;36mSuper + F1\033[0m for complete Hotkey Cheatsheet HUD\n")
    time.sleep(2)

def main():
    # If called with --force, rerun even if .setup_done exists
    if "--force" not in sys.argv and os.path.exists(SETUP_FLAG):
        print("[*] KortexOS OOBE already completed. Use 'kortex-oobe --force' to rerun.")
        sys.exit(0)

    # Load initial master state
    st = {}
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                st = json.load(f)
        except Exception:
            pass
    if not st:
        st = {
            "system": {},
            "interface": {},
            "theme": {"palette": {}, "borders": {}, "glass": {}, "animations": {}},
            "wallpaper": {},
            "grid_widgets": {},
            "hotkeys": {}
        }

    try:
        step_locale_and_keyboard(st)
        step_network_and_bluetooth(st)
        step_interface_philosophy(st)
        step_visual_style(st)
        step_hardware_and_persistence(st)
    except KeyboardInterrupt:
        print("\n[!] Setup cancelled by user.")
        sys.exit(0)

if __name__ == "__main__":
    main()
