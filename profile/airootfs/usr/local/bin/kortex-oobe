#!/usr/bin/env python3
"""
KORTEX-OOBE: Fullscreen Interactive Initial Setup Wizard & Hardware Profiler
Runs on first boot when ~/.config/kortex/.setup_done does not exist.
Supports both Mouse Clicks and Keyboard navigation (Arrows / Enter / 1-9).
Covers:
1. Localization (EN / RU / RO / DE), Keyboard Layout (us,ru / us,ro / de) & Hotkey (Alt+Shift / Super+Space)
2. Network (nmcli Wi-Fi / nmtui) & PipeWire Audio Verification
3. Desktop Mode (Cyber-Deck 5-Panel Grid / MacBook Pro Mode [Glass & Dock] / Pro Developer Pure Tiling)
4. Quick Theme, Border Engine, Audio FX & Hardware Power Profile (Eco / Balanced / Overdrive)
5. Install to Disk with Persistence (master-state.json) or Continue in Live Mode (.setup_done)
"""

import sys
import os
import json
import time
import curses
import subprocess
import shutil

SETUP_FLAG = os.path.expanduser("~/.config/kortex/.setup_done")
MASTER_STATE = os.path.expanduser("~/.config/kortex/master-state.json")
LEGACY_STATE = os.path.expanduser("~/.config/kortex/config.json")

def get_hypr_env():
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        hdir = f"{env['XDG_RUNTIME_DIR']}/hypr"
        if os.path.exists(hdir):
            sigs = os.listdir(hdir)
            if sigs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]
    return env

def interactive_select(step_num, step_title, subtitle, options):
    """
    Fullscreen Curses interactive menu supporting Mouse Clicks, Arrow Keys, Enter, and Number Keys 1-9.
    Falls back to standard CLI input if curses fails.
    """
    def _curses_menu(stdscr):
        curses.curs_set(0)
        stdscr.nodelay(False)
        stdscr.keypad(True)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except Exception:
            pass

        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_WHITE, -1)
        curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
        curses.init_pair(3, curses.COLOR_CYAN, -1)
        curses.init_pair(4, curses.COLOR_GREEN, -1)
        curses.init_pair(5, curses.COLOR_YELLOW, -1)

        sel = 0
        row_map = {}

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()

            # Header Box
            top_bar = "╔" + "═" * max(10, min(78, w - 4)) + "╗"
            mid_bar = "╠" + "═" * max(10, min(78, w - 4)) + "╣"
            bot_bar = "╚" + "═" * max(10, min(78, w - 4)) + "╝"

            def add_line(y, x, text, attr=curses.A_NORMAL):
                if 0 <= y < h and 0 <= x < w:
                    try:
                        stdscr.addstr(y, x, text[:max(1, w - x - 1)], attr)
                    except curses.error:
                        pass

            add_line(1, 2, top_bar, curses.color_pair(3) | curses.A_BOLD)
            add_line(2, 4, "KORTEX-OS UNIFIED DESIGN & INITIAL SETUP WIZARD (OOBE)", curses.color_pair(1) | curses.A_BOLD)
            add_line(3, 4, "MacBook UX on Arch Linux + Cyber-Deck Architecture (Mouse & Keyboard Ready)", curses.color_pair(3))
            add_line(4, 2, mid_bar, curses.color_pair(3) | curses.A_BOLD)
            add_line(5, 4, f"STEP {step_num}/5 :: {step_title}", curses.color_pair(5) | curses.A_BOLD)
            add_line(6, 2, bot_bar, curses.color_pair(3) | curses.A_BOLD)

            add_line(8, 4, subtitle, curses.color_pair(4) | curses.A_BOLD)

            row_map.clear()
            y_cur = 10
            for idx, (label, desc) in enumerate(options):
                is_sel = (idx == sel)
                prefix = " ▶ " if is_sel else "   "
                attr = curses.color_pair(2) | curses.A_BOLD if is_sel else curses.color_pair(1) | curses.A_BOLD
                line_str = f"{prefix}[{idx + 1}] {label:<52}"
                add_line(y_cur, 4, line_str, attr)
                row_map[y_cur] = idx
                if desc:
                    add_line(y_cur + 1, 11, desc, curses.color_pair(3) if is_sel else curses.color_pair(1))
                    row_map[y_cur + 1] = idx
                    y_cur += 3
                else:
                    y_cur += 2

            add_line(h - 2, 4, "Controls: [↑/↓] Navigate  |  [ENTER / Mouse Click] Confirm  |  [1-9] Quick Pick", curses.color_pair(5))
            stdscr.refresh()

            ch = stdscr.getch()
            if ch == curses.KEY_UP:
                sel = (sel - 1) % len(options)
            elif ch == curses.KEY_DOWN:
                sel = (sel + 1) % len(options)
            elif ch in (10, 13, curses.KEY_ENTER, ord(' ')):
                return sel
            elif ord('1') <= ch <= ord('9'):
                pick = ch - ord('1')
                if pick < len(options):
                    return pick
            elif ch == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                    if my in row_map:
                         clicked_idx = row_map[my]
                         if bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED | curses.BUTTON1_DOUBLE_CLICKED):
                             return clicked_idx
                         sel = clicked_idx
                except Exception:
                    pass

    try:
        if sys.stdin.isatty() and sys.stdout.isatty():
            return curses.wrapper(_curses_menu)
    except Exception:
        pass

    # Fallback CLI menu
    print(f"\n=== STEP {step_num}/5 : {step_title} ===")
    print(f"{subtitle}\n")
    for idx, (label, desc) in enumerate(options, 1):
        print(f"  [{idx}] {label}")
        if desc:
            print(f"      {desc}")
    while True:
        try:
            c = input(f"\nSelect [1-{len(options)}] (Default 1): ").strip()
            if not c:
                return 0
            v = int(c) - 1
            if 0 <= v < len(options):
                return v
        except (ValueError, EOFError, KeyboardInterrupt):
            return 0

def step_1_localization(st):
    lang_opts = [
        ("English (EN)", "Default global system & developer interface language"),
        ("Русский (RU)", "Полная локализация интерфейса, меню и системных утилит"),
        ("Română (RO)", "Limba română pentru interfață și utilitare de sistem"),
        ("Deutsch (DE)", "Deutsche Systemsprache und Entwickler-Oberfläche")
    ]
    c_lang = interactive_select(1, "LOCALIZATION & KEYBOARD", "1/3: Select System Interface Language (EN / RU / RO / DE):", lang_opts)
    langs = ["en", "ru", "ro", "de"]
    st["system"]["language"] = langs[c_lang]

    kb_opts = [
        ("US + Russian (us,ru)", "Bilingual English & Russian layout"),
        ("US + Romanian (us,ro)", "Bilingual English & Romanian standard layout"),
        ("German (de)", "German QWERTZ keyboard layout (us,de)"),
        ("US English Only (us)", "Single clean US QWERTY developer layout")
    ]
    c_kb = interactive_select(1, "LOCALIZATION & KEYBOARD", "2/3: Select Keyboard Layout (us,ru / us,ro / de):", kb_opts)
    kb_layouts = ["us,ru", "us,ro", "de", "us"]
    st["system"]["kb_layout"] = kb_layouts[c_kb]

    hk_opts = [
        ("Alt + Shift (grp:alt_shift_toggle)", "Classic desktop keyboard language switch shortcut"),
        ("Super + Space / Win + Space (grp:win_space_toggle)", "MacBook / modern OS language switch shortcut")
    ]
    c_hk = interactive_select(1, "LOCALIZATION & KEYBOARD", "3/3: Select Keyboard Layout Switch Hotkey:", hk_opts)
    hk_vals = ["grp:alt_shift_toggle", "grp:win_space_toggle"]
    st["system"]["kb_toggle"] = hk_vals[c_hk]

    env = get_hypr_env()
    try:
        subprocess.run(
            ["hyprctl", "eval", f'hl.config({{ input = {{ kb_layout = "{kb_layouts[c_kb]}", kb_options = "{hk_vals[c_hk]}" }} }})'],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
        )
    except Exception:
        pass

def test_pipewire_audio():
    print("\033[2J\033[H\033[1;36m[*] PipeWire Low-Latency Audio Subsystem Check...\033[0m\n")
    try:
        subprocess.run(["wpctl", "status"], timeout=3)
    except Exception:
        pass
    print("\n\033[1;32m[*] Playing stereo verification chime...\033[0m")
    try:
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"], stderr=subprocess.DEVNULL, timeout=2)
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "0.75"], stderr=subprocess.DEVNULL, timeout=2)
        subprocess.run("speaker-test -t sine -f 660 -l 1 >/dev/null 2>&1 || true", shell=True, timeout=4)
    except Exception:
        pass
    time.sleep(1)

def step_2_network_and_audio(st):
    while True:
        net_opts = [
            ("Scan & Connect Wi-Fi (nmcli)", "Scan wireless SSIDs and connect with passphrase"),
            ("Open Full Network Manager TUI (nmtui)", "Interactive Wi-Fi & Ethernet configuration utility"),
            ("Test Audio Output (PipeWire / WirePlumber)", "Verify PipeWire sound server & play test tone"),
            ("Continue to Desktop Mode ->", "Proceed to Step 3 (Desktop Mode Selection)")
        ]
        c_net = interactive_select(2, "NETWORK & PIPEWIRE AUDIO", "Configure Wireless Network (nmcli) & Verify Audio Output (PipeWire):", net_opts)
        if c_net == 0:
            print("\033[2J\033[H\033[1;36m[*] Scanning for nearby Wi-Fi networks via nmcli...\033[0m\n")
            try:
                res = subprocess.run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"], capture_output=True, text=True, timeout=6)
                lines = [l.strip() for l in res.stdout.splitlines() if l.strip()]
                if lines:
                    wifi_opts = []
                    ssids = []
                    for l in lines[:8]:
                        parts = l.split(":")
                        ssid = parts[0] or "<Hidden>"
                        sig = parts[1] if len(parts) > 1 else ""
                        sec = parts[2] if len(parts) > 2 else "Open"
                        wifi_opts.append((f"{ssid} ({sig}%)", f"Security: {sec}"))
                        ssids.append(parts[0])
                    wifi_opts.append(("Back", "Return to Network & Audio menu"))
                    pick = interactive_select(2, "WI-FI NETWORKS (nmcli)", "Select Wi-Fi SSID to connect:", wifi_opts)
                    if pick < len(ssids) and ssids[pick]:
                        target_ssid = ssids[pick]
                        print(f"\033[2J\033[HConnecting to SSID: {target_ssid}")
                        pwd = input(f"Enter Wi-Fi password for '{target_ssid}' (leave blank if open): ").strip()
                        if pwd:
                            subprocess.run(["nmcli", "device", "wifi", "connect", target_ssid, "password", pwd])
                        else:
                            subprocess.run(["nmcli", "device", "wifi", "connect", target_ssid])
                        time.sleep(1.5)
                else:
                    print("No Wi-Fi SSIDs detected or wireless interface unavailable.")
                    time.sleep(1.5)
            except Exception as e:
                print(f"Wi-Fi scan notice: {e}")
                time.sleep(1.5)
        elif c_net == 1:
            subprocess.run(["nmtui"])
        elif c_net == 2:
            test_pipewire_audio()
        else:
            break

def step_3_desktop_mode(st):
    phil_opts = [
        ("MacBook Pro + Windows Mode (Glass & Dock)", "Простой и понятный: плавающие окна со стеклом (blur), верхний бар, нижний Док и кнопки [ _ ] [ □ ] [ ✕ ]"),
        ("Cyber-Deck (5-Panel eDEX Grid)", "Хакерская станция: 5 живых панелей (Телеметрия, Терминал, 3D-Глобус, Проводник, Клавиатура)"),
        ("Pro Developer (Pure Tiling)", "Чистый тайлинг окон на весь экран для кодинга без лишних панелей")
    ]
    c_phil = interactive_select(3, "DESKTOP MODE ARCHITECTURE", "Choose Primary Desktop UX Mode (Switch anytime via Super + Tab):", phil_opts)
    phils = ["macbook", "cyberdeck", "tiling"]
    st["interface"]["philosophy"] = phils[c_phil]
    st["interface"]["dock_enabled"] = (phils[c_phil] == "macbook")

def step_4_theme_and_hardware(st):
    theme_opts = [
        ("Cyber Cyan (#00f0ff)", "Electric Tron neon blue glow & dark slate glass"),
        ("Tokyo Night (#7aa2f7)", "Deep twilight indigo with lavender neon accents"),
        ("Dracula Dark (#bd93f9)", "High-contrast gothic violet & neon pink"),
        ("Matrix Phosphor (#00ff41)", "Classic hacker green phosphor monochrome"),
        ("Amber CRT (#ffb000)", "Warm retro 80s phosphor amber terminal"),
        ("Mono Tron (#ffffff)", "Pure high-contrast stealth monochrome"),
        ("Crimson Alert (#ff003c)", "Tactical red alert cyber combat HUD")
    ]
    c_th = interactive_select(4, "QUICK THEME & HARDWARE PROFILE", "1/4: Select Base Color Palette:", theme_opts)
    themes = ["cyan", "tokyonight", "dracula", "matrix", "amber", "mono", "crimson"]
    chosen_theme = themes[c_th]
    st["theme"]["name"] = chosen_theme

    border_opts = [
        ("Dual Gradient (45° Cyber Edge)", "Two-tone gradient border around active windows"),
        ("Animated Neon Loop", "Continuous rotating neon gradient around active window perimeter"),
        ("Drop Shadow / Glow", "Diffused neon glow aura around active windows"),
        ("Solid Border", "Clean single-color crisp window border")
    ]
    c_bd = interactive_select(4, "QUICK THEME & HARDWARE PROFILE", "2/4: Select Active Window Border Engine Style:", border_opts)
    b_modes = ["dual_gradient", "neon_loop", "glow_shadow", "solid"]
    st["theme"]["borders"]["mode"] = b_modes[c_bd]

    sfx_opts = [
        ("Enable UI Audio FX (Sci-Fi Tactile Feedback)", "Subtle mechanical/cyber audio cues on key/UI actions"),
        ("Silent Mode (Mute UI Audio FX)", "Disable interface sound effects")
    ]
    c_sfx = interactive_select(4, "QUICK THEME & HARDWARE PROFILE", "3/4: Interface Audio FX:", sfx_opts)
    st["interface"]["ui_sounds"] = (c_sfx == 0)
    if c_sfx == 1:
        subprocess.run("pkill -f kortex-audio-fx 2>/dev/null || true", shell=True)

    pwr_opts = [
        ("Balanced (Default Recommended)", "Adaptive schedutil governor, smooth 60fps animations & optimal thermals"),
        ("Overdrive (Max Performance)", "Performance governor, zero-latency response for heavy workloads"),
        ("Eco Mode (Battery Saver)", "Powersave governor & reduced background effects for maximum battery life")
    ]
    c_pwr = interactive_select(4, "QUICK THEME & HARDWARE PROFILE", "4/4: Select Hardware Power Profile (Eco / Balanced / Overdrive):", pwr_opts)
    pwrs = ["balanced", "performance", "powersave"]
    st["system"]["power_profile"] = pwrs[c_pwr]
    try:
        subprocess.run(["cpupower", "frequency-set", "-g", pwrs[c_pwr]], stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

def step_5_install_or_live(st):
    # Save state and apply theme before final choice
    os.makedirs(os.path.dirname(MASTER_STATE), exist_ok=True)
    with open(MASTER_STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    with open(LEGACY_STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)

    chosen_theme = st.get("theme", {}).get("name", "cyan")
    subprocess.run(["/usr/local/bin/kortex-theme-apply", "--theme", chosen_theme], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    inst_opts = [
        ("Continue in Live Mode (Save & Launch Desktop)", "Create ~/.config/kortex/.setup_done and enter your configured desktop"),
        ("Install KortexOS to Disk (With Persistent Settings)", "Launch Disk Installer and automatically copy master-state.json into target OS")
    ]
    c_inst = interactive_select(5, "INSTALL / LIVE PERSISTENCE", "All settings saved to master-state.json! Choose how to proceed:", inst_opts)

    # Create .setup_done flag
    with open(SETUP_FLAG, "w", encoding="utf-8") as f:
        f.write(f"Setup completed at: {time.ctime()}\n")

    # Copy to persistence staging directory for installer
    try:
        os.makedirs("/run/kortex-persistence", exist_ok=True)
        shutil.copy2(MASTER_STATE, "/run/kortex-persistence/master-state.json")
    except Exception:
        pass

    if c_inst == 1 and os.path.exists("/usr/local/bin/kortex-install"):
        print("\033[2J\033[H\033[1;36m[*] Launching KortexOS Disk Installer with master-state.json persistence...\033[0m\n")
        subprocess.run(["/usr/local/bin/kortex-install"])

def main():
    if "--force" not in sys.argv and os.path.exists(SETUP_FLAG):
        print("[*] KortexOS OOBE already completed. Use 'kortex-oobe --force' to rerun.")
        sys.exit(0)

    st = {}
    if os.path.exists(MASTER_STATE):
        try:
            with open(MASTER_STATE, "r", encoding="utf-8") as f:
                st = json.load(f)
        except Exception:
            pass

    for sec, default_val in [
        ("system", {"language": "en", "timezone": "Europe/Chisinau", "kb_layout": "us,ru", "kb_toggle": "grp:alt_shift_toggle", "power_profile": "balanced"}),
        ("interface", {"philosophy": "cyberdeck", "dock_enabled": True, "gestures": True, "ui_sounds": True}),
        ("theme", {"name": "cyan", "palette": {}, "borders": {"size": 2, "rounding": 6, "gaps_in": 6, "gaps_out": 10, "mode": "dual_gradient", "gradient_angle": 45, "glow_radius": 15}, "glass": {"opacity_active": 0.95, "opacity_inactive": 0.85, "opacity_panels": 0.90, "blur_enabled": True, "blur_size": 8, "blur_passes": 3, "blur_vibrancy": 0.1696, "xray": False}, "animations": {"mode": "smooth"}}),
        ("wallpaper", {}),
        ("grid_widgets", {}),
        ("hotkeys", {})
    ]:
        if sec not in st or not isinstance(st[sec], dict):
            st[sec] = default_val

    try:
        step_1_localization(st)
        step_2_network_and_audio(st)
        step_3_desktop_mode(st)
        step_4_theme_and_hardware(st)
        step_5_install_or_live(st)
    except KeyboardInterrupt:
        with open(SETUP_FLAG, "w", encoding="utf-8") as f:
            f.write(f"Setup skipped at: {time.ctime()}\n")
        sys.exit(0)

if __name__ == "__main__":
    main()
