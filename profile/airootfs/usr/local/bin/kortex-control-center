#!/usr/bin/env python3
"""
KORTEX-CONTROL-CENTER: Dropdown Control Center for Volume, Brightness, Wi-Fi & Bluetooth
"""

import os
import sys
import subprocess

DND_FLAG = os.path.expanduser("~/.config/kortex/.dnd")

def get_volume():
    try:
        res = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True, timeout=2)
        out = res.stdout.strip()
        if "MUTED" in out:
            return "ВЫКЛ"
        parts = out.split(":")
        if len(parts) > 1:
            v = float(parts[1].strip().split()[0])
            return f"{int(v * 100)}%"
    except Exception:
        pass
    return "75%"

def get_brightness():
    try:
        res = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True, timeout=2)
        parts = res.stdout.strip().split(",")
        if len(parts) >= 4:
            return parts[3]
    except Exception:
        pass
    return "100%"

def get_wifi_state():
    try:
        res = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True, timeout=2)
        st = res.stdout.strip().upper()
        return "ВКЛ" if st == "ENABLED" else ("ВЫКЛ" if st == "DISABLED" else "ВКЛ")
    except Exception:
        return "ВКЛ"

def get_bt_state():
    try:
        res = subprocess.run(["bluetoothctl", "show"], capture_output=True, text=True, timeout=2)
        return "ВКЛ" if "Powered: yes" in res.stdout else "ВЫКЛ"
    except Exception:
        return "ВЫКЛ"

def main():
    if subprocess.run(["pgrep", "-x", "rofi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["pkill", "-x", "rofi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sys.exit(0)

    vol = get_volume()
    bri = get_brightness()
    wifi = get_wifi_state()
    bt = get_bt_state()
    dnd = "ВКЛ" if os.path.exists(DND_FLAG) else "ВЫКЛ"

    items = [
        (f"🔊 Громкость ({vol}) : Прибавить +10%", "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 10%+"),
        (f"🔉 Громкость ({vol}) : Убавить -10%", "wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-"),
        (f"🔇 Громкость ({vol}) : Вкл / Выкл звук", "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),
        (f"☀️ Яркость ({bri}) : Ярче +15%", "brightnessctl set +15%"),
        (f"🌙 Яркость ({bri}) : Темнее -15%", "brightnessctl set 15%-"),
        (f"📶 Wi-Fi [{wifi}] : Вкл / Выкл беспроводную сеть", f"nmcli radio wifi {'off' if wifi == 'ВКЛ' else 'on'}"),
        ("🌐 Сети Wi-Fi : Выбрать сеть и подключиться (nmtui)", "kitty --class nm-connection-editor -e nmtui"),
        (f"🦷 Bluetooth [{bt}] : Вкл / Выкл", f"bluetoothctl power {'off' if bt == 'ВКЛ' else 'on'}"),
        (f"🔕 Не беспокоить [{dnd}]", "TOGGLE_DND"),
        ("⚙️ Настройки системы", "/usr/local/bin/kortex-open settings"),
        ("🔒 Заблокировать экран", "/usr/local/bin/kortex-open lock")
    ]

    prompt_text = "\n".join(label for label, _ in items)
    rofi_theme = """
    * { font: "JetBrainsMono Nerd Font 11"; }
    window {
        width: 500px;
        location: northeast;
        anchor: northeast;
        x-offset: -14px;
        y-offset: 36px;
        border-radius: 14px;
        border: 2px;
        border-color: #00f0ff;
        background-color: rgba(10, 12, 16, 0.94);
        padding: 12px;
    }
    mainbox { background-color: transparent; spacing: 8px; }
    inputbar {
        background-color: rgba(18, 22, 31, 0.90);
        border-radius: 8px;
        padding: 8px 12px;
        children: [ prompt, entry ];
    }
    prompt { text-color: #00f0ff; font-weight: bold; margin: 0 8px 0 0; }
    entry { text-color: #ffffff; placeholder: "Звук, яркость, Wi-Fi..."; placeholder-color: #6e7681; }
    listview { lines: 11; background-color: transparent; spacing: 4px; }
    element { border-radius: 8px; padding: 7px 10px; background-color: transparent; text-color: #e6edf3; }
    element selected { background-color: rgba(0, 240, 255, 0.22); text-color: #00f0ff; border: 1px; border-color: #00f0ff; }
    """

    res = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "🎛 Звук и Сеть", "-theme-str", rofi_theme],
        input=prompt_text,
        capture_output=True,
        text=True
    )
    choice = res.stdout.strip()
    if not choice:
        sys.exit(0)

    for label, cmd in items:
        if choice == label:
            if cmd == "TOGGLE_DND":
                os.makedirs(os.path.dirname(DND_FLAG), exist_ok=True)
                if os.path.exists(DND_FLAG):
                    os.remove(DND_FLAG)
                else:
                    with open(DND_FLAG, "w") as f:
                        f.write("1\n")
            else:
                subprocess.Popen(cmd, shell=True)
            break

if __name__ == "__main__":
    main()
