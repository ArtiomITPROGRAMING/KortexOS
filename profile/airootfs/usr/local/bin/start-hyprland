#!/usr/bin/env bash
# ==============================================================================
# KORTEX-OS HYPRLAND SESSION LAUNCHER
# Hardware detection & clean native start-hyprland invocation
# ==============================================================================

set -e

mkdir -p "$HOME/.config/hypr" 2>/dev/null || true

# Guarantee skel synchronization if no hyprland.lua exists
if [ -d /etc/skel/.config ] && [ ! -f "$HOME/.config/hypr/hyprland.lua" ]; then
    cp -rf /etc/skel/.config/* "$HOME/.config/" 2>/dev/null || true
fi

# Clean crash locks, sockets and caches
rm -rf "$HOME/.cache/hyprland"* /run/user/$(id -u)/hypr/* 2>/dev/null || true

# Auto-detect VM/Hypervisor environment and guarantee software renderer fallback
if systemd-detect-virt --quiet 2>/dev/null; then
    export AQ_NO_MODIFIERS=1
    export LIBGL_ALWAYS_SOFTWARE=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    export WLR_NO_HARDWARE_CURSORS=1
fi

# Invoke official upstream start-hyprland wrapper
exec /usr/bin/start-hyprland "$@"
