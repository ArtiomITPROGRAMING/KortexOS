{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": [
        "custom/menu",
        "custom/layout",
        "custom/win-min",
        "custom/win-max",
        "custom/win-close",
        "custom/guide",
        "custom/store",
        "custom/ai",
        "custom/settings",
        "custom/guard",
        "wlr/taskbar"
    ],
    "modules-center": [
        "custom/spotlight",
        "custom/plugins",
        "custom/logo"
    ],
    "modules-right": [
        "custom/control-center",
        "network",
        "cpu",
        "memory",
        "disk",
        "battery",
        "clock"
    ],

    "custom/menu": {
        "format": "[ ⊞ ПУСК ]",
        "on-click": "/usr/local/bin/kortex-menu",
        "tooltip": "Главное меню Пуск // Приложения и Система (Super+D)"
    },
    "custom/layout": {
        "exec": "/usr/local/bin/kortex-layout waybar",
        "return-type": "json",
        "interval": 2,
        "on-click": "/usr/local/bin/kortex-layout next",
        "tooltip": "Переключить режим стола: Mac+Windows Док / Cyber-Deck / Тайлинг (Super+Tab)"
    },
    "custom/win-min": {
        "format": "[ _ ]",
        "on-click": "hyprctl dispatch togglefloating",
        "tooltip": "Плавающее / Тайлинговое окно (Super+V)"
    },
    "custom/win-max": {
        "format": "[ □ ]",
        "on-click": "hyprctl dispatch fullscreen 1",
        "tooltip": "Развернуть на весь экран (Super+F)"
    },
    "custom/win-close": {
        "format": "[ ✕ ]",
        "on-click": "hyprctl dispatch killactive",
        "tooltip": "Закрыть активное окно (Super+Q / Alt+F4)"
    },
    "custom/spotlight": {
        "format": "[ ⌕ SPOTLIGHT ]",
        "on-click": "/usr/local/bin/kortex-spotlight",
        "tooltip": "Поиск программ, файлов и калькулятор Spotlight (Super+Space)"
    },
    "custom/control-center": {
        "format": "[ 🎛 CTRL ]",
        "on-click": "/usr/local/bin/kortex-control-center",
        "tooltip": "Центр управления: Громкость, Яркость, Wi-Fi, Bluetooth, DND (Super+C)"
    },
    "custom/guide": {
        "format": "[ ? GUIDE ]",
        "on-click": "kitty --class kortex-tour --title 'KORTEX OS :: SYSTEM GUIDE' -e /usr/local/bin/kortex-tour",
        "tooltip": "System Interactive Guide & Welcome Tour (Super+F1)"
    },
    "custom/store": {
        "format": "[STORE]",
        "on-click": "/usr/local/bin/kortex-open store",
        "tooltip": "Kortex App Hub & Software Center (Super+P)"
    },
    "custom/ai": {
        "format": "[AI]",
        "on-click": "/usr/local/bin/kortex-open ai",
        "tooltip": "Kortex AI Assistant (Super+A)"
    },
    "custom/settings": {
        "format": "[SET]",
        "on-click": "/usr/local/bin/kortex-open settings",
        "tooltip": "Kortex Theme Studio Pro & Settings (Super+S)"
    },
    "custom/guard": {
        "format": "[NET]",
        "on-click": "/usr/local/bin/kortex-open net-guard",
        "tooltip": "Network Sentinel & Panic Lockdown (Super+N)"
    },
    "wlr/taskbar": {
        "format": "{icon} {name}",
        "icon-size": 14,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "kortex-pulse",
            "kortex-term",
            "kortex-net",
            "kortex-files",
            "kortex-kb"
        ]
    },
    "custom/plugins": {
        "exec": "/usr/local/bin/kortex-plugin-status",
        "return-type": "json",
        "interval": 3,
        "on-click": "/usr/local/bin/kortex-menu",
        "tooltip": "User Plugins in ~/.config/kortex/plugins/"
    },
    "custom/logo": {
        "format": "[KORTEX-OS]"
    },
    "network": {
        "format-wifi": "Net: {signalStrength}%",
        "format-ethernet": "Net: {ipaddr}",
        "format-disconnected": "Net: Offline",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "/usr/local/bin/kortex-control-center"
    },
    "cpu": {
        "interval": 2,
        "format": "CPU: {usage}%"
    },
    "memory": {
        "interval": 2,
        "format": "RAM: {percentage}%"
    },
    "disk": {
        "interval": 30,
        "format": "Disk: {percentage_used}%"
    },
    "battery": {
        "format": "Bat: {capacity}%",
        "format-charging": "Bat: {capacity}% [AC]"
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "on-click": "/usr/local/bin/kortex-control-center"
    }
}
