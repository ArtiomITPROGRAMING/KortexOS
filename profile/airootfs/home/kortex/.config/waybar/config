{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": [
        "custom/menu",
        "custom/win-max",
        "custom/win-close",
        "wlr/taskbar"
    ],
    "modules-center": [
        "custom/spotlight"
    ],
    "modules-right": [
        "network",
        "battery",
        "custom/control-center",
        "clock"
    ],

    "custom/menu": {
        "format": "[ ⊞ Пуск ]",
        "on-click": "/usr/local/bin/kortex-menu",
        "tooltip": "Главное меню Пуск (Super+D)"
    },
    "custom/win-max": {
        "format": "[ □ ]",
        "on-click": "hyprctl dispatch fullscreen 1",
        "tooltip": "Развернуть на весь экран (Super+F)"
    },
    "custom/win-close": {
        "format": "[ ✕ ]",
        "on-click": "hyprctl dispatch killactive",
        "tooltip": "Закрыть активное окно (Super+Q / Alt+F4)"
    },
    "wlr/taskbar": {
        "format": "{icon} {name}",
        "icon-size": 14,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },
    "custom/spotlight": {
        "format": "[ ⌕ Поиск ]",
        "on-click": "/usr/local/bin/kortex-spotlight",
        "tooltip": "Поиск программ, файлов и калькулятор (Super+Space)"
    },
    "network": {
        "format-wifi": "Wi-Fi: {signalStrength}%",
        "format-ethernet": "Сеть: {ipaddr}",
        "format-disconnected": "Wi-Fi: Выкл",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "/usr/local/bin/kortex-control-center"
    },
    "battery": {
        "format": "Батарея: {capacity}%",
        "format-charging": "Зарядка: {capacity}%"
    },
    "custom/control-center": {
        "format": "[ 🎛 Звук и Сеть ]",
        "on-click": "/usr/local/bin/kortex-control-center",
        "tooltip": "Звук, яркость, Wi-Fi и Bluetooth (Super+C)"
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "tooltip-format": "{:%d.%m.%Y %H:%M:%S}",
        "on-click": "/usr/local/bin/kortex-control-center"
    }
}
