{
    "layer": "top",
    "position": "bottom",
    "height": 42,
    "margin-bottom": 8,
    "modules-center": [
        "custom/dock-launchpad",
        "custom/dock-term",
        "custom/dock-browser",
        "custom/dock-files",
        "custom/dock-gram",
        "custom/dock-ai",
        "custom/dock-music",
        "custom/dock-store",
        "custom/dock-settings",
        "custom/dock-ctrl",
        "custom/dock-install"
    ],
    "custom/dock-launchpad": {
        "format": "⌕ Spotlight",
        "on-click": "/usr/local/bin/kortex-spotlight",
        "tooltip": "Kortex Spotlight Search & Calculator (Super+Space)"
    },
    "custom/dock-term": {
        "format": "🐚 Terminal",
        "on-click": "/usr/local/bin/kortex-launch kitty",
        "tooltip": "Launch Kitty Terminal (Super+Enter)"
    },
    "custom/dock-browser": {
        "format": "🌐 Browser",
        "on-click": "/usr/local/bin/kortex-launch firefox",
        "tooltip": "Launch Web Browser (Super+B)"
    },
    "custom/dock-files": {
        "format": "📁 Files",
        "on-click": "kitty --class kortex-files -e yazi",
        "tooltip": "Launch File Manager (Super+E)"
    },
    "custom/dock-gram": {
        "format": "💬 Gram",
        "on-click": "/usr/local/bin/kortex-gram",
        "tooltip": "KortexGram E2EE Messenger"
    },
    "custom/dock-ai": {
        "format": "🤖 AI",
        "on-click": "/usr/local/bin/kortex-open ai",
        "tooltip": "Kortex AI Assistant (Super+A)"
    },
    "custom/dock-music": {
        "format": "🎵 Music",
        "on-click": "/usr/local/bin/kortex-open music",
        "tooltip": "Kortex Synthwave & Audio Player"
    },
    "custom/dock-store": {
        "format": "🏪 Store",
        "on-click": "/usr/local/bin/kortex-open store",
        "tooltip": "Kortex Software Center (Super+P)"
    },
    "custom/dock-settings": {
        "format": "🎨 Studio",
        "on-click": "/usr/local/bin/kortex-open settings",
        "tooltip": "Kortex Theme Studio Pro & Settings (Super+S)"
    },
    "custom/dock-ctrl": {
        "format": "🎛 Control",
        "on-click": "/usr/local/bin/kortex-control-center",
        "tooltip": "MacBook Control Center (Volume, Brightness, Wi-Fi, BT, DND)"
    },
    "custom/dock-install": {
        "format": "💿 Install",
        "on-click": "/usr/local/bin/kortex-open install",
        "tooltip": "Install KortexOS to Disk with Persistence"
    }
}
